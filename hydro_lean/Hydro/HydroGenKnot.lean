import Hydro.HydroGen
import Hydro.HydroGenLag
import Hydro.ValuesMono

/-!
# Hydro · `HydroGen` knot generation (the knot and glue phases)

The knot stack for a `HydroSem.fix`/`fixTick` wrapper, generalized to
the real program shapes (D44 handoff): **leg-selected** bodies (a
projection of the hoisted chain body), **composed** bodies with *inner
knots* in argument positions (`leader_election`'s three nested knots),
**tick** knots (`fixTick` over `CoTickSing` gadgets), and
**body-constant** knots (the fix applied inline by the program, so the
theorems are stated at the `H.fix` application).
(Since D51 the knots and their body constants are auto-generated by
the inline `fix` elaborator as `M.wire` / `M.wire.body`; the
hand-written names above survive as the shape vocabulary.)

Generated artifacts per knot `K` (registered like a module's, so
knot-calling modules consume them through the same registry):

- `K_co_sr₁` — the machine naming `(K @ corner).sr = K @ SchedSem`,
  by the `co_knot_sr` house script (defeq never crosses the knot
  boundary; body legs + inner knots fold through their lemmas).
- `K_co_rr₁` — the denotational naming at the body module's
  choice-`vdec` applied at the knot's own machine wires (the loop
  position takes the *machine knot* — `K @ SchedSem`).
- `K_strict₁` — strictness of the machine knot in its Bekić parameters
  (the sibling knot wires of its `fix` block, at lag `1`; D95) and
  causality in its externals: `causalL_fix_stream`/`_tick` over the
  composed body's graded causality, which is the hoisted chain's graph
  lag analysis (`<chain>.dag_agreeL`, `Graph/Causal.lean`) at
  the knot wires, inner knots through their own `_strict₁`.
- `K_mono₁` — `Values` monotonicity of the denotational knot at a
  *generic* decision record (`iterate_mono_param` over the body's
  generated monotonicity, inner knots threaded recursively).
- `K_co_wf₁` — the corner `wf` triple (`hstrict ∧ hchain ∧ hcplj`), by
  the validated blueprint with composition-aware facts.

All statements are synthesized from the knot's signature + the parsed
body composition; all proofs are fixed scripts over installed facts
(`Expr`-built lemma applications, rewritten by `kabstract`/`congrArg`
chains — never a whole-program defeq).
-/

namespace Hydro

open Lean Elab Term Meta Command

namespace HydroGen

/-! ## Proof plumbing (moved from the phase-1 knot section) -/

/-- Diagnostic tactic combinator: run `tac` and print its heartbeat and
wall cost under `label` (env `HYDROGEN_HB_DIAG`; zero cost when off). -/
elab "hb_block " label:str tac:tactic : tactic => do
  let hb0 ← IO.getNumHeartbeats
  let t0 ← IO.monoMsNow
  Tactic.evalTactic tac
  if (← IO.getEnv "HYDROGEN_HB_DIAG").isSome then
    IO.eprintln s!"[hb]   block {label.getString}: {((← IO.getNumHeartbeats) - hb0) / 1000}k {(← IO.monoMsNow) - t0}ms"

/-- Diagnostic: print the types of the named hypotheses (env `HYDROGEN_HB_DIAG`). -/
elab "hb_show " ids:ident* : tactic => Tactic.withMainContext do
  if (← IO.getEnv "HYDROGEN_HB_DIAG").isSome then
    for i in ids do
      let d ← Elab.Term.elabTerm i none
      let ty ← instantiateMVars (← inferType d)
      IO.eprintln s!"[hb-show] {i.getId} : {(← ppExpr ty).pretty 120 |>.take 3000}"

/-- Prove an OPEN goal (ambient fvars visible to the script) by a
tactic string. -/
def proveByTacOpen (goal : Expr) (tac : String) : TermElabM Expr :=
  withDeclDiag s!"open-script {tac.take 60}" do
  let env ← getEnv
  let stx ← match Parser.runParserCategory env `tactic tac with
    | .ok s => pure s
    | .error e => throwError "HydroGen: tactic parse error: {e}\n{tac}"
  -- same linter/info-tree suppression as `proveByTac` (generated simp sets
  -- are over-approximate by design)
  Term.withoutErrToSorry <| withEnableInfoTree false <|
      withOptions (fun o => Lean.Elab.Tactic.linter.unusedSimpArgs.set o false) do
    let mvar ← mkFreshExprSyntheticOpaqueMVar goal
    let remaining ← Tactic.run mvar.mvarId! <| Tactic.withoutRecover do
      Tactic.evalTactic stx; Tactic.pruneSolvedGoals
    let remaining ← remaining.filterM fun g => do
      pure (!(← g.isAssigned) && !(← g.isDelayedAssigned))
    unless remaining.isEmpty do
      throwError "HydroGen: unsolved goals ({remaining.length}) \
        under\n{tac}\n{goalsToMessageData remaining}"
    Term.synthesizeSyntheticMVarsNoPostponing
    instantiateMVars mvar

/-- Apply `decl` supplying implicit binders named `pacing`/`Tc`/`Td`/
`hjT` from the given values (they cannot be unified from
machine-typed argument types), explicits from `explicits`; other
implicits by unification, instances synthesized at the end. -/
def applyNamed (decl : Name) (pacing Tc Td hjT : Expr)
    (explicits : Array Expr) (pre : Array Expr := #[]) (expected? : Option Expr := none) :
    TermElabM Expr := do
  let info ← getConstInfo decl
  let us ← info.levelParams.mapM fun _ => mkFreshLevelMVar
  let mut e := Expr.const decl us
  let mut ty := info.type.instantiateLevelParams info.levelParams us
  -- the leading context telescope, applied POSITIONALLY regardless of
  -- binder info: implicit context binders (e.g. phantom upstream
  -- vocabulary generics — `ckord`/`ckret` appear in no machine-typed
  -- argument) cannot be pinned by unification.
  for a in pre do
    ty ← whnfR (← instantiateMVars ty)
    unless ty.isForall do
      throwError "applyNamed {decl}: context telescope overflow"
    e := mkApp e a
    ty := ty.bindingBody!.instantiate1 a
  let mut queue := explicits.toList
  let mut instMVars : Array MVarId := #[]
  while true do
    ty ← whnfR (← instantiateMVars ty)
    unless ty.isForall do break
    let bi := ty.bindingInfo!
    let nm := ty.bindingName!
    let d := ty.bindingDomain!
    let mut arg := default
    if bi.isExplicit then
      match queue with
      | a :: rest =>
        queue := rest
        unless ← isDefEq (← inferType a) d do
          throwError "applyNamed {decl}: arg {a} : {← inferType a} type mismatch \
            against {d}"
        arg := a
      | [] => break
    else if nm == `pacing then arg := pacing
    else if nm == `Tc then arg := Tc
    else if nm == `Td then arg := Td
    else if nm == `hjT then arg := hjT
    else if bi.isInstImplicit then
      let m ← mkFreshExprMVar d
      instMVars := instMVars.push m.mvarId!
      arg := m
    else
      arg := ← mkFreshExprMVar d
    e := mkApp e arg
    ty := ty.bindingBody!.instantiate1 arg
  -- an expected result type pins implicits no explicit argument types
  -- (raw-typed legs) can: the gadget constructors' `ord`/`ret`
  if let some expTy := expected? then
    unless ← isDefEq (← inferType e) expTy do
      throwError "applyNamed {decl}: result type mismatch against {expTy}"
  for m in instMVars do
    unless ← m.isAssigned do
      let v ← synthInstance (← instantiateMVars (← m.getType))
      m.assign v
  let out ← instantiateMVars e
  if out.hasExprMVar then
    throwError "applyNamed {decl}: metavariables remain in {out}"
  pure out

/-- Normalize gadget projections in a fact's TYPE (the projection
lemmas are all `rfl`, so re-typing is a defeq hint). -/
def collapseFact (prf : Expr) : TermElabM Expr := do
  let names := #[``co_mkC_sr, ``co_mkC_rr, ``co_lowerC_sr,
    ``co_lowerC_rr, ``co_probeC_sr, ``co_probeC_rr,
    ``co_schedC_sr, ``co_probe2_sr, ``co_probe2_rr,
    ``co_schedEmbed_sr, ``co_tick_lowerC_sr, ``co_tick_lowerC_rr,
    ``co_sing_lowerC_sr, ``co_sing_lowerC_rr, ``co_sing_lowerC_src,
    ``co_kstream_lowerC_sr, ``co_kstream_lowerC_rr,
    ``co_tick_probe2_sr, ``co_tick_probe2_rr,
    ``co_tick_schedEmbed_sr, ``co_mkC_sr_raw, ``co_mkC_rr_raw,
    ``co_tick_mkC_sr_raw, ``co_tick_mkC_rr_raw,
    ``co_tick_schedC_sr, ``co_tick_probeC_sr, ``co_tick_probeC_rr]
  let mut st : SimpTheorems := {}
  for n in names do
    if (← getEnv).contains n then
      st ← st.addConst n
  let ctx ← Simp.mkContext (simpTheorems := #[st])
  let ty ← inferType prf
  let (res, _) ← simp ty ctx
  mkExpectedTypeHint prf res.expr

/-! ## The lag normal form (D95)

A lag expression, subtractions already at the leaves (the `co_lag_rules`
simp set), is a `max` tree of leaves `a - k` / `a` / numerals. Its normal
form is the right-nested, sorted `max` of one leaf per atom (the least
subtraction) and the largest numeral, if any — bounded by the number of
atoms, where the tree itself grows multiplicatively through nested knots.
The equation `E = C` is proved by `Nat.le_antisymm` from leaf-wise
`max_le` splits and `le_max` paths: a term of size `|E| · |C|`, no
rewriting search (AC `simp` on these trees was super-linear). -/
section LagCanon

/-- A leaf: `(atom, k)` for `atom - k` (`k = 0`: the bare atom), `(none, c)`
for a numeral. -/
def lagLeaf? (e : Expr) : Option (Option Expr × Nat) :=
  if let some c := e.nat? then some (none, c)
  else if e.isAppOfArity ``HSub.hSub 6 then
    match (e.getArg! 5).nat? with
    | some k => some (some (e.getArg! 4), k)
    | none => some (some e, 0)
  else some (some e, 0)

def isNatMax (e : Expr) : Bool := e.isAppOfArity ``Max.max 4

/-- The leaves of a `max` tree, with their paths (`true` = left). -/
partial def lagMaxLeaves (e : Expr) (path : List Bool := []) : List (Expr × List Bool) :=
  if isNatMax e then
    lagMaxLeaves (e.getArg! 2) (path ++ [true]) ++ lagMaxLeaves (e.getArg! 3) (path ++ [false])
  else [(e, path)]

/-- `leaf ≤ tree` along the leaf's path. -/
def lagLePath (leaf : Expr) : Expr → List Bool → MetaM Expr
  | t, [] => mkAppM ``Nat.le_refl #[t]
  | t, b :: rest => do
    let a := t.getArg! 2
    let c := t.getArg! 3
    if b then
      mkAppM ``Nat.le_trans #[← lagLePath leaf a rest, ← mkAppM ``Nat.le_max_left #[a, c]]
    else
      mkAppM ``Nat.le_trans #[← lagLePath leaf c rest, ← mkAppM ``Nat.le_max_right #[a, c]]

/-- `l₁ ≤ l₂` for leaves of one atom with `k₂ ≤ k₁`, or numerals `c₁ ≤ c₂`. -/
def lagLeafLe (l₁ l₂ : Expr) : MetaM Expr := do
  match lagLeaf? l₁, lagLeaf? l₂ with
  | some (none, _), some (none, _) => mkDecideProof (← mkAppM ``LE.le #[l₁, l₂])
  | some (some a, k₁), some (some _, k₂) =>
    if k₂ == 0 then
      if k₁ == 0 then mkAppM ``Nat.le_refl #[a]
      else mkAppM ``Nat.sub_le #[a, mkNatLit k₁]
    else
      let h ← mkDecideProof (← mkAppM ``LE.le #[mkNatLit k₂, mkNatLit k₁])
      mkAppM ``lag_leaf_le #[a, mkNatLit k₁, mkNatLit k₂, h]
  | _, _ => throwError "lagCanon: leaf shapes"

/-- `tree ≤ C` by `max_le` splits down to the leaves, each closed by its
canonical leaf (`find` gives the leaf of `C` and its path). -/
partial def lagTreeLe (t C : Expr) (find : Expr → MetaM (Option (Expr × List Bool))) :
    MetaM Expr := do
  if isNatMax t then
    let h1 ← lagTreeLe (t.getArg! 2) C find
    let h2 ← lagTreeLe (t.getArg! 3) C find
    mkAppM ``Iff.mpr #[← mkAppOptM ``Nat.max_le #[some (t.getArg! 2), some (t.getArg! 3), some C],
      ← mkAppM ``And.intro #[h1, h2]]
  else
    match ← find t with
    | some (lC, path) =>
      mkAppM ``Nat.le_trans #[← lagLeafLe t lC, ← lagLePath lC C path]
    | none =>
      -- a numeral `0` (or a numeral below no constant leaf): below anything
      if t.nat? == some 0 then mkAppM ``Nat.zero_le #[C]
      else throwError "lagCanon: leaf {t} has no canonical leaf in {C}"

/-- The normal form `C` of a leaf-pushed `max` tree `E`, with `E = C` (none
when `E` is already in normal form). -/
def lagCanon (E : Expr) : MetaM (Expr × Option Expr) := do
  let leaves := lagMaxLeaves E
  -- atoms → least k (by syntactic atom identity), numerals → the largest
  let mut atoms : Array (Expr × Nat) := #[]
  let mut const : Nat := 0
  for (l, _) in leaves do
    match lagLeaf? l with
    | some (none, c) => const := max const c
    | some (some a, k) =>
      match atoms.findIdx? (fun (a', _) => a' == a) with
      | some i => atoms := atoms.modify i fun (a', k') => (a', min k k')
      | none => atoms := atoms.push (a, k)
    | none => pure ()
  let sorted := atoms.qsort fun (a, _) (b, _) => Expr.lt a b
  let mkLeaf := fun (a : Expr) (k : Nat) => do
    if k == 0 then pure a else mkAppM ``HSub.hSub #[a, mkNatLit k]
  let mut cleaves : Array Expr := #[]
  for (a, k) in sorted do cleaves := cleaves.push (← mkLeaf a k)
  if const > 0 || cleaves.isEmpty then cleaves := cleaves.push (mkNatLit const)
  -- right-nested
  let mut C := cleaves.back!
  for i in [1:cleaves.size] do
    C ← mkAppM ``Max.max #[cleaves[cleaves.size - 1 - i]!, C]
  if C == E then return (E, none)
  let cLeaves := lagMaxLeaves C
  -- `E ≤ C`: a leaf's canonical leaf is the one of its atom; a numeral's the
  -- constant leaf
  let findC := fun (l : Expr) => do
    match lagLeaf? l with
    | some (none, _) => pure (cLeaves.find? fun (lc, _) => (lagLeaf? lc).any (·.1.isNone))
    | some (some a, _) => pure (cLeaves.find? fun (lc, _) => (lagLeaf? lc).any (fun (x, _) => x == some a))
    | none => pure none
  let hEC ← lagTreeLe E C findC
  -- `C ≤ E`: every canonical leaf occurs in `E` (the atom's least leaf, the
  -- largest numeral)
  let findE := fun (l : Expr) => do
    pure (leaves.find? fun (le, _) => le == l)
  let hCE ← lagTreeLe C E findE
  pure (C, some (← mkAppM ``Nat.le_antisymm #[hEC, hCE]))

end LagCanon

/-- Normalize a fact's TYPE by the lag projection set (the prebuilt
`co_lag_rules` attribute + the tick former's simproc) and the given lag
namings (D95), then the normal form: `… = C`, a sorted `max` of one leaf
per lag atom. -/
def collapseLagFact (prf : Expr) (extra : Array Name) : TermElabM Expr := do
  let some ext ← getSimpExtension? `co_lag_rules
    | throwError "collapseLagFact: the `co_lag_rules` simp attribute is missing"
  let base ← ext.getTheorems
  let mut st : SimpTheorems := {}
  for n in extra do
    if (← getEnv).contains n then
      st ← st.addConst n
  -- the default simprocs too: the normal form's numerals (`1 + 1`,
  -- `min 1 2` through `Nat.min_def`'s `if`) reduce by them
  let mut procs : Simp.Simprocs ← Simp.getSimprocs
  procs ← procs.add ``coTickScanProj (post := true)
  procs ← procs.add ``coLagLeaf (post := false)
  let ctx ← Simp.mkContext (simpTheorems := #[base, st])
  -- the RIGHT side only (the left is the lag atom the consumer names; the
  -- lag namings would rewrite it too, leaving a tautology)
  let ty ← whnfR (← inferType prf)
  let some (_, a, b) := ty.eq? |
    throwError "collapseLagFact: not an equation ({ty})"
  let (res, _) ← simp b ctx (simprocs := #[procs])
  let prf ← match res.proof? with
    | some h => mkEqTrans prf h
    | none => mkExpectedTypeHint prf (← mkEq a res.expr)
  let (_, canon?) ← lagCanon res.expr
  match canon? with
  | some h => mkEqTrans prf h
  | none => pure prf

/-- Rewrite occurrences of `eq`'s LHS *inside the RHS* of the equation
proof `base` (`base : a = b`, `eq : c = d` ⟹ `a = b[c := d]`), by
`kabstract`/`congrArg`/`Eq.trans`. No-op when the pattern is absent. -/
def rwRhs (base : Expr) (eq : Expr) : TermElabM Expr := do
  let bTy ← whnfR (← inferType base)
  let some (_, _lhs, rhs) := bTy.eq? |
    throwError "HydroGen: rwRhs base is not an equation ({bTy})"
  let eTy ← whnfR (← inferType eq)
  let some (_, c, _d) := eTy.eq? |
    throwError "HydroGen: rwRhs eq is not an equation"
  -- the occurrence is syntactic (the facts are built from the same
  -- terms): `kabstract` at REDUCIBLE transparency — at default, every
  -- same-headed subterm (`.rr` of some other module application) is an
  -- `isDefEq` that whnfs both modules through their knots (D81:
  -- `paxos_bench`'s outer knot `wf`, 419 M heartbeats in this one call)
  let rhsAbs ← withReducible <| kabstract rhs c
  unless rhsAbs.hasLooseBVars do
    return base
  let motive := Expr.lam `w (← inferType c) rhsAbs .default
  let step ← mkCongrArg motive eq
  mkEqTrans base step

def rwRhsAll (base : Expr) (eqs : Array Expr) : TermElabM Expr := do
  let mut b := base
  for e in eqs do
    b ← rwRhs b e
  pure b

/-! ## Residual callee rewriting (spec-directed)

`simp` cannot rewrite a callee redex sitting in a *dependent*
argument position (e.g. a chain body's subtype output mentions a
wire, so the congruence for that argument has no motive). The redex
is still rewritable at the equation level: `kabstract` over the
equation's RHS — whose type does not depend on the argument once the
`.val`/leg projections are outside. These helpers find lemma-LHS
matches by unification and push them through `rwRhs`. -/

/-- A pattern key: the LHS head shape of a rewrite lemma (projection
flag, head constant, arity). Candidate lookup is a single keyed scan
per round instead of one full-term scan per lemma. -/
structure LemKey where
  isProj : Bool
  head : Name
  arity : Nat
  deriving BEq, Hashable

def lemKeyOf (lem : Name) : TermElabM LemKey := do
  let lemC ← mkConstWithFreshMVarLevels lem
  forallTelescopeReducing (← inferType lemC) fun _ ty => do
    let some (_, lhs, _) := ty.eq?
      | throwError "HydroGen: {lem} is not an equation"
    match lhs with
    | .proj _ _ s =>
      let .const c _ := s.getAppFn
        | throwError "HydroGen: {lem}: opaque projection LHS"
      pure ⟨true, c, s.getAppNumArgs⟩
    | _ =>
      let .const c _ := lhs.getAppFn
        | throwError "HydroGen: {lem}: opaque LHS head"
      pure ⟨false, c, lhs.getAppNumArgs⟩

private def keyOfTerm (e : Expr) : Option LemKey :=
  match e with
  | .proj _ _ s =>
    match s.getAppFn with
    | .const c _ => some ⟨true, c, s.getAppNumArgs⟩
    | _ => none
  | .app .. =>
    match e.getAppFn with
    | .const c _ => some ⟨false, c, e.getAppNumArgs⟩
    | _ => none
  | _ => none

/-- One scan: closed subterms bucketed by pattern key. -/
private partial def collectKeyed (e : Expr) :
    Std.HashMap LemKey (Array Expr) :=
  go e {}
where
  go (e : Expr) (acc : Std.HashMap LemKey (Array Expr)) :
      Std.HashMap LemKey (Array Expr) :=
    let acc := match keyOfTerm e with
      | some k =>
        if e.hasLooseBVars then acc
        else acc.insert k ((acc.getD k #[]).push e)
      | none => acc
    match e with
    | .app f a => go a (go f acc)
    | .lam _ d b _ => go b (go d acc)
    | .forallE _ d b _ => go b (go d acc)
    | .letE _ t v b _ => go b (go v (go t acc))
    | .mdata _ b => go b acc
    | .proj _ _ b => go b acc
    | _ => acc

/-- Match the ∀-lemma's equation LHS against a candidate (unification
with fresh metavariables at reducible transparency — pattern matching
must not delta-unfold module bodies on near-misses); return the
instantiated equation proof. -/
def matchLemma (lem : Name) (cand : Expr) : TermElabM (Option Expr) := do
  observing? do
    let lemC ← mkConstWithFreshMVarLevels lem
    let (ms, _, ty) ← forallMetaTelescope (← inferType lemC)
    let some (_, lhs, _) := ty.eq?
      | throwError "HydroGen: {lem} is not an equation"
    unless ← withReducible <| isDefEq lhs cand do
      throwError "no match"
    for m in ms do
      unless ← m.mvarId!.isAssigned do
        let mty ← instantiateMVars (← m.mvarId!.getType)
        m.mvarId!.assign (← synthInstance mty)
    instantiateMVars (mkAppN lemC ms)

/-- A tracked equation-proof chain `prf : lhs = rhs` (carrier `α :
Sort u`). Tracking `rhs` avoids re-inferring the growing proof's type
on every rewrite step. -/
structure RwSt where
  prf : Expr
  lhs : Expr
  rhs : Expr
  α : Expr
  u : Level

def RwSt.ofProof (prf lhs rhs : Expr) : TermElabM RwSt := do
  let α ← inferType lhs
  pure { prf, lhs, rhs, α, u := ← getLevel α }

/-- One tracked rewrite: `eqPrf : c = d` replaces all occurrences of
`c` in `rhs` (`Eq.trans`/`congrArg` assembled manually — no proof-
chain type inference). Returns `none` when the pattern is absent. -/
def RwSt.rwStep (st : RwSt) (eqPrf : Expr) :
    TermElabM (Option RwSt) := do
  let eTy ← whnfR (← inferType eqPrf)
  let some (γ, c, d) := eTy.eq? | return none
  -- reducible: the pattern is syntactically present (found by the
  -- reducible matcher); default-transparency near-miss comparisons
  -- against module-sized subterms are the classic whnf blowup
  let rhsAbs ← withReducible <| kabstract st.rhs c
  unless rhsAbs.hasLooseBVars do return none
  let motive := Expr.lam `w γ rhsAbs .default
  let uγ ← getLevel γ
  let step := mkApp6 (.const ``congrArg [uγ, st.u]) γ st.α c d
    motive eqPrf
  let rhs' := rhsAbs.instantiate1 d
  let prf' := mkApp6 (.const ``Eq.trans [st.u]) st.α st.lhs st.rhs
    rhs' st.prf step
  pure (some { st with prf := prf', rhs := rhs' })

/-- First structurally divergent subterm pair (for meet-check
diagnostics — the pretty printer hides instances/universes/mdata). -/
partial def exprDiff (a b : Expr) : Option (Expr × Expr) :=
  if a == b then none
  else match a, b with
    | .app f₁ a₁, .app f₂ a₂ =>
      -- divergent heads: report the whole applications (the heads
      -- alone say nothing about WHICH redex is stuck)
      if a.getAppFn != b.getAppFn || a.getAppNumArgs != b.getAppNumArgs then some (a, b)
      else (exprDiff f₁ f₂).orElse fun _ => exprDiff a₁ a₂
    | .lam _ d₁ b₁ _, .lam _ d₂ b₂ _ =>
      (exprDiff d₁ d₂).orElse fun _ => exprDiff b₁ b₂
    | .forallE _ d₁ b₁ _, .forallE _ d₂ b₂ _ =>
      (exprDiff d₁ d₂).orElse fun _ => exprDiff b₁ b₂
    | .letE _ t₁ v₁ b₁ _, .letE _ t₂ v₂ b₂ _ =>
      ((exprDiff t₁ t₂).orElse fun _ => exprDiff v₁ v₂).orElse
        fun _ => exprDiff b₁ b₂
    | .mdata _ e₁, .mdata _ e₂ => some ((exprDiff e₁ e₂).getD (a, b))
    | .proj _ _ e₁, .proj _ _ e₂ => some ((exprDiff e₁ e₂).getD (a, b))
    | _, _ => some (a, b)

def meetError (mName : Name) (what : String) (tC tR : Expr) :
    TermElabM Expr := do
  match exprDiff tC tR with
  | some (dA, dB) =>
    throwError "HydroGen: {mName}: {what} does not meet; first \
      divergence:\ncorner node ({dA.ctorName}): {dA}\nmodule node \
      ({dB.ctorName}): {dB}"
  | none =>
    throwError "HydroGen: {mName}: {what} does not meet (no \
      structural diff?!)"

/-- Match memo: results depend only on `(lemma, candidate)` — shared
across rounds AND legs (wire projections recur in every leg). -/
abbrev MatchCache := IO.Ref (Std.HashMap (Name × Expr) (Option Expr))

def matchLemmaC (cache : MatchCache) (lem : Name) (cand : Expr) :
    TermElabM (Option Expr) := do
  if let some r := (← cache.get).get? (lem, cand) then
    return r
  let r ← matchLemma lem cand
  cache.modify (·.insert (lem, cand) r)
  pure r

/-- Rewrite by the lemma set to fixpoint: per round, ONE keyed scan
buckets the closed subterms; each lemma only tries candidates under
its own key (a stale candidate after an earlier rewrite in the same
round just no-ops at `kabstract`). Fresh redexes exposed by a rewrite
are picked up by the next round. -/
def RwSt.rwResiduals (st : RwSt) (lems : Array (Name × LemKey))
    (cache : MatchCache) : TermElabM RwSt := do
  let mut st := st
  for _ in [0:8] do
    let mut changed := false
    let table := collectKeyed st.rhs
    for (lem, key) in lems do
      if let some cands := table.get? key then
        for cand in cands do
          if let some eqPrf ← matchLemmaC cache lem cand then
            if let some st' ← st.rwStep eqPrf then
              st := st'
              changed := true
    unless changed do break
  pure st

/-! ## Gadget vocabulary (stream vs tick) -/

structure KGad where
  isTick : Bool
  schedC : Name
  probeC : Name
  mkC : Name
  lowerC : Name
  fixSr : Name
  sbody : Name
  vbody : Name
  schedHfix' : Name
  agree : Name
  /-- The graded agreement of the loop carrier (D95: `SAgreeL`/`TAgreeL`). -/
  agreeL : Name
  /-- `agreeL h 0 ↔ agree h`. -/
  agreeLZero : Name
  /-- Strictness of a body function in the loop wire (`SStrict`/`TStrict`). -/
  strictPred : Name
  /-- The graded knot causality (`causalL_fix_stream`/`causalL_fix_tick`). -/
  fixCausalL : Name
  /-- The knot's lag (D95): the body's output lag at the lag probe. -/
  fixLag : Name
  lagProbeC : Name

def gadStream : KGad :=
  { isTick := false, schedC := ``CoStream.schedC,
    probeC := ``CoStream.probeC, mkC := ``CoStream.mkC,
    lowerC := ``CoStream.lowerC, fixSr := ``CoStream.fixSr,
    sbody := ``CoStream.sbody, vbody := ``CoStream.vbody,
    schedHfix' := ``sched_hfix_stream', agree := ``SAgree,
    agreeL := ``SAgreeL, agreeLZero := ``SAgreeL_zero, strictPred := ``SStrict,
    fixCausalL := ``causalL_fix_stream,
    fixLag := ``CoStream.fixLag, lagProbeC := ``CoStream.lagProbeC }

def gadTick : KGad :=
  { isTick := true, schedC := ``CoTickSing.schedC,
    probeC := ``CoTickSing.probeC, mkC := ``CoTickSing.mkC,
    lowerC := ``CoTickSing.lowerC, fixSr := ``CoTickSing.fixSr,
    sbody := ``CoTickSing.sbody, vbody := ``CoTickSing.vbody,
    schedHfix' := ``sched_hfix_tick', agree := ``TAgree,
    agreeL := ``TAgreeL, agreeLZero := ``TAgreeL_zero, strictPred := ``TStrict,
    fixCausalL := ``causalL_fix_tick,
    fixLag := ``CoTickSing.fixLag, lagProbeC := ``CoTickSing.lagProbeC }

/-! ## The body composition -/

/-- A knot-body argument (positions after the interpretation). -/
inductive BArg where
  /-- The loop wire. -/
  | gadget
  /-- Closed over the knot's fvars (wire/decision/plain). -/
  | expr (e : Expr)
  /-- An inner-knot application (contains the loop wire); index into
  the flat inner table. -/
  | inner (idx : Nat)
  deriving Inhabited, Repr

/-- An inner-knot application, kept as the ORIGINAL `Expr` over the
loop fvar (instances preserved), plus its parsed argument view. -/
structure InnerApp where
  kName : Name
  gi : GenInfo
  /-- Args strictly before the interpretation instance (closed). -/
  preArgs : Array Expr
  /-- Explicit args after the interpretation. -/
  args : Array BArg
  kinds : Array ArgKind
  /-- The original application over the loop fvar (at the corner). -/
  app : Expr
  deriving Inhabited

/-- The parsed knot body: a leg-selected registered-module application
whose arguments may contain inner knots. -/
structure BodyComp where
  bodyMod : Name
  gi : GenInfo
  legPath : List LegStep
  legIdx : Nat
  legsCount : Nat
  /-- Args strictly before the interpretation instance. -/
  preArgs : Array Expr
  args : Array BArg
  kinds : Array ArgKind
  /-- The original module application over the loop fvar. -/
  coreApp : Expr
  inners : Array InnerApp
  /-- Wrapper defs opened while parsing (for `unfold` lists). -/
  unfolded : Array Name
  deriving Inhabited

/-- The `LegStep` for field `i` of structure `s`. -/
def projStepOf (s : Name) (i : Nat) : MetaM LegStep := do
  if s == ``Prod then
    pure (if i == 0 then .fst else .snd)
  else if s == ``Subtype then
    pure .val
  else
    let fields := getStructureFields (← getEnv) s
    pure (.field fields[i]!)

/-- Peel outer projections (const-app form or `Expr.proj`) into a leg
path; returns the operand. -/
partial def peelOuterProj (e : Expr) (acc : List LegStep) :
    MetaM (Expr × List LegStep) := do
  let env ← getEnv
  match e with
  | .proj s i x =>
    let step ← projStepOf s i
    peelOuterProj x (step :: acc)
  | _ =>
    let f := e.getAppFn
    if let .const c _ := f then
      if let some pi := env.getProjectionFnInfo? c then
        let args := e.getAppArgs
        if args.size == pi.numParams + 1 then
          let s := pi.ctorName.getPrefix
          let step ← projStepOf s pi.i
          return ← peelOuterProj args[pi.numParams]! (step :: acc)
    pure (e, acc)

/-- Find the interpretation-instance position among an application's
arguments (the arg whose type's head is `HydroSem`). -/
def interpPosOf (args : Array Expr) : MetaM (Option Nat) := do
  for h : i in [0:args.size] do
    let t ← inferType args[i]
    if t.getAppFn.isConstOf ``HydroSem then
      return some i
  return none

/-- Parse the knot body at `(corner, capsVal, loopFVar)`: peel outer
projections, unfold unregistered wrappers, classify args, recurse into
inner knots. -/
partial def parseKnotBody (corner : Expr) (loopFVar : Expr) (e : Expr) :
    TermElabM BodyComp := do
  let (core, path) ← peelOuterProj e []
  go core path #[]
where
  go (core : Expr) (path : List LegStep) (unfolded : Array Name) :
      TermElabM BodyComp := do
    let core := core.headBeta
    let f := core.getAppFn
    let .const c _ := f |
      throwError "HydroGen: knot body head is not a constant ({core})"
    if let some gi := getGenInfo (← getEnv) c then
      -- registered module: classify
      let args := core.getAppArgs
      let some hPos ← interpPosOf args |
        throwError "HydroGen: body module {c} application has no \
          interpretation argument"
      let mut inners : Array InnerApp := #[]
      let mut bargs : Array BArg := #[]
      let mut kinds : Array ArgKind := #[]
      for i in [hPos+1:args.size] do
        let a0 := args[i]!
        if a0 == loopFVar then
          kinds := kinds.push (← classifyArg corner (← inferType a0))
          bargs := bargs.push .gadget
        else if a0.containsFVar loopFVar.fvarId! then
          kinds := kinds.push (← classifyArg corner (← inferType a0))
          let (ia, inners') ← parseInner a0 inners
          inners := inners'
          bargs := bargs.push (.inner ia)
        else
          let a ← whnf a0
          kinds := kinds.push (← classifyArg corner (← inferType a))
          bargs := bargs.push (.expr a)
      -- leg index: match the path against the module's output legs
      let legs ← legsOfCore core hPos
      let some legIdx := legs.idxOf? path |
        throwError "HydroGen: leg path {repr path} not among \
          {c}'s legs {repr legs}"
      return { bodyMod := c, gi, legPath := path, legIdx,
               legsCount := legs.size,
               preArgs := args[0:hPos].toArray,
               args := bargs, kinds, coreApp := core, inners,
               unfolded }
    else
      -- unregistered wrapper: unfold and re-peel
      let info ← getConstInfo c
      let some v := info.value? |
        throwError "HydroGen: knot body head {c} is not registered \
          and has no value"
      let core' := (v.instantiateLevelParams info.levelParams
        (f.constLevels!)).beta core.getAppArgs
      let (core'', path') ← peelOuterProj core' []
      go core'' (path' ++ path) (unfolded.push c)
  parseInner (a : Expr) (inners : Array InnerApp) :
      TermElabM (Nat × Array InnerApp) := do
    let a := a.headBeta
    let f := a.getAppFn
    let .const c _ := f |
      throwError "HydroGen: inner-knot head is not a constant ({a})"
    let some gi := getGenInfo (← getEnv) c |
      throwError "HydroGen: inner knot {c} is not registered \
        (generate it first)"
    let args := a.getAppArgs
    let some hPos ← interpPosOf args |
      throwError "HydroGen: inner knot {c} has no interpretation arg"
    let mut inners := inners
    let mut bargs : Array BArg := #[]
    let mut kinds : Array ArgKind := #[]
    for i in [hPos+1:args.size] do
      let x0 := args[i]!
      if x0 == loopFVar then
        kinds := kinds.push (← classifyArg corner (← inferType x0))
        bargs := bargs.push .gadget
      else if x0.containsFVar loopFVar.fvarId! then
        kinds := kinds.push (← classifyArg corner (← inferType x0))
        let (ia, inners') ← parseInner x0 inners
        inners := inners'
        bargs := bargs.push (.inner ia)
      else
        let x ← whnf x0
        kinds := kinds.push (← classifyArg corner (← inferType x))
        bargs := bargs.push (.expr x)
    let ia : InnerApp :=
      { kName := c, gi, preArgs := args[0:hPos].toArray,
        args := bargs, kinds, app := a }
    return (inners.size, inners.push ia)
  legsOfCore (core : Expr) (hPos : Nat) : TermElabM (Array (List LegStep)) := do
    -- the module's output legs, from the applied core's type
    let _ := hPos
    let ty ← inferType core
    peelLegs ty []

/-! ## The knot context -/

structure KnotCtx where
  mc : ModCtx
  gad : KGad
  df : Expr
  caps : Expr
  bodyFn : Expr
  /-- The unit-level body `bodyFn corner caps`. -/
  B : Expr
  loopTy : Expr
  loopFVar : Expr
  comp : BodyComp
  /-- For body-constant knots (`pcSeqF`): the fix is applied inline by
  the program; statements are at the `H.fix` application and `df` is a
  fresh binder. -/
  bodyConst : Bool

/-- Extract `(isTick, df, caps, bodyFn)` from the knot def's value. -/
def extractFix2 (mc : ModCtx) : TermElabM (Option (Bool × Expr × Expr × Expr)) := do
  let info ← getConstInfo mc.mName
  let some v := info.value? |
    throwError "HydroGen: {mc.mName} has no value"
  let app := (v.beta (mc.ctxArgs ++ #[mc.corner] ++ mc.args)).headBeta
  let pick := fun (app : Expr) (tick : Bool) => do
    let args := app.getAppArgs
    unless args.size ≥ 3 do
      throwError "HydroGen: {mc.mName}: fix arity {args.size}"
    pure (some (tick, args[args.size - 3]!, args[args.size - 2]!,
      args[args.size - 1]!))
  if app.getAppFn.isConstOf ``HydroSem.fix then return ← pick app false
  if app.getAppFn.isConstOf ``HydroSem.fixTick then return ← pick app true
  if let some app' ← whnfUntil app ``HydroSem.fix then
    return ← pick app' false
  if let some app' ← whnfUntil app ``HydroSem.fixTick then
    return ← pick app' true
  pure none

/-- Open knot `K`'s context: module telescope, fix extraction, body
parse (the loop fvar stays in scope for `k`). -/
def withKnotCtx (mc : ModCtx) (k : KnotCtx → TermElabM α) :
    TermElabM α := do
  let some (isTick, df, caps, bodyFn) ← extractFix2 mc |
    throwError "HydroGen: {mc.mName}: no HydroSem.fix/fixTick at the head"
  unless mc.legs.size == 1 && mc.legs[0]! == [] do
    throwError "HydroGen: hydro_knot expects a bare single-leg knot"
  let gad := if isTick then gadTick else gadStream
  let loopTy := mc.legTys[0]!
  withLocalDecl `zknot .default loopTy fun loopFVar => do
    let bodyAt := (mkApp2 bodyFn mc.corner caps).headBeta
    let bodyOpen := (mkApp bodyAt loopFVar).headBeta
    let comp ← parseKnotBody mc.corner loopFVar bodyOpen
    k { mc, gad, df, caps, bodyFn, B := bodyAt, loopTy, loopFVar, comp,
        bodyConst := false }

/-! ## Valuations over the composition -/

/-- How to value each argument position of the (body/inner) modules
when reconstructing an application at a target interpretation. -/
structure BVal where
  interp : Expr
  /-- The value for the loop position. -/
  gadget : Expr
  /-- Wire args (by raw corner expr). -/
  wire : Expr → TermElabM Expr
  /-- Primitive decisions. -/
  prim : DecFam → Expr → TermElabM Expr
  /-- Decision records. -/
  recd : Expr → TermElabM Expr
  /-- Plain data. -/
  plain : Expr → TermElabM Expr := pure

/-- The machine-side valuation over the knot's own fvars. -/
def BVal.machine (kc : KnotCtx) (gadget : Expr) : BVal :=
  { interp := kc.mc.sched, gadget,
    wire := fun e => mkProjection e `sr,
    prim := fun f e =>
      pure (if f.schedPass then e else mkConst ``Unit.unit),
    recd := fun e => repackRec kc.mc.corner kc.mc.sched
      (fun f p =>
        pure (if f.schedPass then p else mkConst ``Unit.unit)) e }

/-- The lowered-corner valuation (`hcplj`): wires lowered, records
identity-repacked, gadget at `mkC`. -/
def BVal.lowered (kc : KnotCtx) (corner' : Expr) (gadget : Expr)
    (hjE hjT' : Expr) : BVal :=
  { interp := corner', gadget,
    wire := fun e => do
      let hd ← whnf (← inferType e)
      let lc := if hd.isAppOf ``CoTickSing then ``CoTickSing.lowerC
        else if hd.isAppOf ``CoSing then ``CoSing.lowerC
        else if hd.isAppOf ``CoKStream then ``CoKStream.lowerC
        else ``CoStream.lowerC
      applyNamed lc kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT
        #[hjE, hjT', e],
    prim := fun _ e => pure e,
    recd := fun e => repackRec kc.mc.corner corner' (fun _ p => pure p) e }

/-- Value a `BArg` under a valuation (inner knots reconstructed at the
valuation's interpretation, recursively). -/
partial def bargVal (kc : KnotCtx) (bv : BVal)
    (a : BArg) (kind : ArgKind) : TermElabM Expr := do
  match a with
  | .gadget => pure bv.gadget
  | .expr e =>
    match kind with
    | .wire _ => bv.wire e
    | .primDec f => bv.prim f e
    | .decRec _ => bv.recd e
    | .plain => bv.plain e
  | .inner idx => withDeclDiag "bargVal/inner" do
    let ia := kc.comp.inners[idx]!
    let mut args := #[]
    for a' in ia.args, k' in ia.kinds do
      args := args.push (← bargVal kc bv a' k')
    pure (mkAppN ia.app.getAppFn (ia.preArgs ++ #[bv.interp] ++ args))

/-- Value the body-module argument list under a valuation. -/
def bodyArgsVal (kc : KnotCtx) (bv : BVal) : TermElabM (Array Expr) := do
  let mut out := #[]
  for a in kc.comp.args, k in kc.comp.kinds do
    out := out.push (← bargVal kc bv a k)
  pure out

mutual

/-- An inner app at the corner, at a given gadget value (reduced-args
spelling, consistent with the parse). -/
partial def cornerInnerAt (kc : KnotCtx) (idx : Nat) (g : Expr) :
    Expr :=
  let ia := kc.comp.inners[idx]!
  mkAppN ia.app.getAppFn
    (ia.preArgs ++ #[kc.mc.corner] ++ cornerInnerArgsAt kc idx g)

/-- Corner-side args of inner app `idx` at a gadget value. -/
partial def cornerInnerArgsAt (kc : KnotCtx) (idx : Nat) (g : Expr) :
    Array Expr := Id.run do
  let ia := kc.comp.inners[idx]!
  let mut out := #[]
  for a in ia.args do
    match a with
    | .gadget => out := out.push g
    | .expr e => out := out.push e
    | .inner j => out := out.push (cornerInnerAt kc j g)
  pure out

end

/-- Apply a generated module lemma whose binder convention is
`ctxArgs ++ {pacing Tc Td hjT} ++ args (++ extra)` at explicit args
drawn from an applied occurrence of module `lemOwner`. -/
def applyModLemma (lemOwner : Name) (lem : Name)
    (pacing Tc Td hjT : Expr) (pre : Array Expr) (args : Array Expr)
    (extra : Array Expr := #[]) : TermElabM Expr := do
  applyNamed lem pacing Tc Td hjT (args ++ extra) (pre := pre)

/-! ## The derived-decision composition (`vdec` at the knot wires) -/

/-- The body module's choice-`vdec` applied at the knot's machine
wires, with the loop position at `gadgetMach` (the machine knot for
naming statements; the named diagonal for `wf` facts). -/
def vdecCompOf (kc : KnotCtx) (gadgetMach : Expr) : TermElabM Expr := do
  let some vd := kc.comp.gi.vdec? |
    throwError "HydroGen: body module {kc.comp.bodyMod} has no vdec"
  let bv := BVal.machine kc gadgetMach
  let mut plains := #[]
  let mut outers := #[]
  for a in kc.comp.args, k in kc.comp.kinds do
    match k with
    | .plain => plains := plains.push (← bargVal kc bv a k)
    | .wire cf =>
      outers := outers.push (← bargVal kc bv a k)
      -- a fold singleton's remembered machine source (genRrEx's
      -- `x{i}_src` binder follows its `x{i}`)
      if cf == .sing then
        match a with
        | .expr e => outers := outers.push (← mkProjection e `src)
        | _ => throwError "HydroGen: singleton body arg is not a plain \
            expression"
    | .primDec f =>
      if f.schedPass then
        outers := outers.push (← bargVal kc bv a k)
    | .decRec _ =>
      let e ← match a with
        | .expr e => pure e
        | _ => throwError "HydroGen: decision-record body arg is not \
            a plain expression"
      for (path, f) in flattenTree (← decFieldTreeOf kc.mc.corner e) do
        if f.schedPass then
          outers := outers.push (← applyFieldPath e path)
  applyNamed vd kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT
    (plains ++ outers) (pre := kc.comp.preArgs)

/-! ## Knot namings -/

/-- Rule names for the machine naming: the body leg's sr lemma plus
every inner knot's sr naming. -/
def knotSrRules (kc : KnotCtx) : TermElabM (Array Name) := do
  let bodySrs := kc.comp.gi.srLemmas
  unless kc.comp.legIdx < bodySrs.size do
    throwError "HydroGen: {kc.comp.bodyMod} has no sr naming for leg \
      {kc.comp.legIdx}"
  let mut out := #[bodySrs[kc.comp.legIdx]!]
  for ia in kc.comp.inners do
    out := out ++ ia.gi.srLemmas
  pure out

def knotRrRules (kc : KnotCtx) : TermElabM (Array Name) := do
  let bodyRrs := kc.comp.gi.rrLemmas
  unless kc.comp.legIdx < bodyRrs.size do
    throwError "HydroGen: {kc.comp.bodyMod} has no rr naming for leg \
      {kc.comp.legIdx}"
  let mut out := #[bodyRrs[kc.comp.legIdx]!]
  for ia in kc.comp.inners do
    out := out ++ ia.gi.rrLemmas ++ ia.gi.srLemmas
  pure out

def namesList (ns : Array Name) : String :=
  String.intercalate ", " (ns.toList.map toString)

/-- Defeq coercion with a check (pins gadget constructors' implicit
`ord`/`ret` via the target carrier type). -/
def coerceTo (e : Expr) (ty : Expr) : TermElabM Expr := do
  unless ← isDefEq (← inferType e) ty do
    throwError "HydroGen: gadget coercion failed: {e} : {ty}"
  instantiateMVars e

/-- Embed a machine wire value as a corner wire (`schedC`), at the
given corner carrier type. -/
def cornerize (kc : KnotCtx) (m : Expr) (cornerTy : Expr) :
    TermElabM Expr := do
  let isTick := (← whnf cornerTy).isAppOf ``CoTickSing
  let c := if isTick then ``CoTickSing.schedC else ``CoStream.schedC
  coerceTo (← applyNamed c kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT
    #[m]) cornerTy

/-- The machine knot `K @ SchedSem` (statement RHS). -/
def knotKS (kc : KnotCtx) : TermElabM Expr := do
  pure <| mkAppN (mkConst kc.mc.mName)
    (kc.mc.ctxArgs ++ #[kc.mc.sched] ++ (← kc.mc.srArgs))

/-- `K_co_sr₁`: the machine naming, by the `co_knot_sr` house script. -/
def genKnotSr (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let lhs ← mkProjection mc.appCorner `sr
  let rhs ← knotKS kc
  let stmt ← mkForallFVars mc.allBinders (← mkEq lhs rhs)
  let defs := namesList (#[mc.mName] ++ kc.comp.unfolded)
  let rules := namesList (← knotSrRules kc)
  let name := mc.mName.appendAfter "_co_sr₁"
  addThmByTac name stmt s!"(intros; co_knot_sr [{defs}] [{rules}])"
  pure name

/-- `co_knot_rr` with fuel-pin closers (the choice-`vdec`'s fuel legs
are propositionally—not definitionally—`Td + 1`; the pins are
installed facts `PIN…` applied at `schedC`-cornerized outers, closing
the fuel leg by `exact`-defeq). -/
macro "co_knot_rr₂" hsr:term:max "[" defs:ident,* "]"
    "[" pins:term,* "]" "[" rules:term,* "]" : tactic => do
  let ds := defs.getElems
  let fuelAlts ← pins.getElems.mapM fun p =>
    `(tactic| exact Eq.symm $p)
  let fuelBase : Array (TSyntax `tactic) :=
    #[← `(tactic| with_reducible rfl), ← `(tactic| rfl)]
  let failT ← `(tactic| fail "co_knot_rr₂: fuel leg not closed")
  let fuelTac ← (fuelBase ++ fuelAlts).foldrM (init := failT)
    fun t acc => `(tactic| first | $t:tactic | $acc:tactic)
  `(tactic| (
    have h := $hsr
    unfold $[$ds]* at h ⊢
    first
      | rw [co_hfix_stream_sr] at h
      | rw [co_hfix_tick_sr] at h
    first
      | refine Eq.trans ?_ (values_hfix_stream' _ _ _).symm
      | refine Eq.trans ?_ (values_hfix_tick' _ _ _).symm
    first
      | rw [co_hfix_stream_rr]
      | rw [co_hfix_tick_rr]
    refine congrArg₂ _ ?_ ?_
    · $fuelTac:tactic
    funext v
    rw [h]
    co_body_rw [$rules,*]
    try simp only [co_schedC_sr, co_tick_schedC_sr]
    try with_reducible rfl
    try exact rfl))

/-- The `Values`-side argument list of `K` (wires `.rr`, the decision
unit at the composed `vdec`, fuels at `Td + 1`). -/
def knotRrArgs (kc : KnotCtx) (vdecC : Expr) : TermElabM (Array Expr) := do
  let mc := kc.mc
  let mut out := #[]
  for a in mc.args, k in mc.kinds, t in mc.trees do
    match k with
    | .wire _ => out := out.push (← mkProjection a `rr)
    | .decRec _ =>
      -- content-carrying records take the composed `vdec`; sched-only
      -- records (all-`Unit` at `Values`) are repacked field-wise, as
      -- in `rrArgsDirect` (statements are built by raw `mkAppN`, so a
      -- wrong slot here surfaces only as a naming-tactic failure).
      if treeHasContent t.get! then out := out.push vdecC
      else
        out := out.push (← repackRec mc.corner mc.values
          (fun f p => do
            match f with
            | .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
            | _ =>
              if f.valuesPass then pure p
              else pure (mkConst ``Unit.unit)) a)
    | .primDec .fixd =>
      out := out.push (← mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1])
    | .primDec f =>
      if f.isContent then out := out.push vdecC
      else if f.valuesPass then out := out.push a
      else out := out.push (mkConst ``Unit.unit)
    | .plain => out := out.push a
  pure out

/-- `K_co_rr₁`: the denotational naming at the composed `vdec`. -/
def genKnotRr (kc : KnotCtx) (srName : Name) : TermElabM Name := do
  let mc := kc.mc
  let lhs ← mkProjection mc.appCorner `rr
  let KS ← knotKS kc
  let vdecC ← vdecCompOf kc KS
  let rhs := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.values] ++ (← knotRrArgs kc vdecC))
  let concl ← mkEq lhs rhs
  let defs := namesList (#[mc.mName] ++ kc.comp.unfolded)
  let rules := namesList (← knotRrRules kc)
  let hsrTerm := mkAppN (mkConst srName) mc.allBinders
  -- the fuel-pin facts, at `schedC`-cornerized outers (their machine
  -- legs are `exact`-defeq to the statement's raw machine values)
  let bvM := BVal.machine kc KS
  let mut pinArgs : Array Expr := #[]
  for a in kc.comp.args, k in kc.comp.kinds do
    match a with
    | .gadget => pinArgs := pinArgs.push (← cornerize kc KS kc.loopTy)
    | .expr e => pinArgs := pinArgs.push e
    | .inner idx =>
      let m ← bargVal kc bvM a k
      let ty ← inferType (kc.comp.inners[idx]!).app
      pinArgs := pinArgs.push (← cornerize kc m ty)
  let mut pinFacts : Array Expr := #[]
  for pin in kc.comp.gi.pinLemmas do
    pinFacts := pinFacts.push (← applyModLemma kc.comp.bodyMod pin
      mc.pacing mc.Tc mc.Td mc.hjT kc.comp.preArgs pinArgs)
  let pinNames := (Array.range pinFacts.size).map fun i =>
    Name.mkSimple s!"PIN{i + 1}"
  let pinList := String.intercalate ", "
    (pinNames.toList.map toString)
  let mut factDecls : Array (Name × BinderInfo ×
      (Array Expr → TermElabM Expr)) := #[]
  factDecls := factDecls.push (`HSR, .default,
    fun _ => inferType hsrTerm)
  for n in pinNames, f in pinFacts do
    factDecls := factDecls.push (n, .default, fun _ => inferType f)
  let prfClosed ← withLocalDecls factDecls fun factFVars => do
    let prf ← proveByTacOpen concl
      s!"(co_knot_rr₂ HSR [{defs}] [{pinList}] [{rules}])"
    pure ((← mkLambdaFVars factFVars prf).beta (#[hsrTerm] ++ pinFacts))
  let name := mc.mName.appendAfter "_co_rr₁"
  let stmt ← mkForallFVars mc.allBinders concl
  let val ← mkLambdaFVars mc.allBinders prfClosed
  addThm name stmt val
  pure name


/-! ## Knot strictness (`causalL_fix_*` over the composed body) -/

/-- Corner-side body args at a given gadget value (reduced exprs,
inner apps rebuilt at the corner). -/
def cornerArgsAt (kc : KnotCtx) (g : Expr) : Array Expr := Id.run do
  let mut out := #[]
  for a in kc.comp.args do
    match a with
    | .gadget => out := out.push g
    | .expr e => out := out.push e
    | .inner idx => out := out.push (cornerInnerAt kc idx g)
  pure out

/-- The lag of a corner argument value, as an equation `a.lag = r` (D95):
a horizon lowering's is its wire's, a `mkC`'s is its lag argument, a lag
probe's its numeral, an inner knot application's its lag naming over its
own arguments (recursively). `none` for a plain binder (an atom) or a
non-wire. The knot's lag facts are assembled from these by rewriting the
body's lag naming — never by `simp` over the body application itself
(whose arguments carry records, proofs and the Kleene iterate: the walk
over them is what a plain `collapse` pays for). -/
partial def lagEqOf (a : Expr) : TermElabM (Option Expr) := do
  let a := a.consumeMData
  let .const c _ := a.getAppFn | return none
  let n := a.getAppNumArgs
  let rflEq := fun (rhs : Expr) => do
    let lhs ← mkProjection a `lag
    pure (some (← mkExpectedTypeHint (← mkEqRefl rhs) (← mkEq lhs rhs)))
  if c == ``CoStream.lowerC || c == ``CoTickSing.lowerC || c == ``CoSing.lowerC
      || c == ``CoKStream.lowerC then
    rflEq (← mkProjection a.appArg! `lag)
  else if c == ``CoStream.mkC then rflEq (a.getArg! (n - 2))
  else if c == ``CoTickSing.mkC then rflEq (a.getArg! (n - 3))
  else if c == ``CoStream.lagProbeC || c == ``CoTickSing.lagProbeC then rflEq a.appArg!
  else if c == ``CoStream.inputC || c == ``CoTickSing.inputC || c == ``CoSing.inputC then
    rflEq (mkNatLit 0)
  else
    let some gi := getGenInfo (← getEnv) c | return none
    unless gi.lagLemmas.size == 1 do return none
    let args := a.getAppArgs
    let some hPos ← interpPosOf args | return none
    let interp := args[hPos]!
    unless interp.isAppOfArity ``CoupleSem 6 do return none
    let iargs := interp.getAppArgs
    let eq ← applyModLemma c gi.lagLemmas[0]! iargs[2]! iargs[3]! iargs[4]! iargs[5]!
      args[0:hPos].toArray args[hPos+1:args.size].toArray
    let mut eqs := #[]
    for x in args[hPos+1:args.size] do
      if let some e ← lagEqOf x then eqs := eqs.push e
    pure (some (← rwRhsAll eq eqs))

/-- A lag fact over argument values: the body's lag naming at the values,
the values' own lags substituted (`lagEqOf`), the small arithmetic that
remains normalized. -/
def lagFactAt (lem : Name) (owner : Name) (pacing Tc Td hjT : Expr)
    (pre args : Array Expr) : TermElabM Expr := do
  let eq ← withDeclDiag "lagFactAt/apply" <| applyModLemma owner lem pacing Tc Td hjT pre args
  let mut eqs := #[]
  for x in args do
    if let some e ← withDeclDiag "lagFactAt/lagEqOf" <| lagEqOf x then eqs := eqs.push e
  let eq' ← withDeclDiag "lagFactAt/rw" <| rwRhsAll eq eqs
  if (← IO.getEnv "HYDROGEN_HB_DIAG").isSome then
    let ty ← inferType eq'
    IO.eprintln s!"[lagFactAt] {eqs.size} arg eqs; rhs depth {ty.appArg!.approxDepth}; rhs: {(← ppExpr ty.appArg!).pretty.take 400}"
  withDeclDiag "lagFactAt/collapse" <| collapseLagFact eq' #[]

/-- Apply a lemma with some arguments given BY BINDER NAME (the rest
inferred by unification, instances synthesized): `mkAppOptM` at the
positions the lemma's telescope assigns to the names. -/
def applyByName (lem : Name) (named : Array (Name × Expr)) : TermElabM Expr := do
  let info ← getConstInfo lem
  let names ← forallTelescope info.type fun xs _ => xs.mapM fun x => x.fvarId!.getUserName
  let mut args : Array (Option Expr) := Array.replicate names.size none
  for (n, e) in named do
    let some i := names.idxOf? n |
      throwError "HydroGen: {lem} has no binder `{n}` (binders: {names})"
    args := args.set! i (some e)
  mkAppOptM lem args

/-- The knot's lag, opened by the GENERIC instance lemmas (D95): `(K corner
args).lag = (fixTick df caps bodyFn).lag` is one delta of `K`;
`co_hfix_*_lag df caps bodyFn : (fix …).lag = (bodyFn _ caps g0).lag` with
`g0 := lagProbeC (fixSrC caps bodyFn) 1` the lemma's own probe; and
`co_hfix_*_fixLag : (fix …).lag = fixLag (bodyFn _ caps)` (the named
`K_lag`'s body). Every judgement left to the kernel is a delta of `K`/
`K_lag`/`K.body` meeting the SAME probe term on both sides — never a `.lag`
of two differently headed module applications, which the kernel decides by
evaluating the chain (`whnf` of the projected structure: 19 GB on
`leader_election`'s tick knot). Returns `(g0, hOpen, hFixLag)` with
`hOpen : (K corner args).lag = (bodyFn corner caps g0).lag` and
`hFixLag : fixLag (bodyFn corner caps) = (bodyFn corner caps g0).lag`. -/
def knotLagOpen (kc : KnotCtx) : TermElabM (Expr × Expr × Expr) := do
  let mc := kc.mc
  let info ← getConstInfo mc.mName
  let fixApp := (info.value!.beta (mc.ctxArgs ++ #[mc.corner] ++ mc.args)).headBeta
  let fixArgs := fixApp.getAppArgs
  unless fixArgs.size ≥ 4 do throwError "HydroGen: {mc.mName}: not a fix application"
  let Γ := fixArgs[3]!
  let lagLem := if kc.gad.isTick then ``co_hfix_tick_lag else ``co_hfix_stream_lag
  let fixLagLem := if kc.gad.isTick then ``co_hfix_tick_fixLag else ``co_hfix_stream_fixLag
  let named : Array (Name × Expr) :=
    #[(`L, mc.L), (`mem, mc.memE), (`pacing, mc.pacing), (`Tc, mc.Tc), (`Td, mc.Td), (`hjT, mc.hjT),
      (`Γ, Γ), (`df, kc.df), (`caps, kc.caps), (`body, kc.bodyFn)]
  let lemInst ← applyByName lagLem named
  let lemTy ← instantiateMVars (← inferType lemInst)
  let some (_, lemLhs, rhs) := lemTy.eq? | throwError "HydroGen: {lagLem}: not an equation"
  -- `rhs = (bodyFn _ caps g0).lag`: the probe is the struct's last argument
  let g0 := rhs.appArg!.appArg!
  let lhsK ← mkProjection mc.appCorner `lag
  let hOpen ← mkExpectedTypeHint lemInst (← mkEq lhsK rhs)
  let fixLagInst ← applyByName fixLagLem named
  let fixLagTy ← instantiateMVars (← inferType fixLagInst)
  let some (_, _, fixLagE) := fixLagTy.eq? | throwError "HydroGen: {fixLagLem}: not an equation"
  -- `fixLag (bodyFn _ caps) = (fix …).lag = (bodyFn _ caps g0).lag`
  let hFixLag ← mkEqTrans (← mkEqSymm fixLagInst) lemInst
  let hFixLag ← mkExpectedTypeHint hFixLag (← mkEq fixLagE rhs)
  let _ := lemLhs
  pure (g0, hOpen, hFixLag)

/-- `K_co_lag₁` (D95): the knot's lag, named — the body leg's lag naming at
the lag probe (`(K corner args).lag` is `fixLag B`, i.e. the body's output
lag at a loop input of lag `1`, by the instance lemmas — `knotLagOpen`), the
inner knots' lag namings folded in, the leaves and the `Nat` arithmetic
normalized. -/
def genKnotLag (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let comp := kc.comp
  unless comp.legIdx < comp.gi.lagLemmas.size do
    throwError "HydroGen: {comp.bodyMod} has no lag naming for leg {comp.legIdx}"
  let (g0, hOpen, _) ← knotLagOpen kc
  let fact ← lagFactAt comp.gi.lagLemmas[comp.legIdx]! comp.bodyMod
    mc.pacing mc.Tc mc.Td mc.hjT comp.preArgs (cornerArgsAt kc g0)
  let e0 := (← inferType fact).appArg!
  let lhs ← mkProjection mc.appCorner `lag
  let concl ← mkEq lhs e0
  let name := mc.mName.appendAfter "_co_lag₁"
  -- `(K corner args).lag = (bodyFn corner caps g0).lag = (leg (C … g0)).lag = e0`
  let some (_, _, rhsOpen) := (← inferType hOpen).eq? | throwError "HydroGen: knotLagOpen"
  let fact' ← mkExpectedTypeHint fact (← mkEq rhsOpen e0)
  let prf ← mkEqTrans hOpen fact'
  let stmt ← mkForallFVars mc.allBinders concl
  let val ← mkLambdaFVars mc.allBinders (← mkExpectedTypeHint prf concl)
  addThm name stmt val
  pure name

/-- The knot-arg index of a raw body-argument expr. -/
def argIdxOf (kc : KnotCtx) (e : Expr) : TermElabM Nat := do
  let some i := kc.mc.args.idxOf? e |
    throwError "HydroGen: body arg {e} is not a knot binder"
  pure i

/-- The agreement relation of a proof's type: `(lag?, head)` — `some n`
for a graded `SAgreeL/FAgreeL/TAgreeL h n`, `none` for a base
`SAgree/FAgree/TAgree h`. -/
def agreeLagOf (ty : Expr) : MetaM (Option (Option Nat)) := do
  let ty := (← instantiateMVars ty).consumeMData
  let .const c _ := ty.getAppFn | return none
  if c == ``SAgreeL || c == ``FAgreeL || c == ``TAgreeL then
    let args := ty.getAppArgs
    -- `{m} {α} (h n : Nat) x y`
    let n := args[args.size - 3]!
    match (← instantiateMVars n).nat? with
    | some k => return some (some k)
    | none => return none
  else if c == ``SAgree || c == ``FAgree || c == ``TAgree then
    return some none
  else return none

/-- A base agreement proof `agree h a a'` weakened to lag `1`
(`(agreeL_zero.mpr p).mono_lag (Nat.zero_le 1)`); a lag-`1` proof as is. -/
def agreeAtLag1 (cf : CarrierFam) (p : Expr) : TermElabM Expr := do
  match ← agreeLagOf (← inferType p) with
  | some (some 1) => pure p
  | some (some 0) =>
    mkAppM (agreeLMonoLagOf cf) #[← mkAppM ``Nat.zero_le #[mkNatLit 1], p]
  | some none =>
    let p0 ← mkAppM (agreeLZeroOf cf ++ `mpr) #[p]
    mkAppM (agreeLMonoLagOf cf) #[← mkAppM ``Nat.zero_le #[mkNatLit 1], p0]
  | _ => throwError "HydroGen: not an agreement proof at lag ≤ 1:{indentExpr (← inferType p)}"

/-- A base agreement proof from a base or lag-`0` one. -/
def agreeAtBase (cf : CarrierFam) (p : Expr) : TermElabM Expr := do
  match ← agreeLagOf (← inferType p) with
  | some none => pure p
  | some (some 0) => mkAppM (agreeLZeroOf cf ++ `mp) #[p]
  | _ => throwError "HydroGen: not a base agreement proof:{indentExpr (← inferType p)}"

/-- The lag an agreement proof certifies (`0` for a base one). -/
def agreeLagNat (p : Expr) : TermElabM Nat := do
  match ← agreeLagOf (← inferType p) with
  | some none => pure 0
  | some (some n) => pure n
  | _ => throwError "HydroGen: not an agreement proof:{indentExpr (← inferType p)}"

/-- Is wire-arg position `i` of knot `k` a Bekić parameter (a sibling
knot wire of its `fix` block; D95)? The parameters are the knot's
trailing explicit args. -/
def isKnotParamPos (gi : GenInfo) (nargs i : Nat) : Bool :=
  i + gi.knotParams ≥ nargs

/-- A lag vector / environment literal over a context literal `Γ`
(`HList f Γ`, `f` the lemma's own element function): `HList.cons` nests. -/
def hlistLit (L mem f : Expr) (Γ : Expr) (vals : Array Expr) : MetaM Expr := do
  let mut ks : Array Expr := #[]
  let mut cur := Γ
  while true do
    let cur' ← whnfR cur
    if cur'.isAppOfArity ``List.cons 3 then
      ks := ks.push cur'.getAppArgs[1]!
      cur := cur'.getAppArgs[2]!
    else break
  unless ks.size == vals.size do
    throwError "HydroGen: hlistLit: {ks.size} kinds vs {vals.size} values"
  let kindTy := mkApp2 (mkConst `Hydro.Project.Kind) L mem
  let mut acc := mkApp3 (mkConst `Hydro.Project.HList.nil [Level.zero]) L mem f
  for i in [0:ks.size] do
    let j := ks.size - 1 - i
    let restKs := (ks.extract (j + 1) ks.size).foldr
      (fun k a => mkApp3 (mkConst ``List.cons [Level.one]) kindTy k a)
      (mkApp (mkConst ``List.nil [Level.one]) kindTy)
    acc := mkAppN (mkConst `Hydro.Project.HList.cons [Level.zero]) #[L, mem, f, ks[j]!, restKs, vals[j]!, acc]
  pure acc

/-- **The composed machine-side strictness** (D95): a proof of
`agree h (leg (C … x …)) (leg (C … y …))` for the knot body leg
(`C` the hoisted chain module) from `hxy : agreeL h 1 x y` at the loop
position, caller-supplied agreements at the context wires (base at the
externals; base or lag `1` at the knot's Bekić parameters), inner knots
through their `K_strict₁` recursively. The chain's own fact is its
graph's lag analysis (`C.dag_agreeL`: `HAgreeL h lags env env' →
HAgreeL h (C.dag.lagOf lags) outs outs'`, `Graph/Causal.lean`),
instantiated at the lag vector (`1` at the loop and the parameters, `0`
elsewhere) by unifying its module application with the body's; the
output lag at the leg is `0` by evaluation (the body is strict in every
knot wire — the program's own acyclicity, checked by the kernel). Machine
decision and plain values are resolved by knot-arg index. -/
partial def composedStrict (kc : KnotCtx) (hE : Expr) (hxy : Expr)
    (wireValL wireValR : Nat → TermElabM Expr)
    (wireAgree : Nat → TermElabM Expr)
    (decVal : Nat → TermElabM Expr)
    (plainVal : Nat → TermElabM Expr) : TermElabM (Nat × Expr) := do
  let mc := kc.mc
  let comp := kc.comp
  -- the machine values of the body args, both sides, and their agreements
  let mut valsL : Array Expr := #[]
  let mut valsR : Array Expr := #[]
  let mut wires : Array (Expr × Expr × Expr × CarrierFam) := #[]
  for a in comp.args, k in comp.kinds do
    match k with
    | .wire cf =>
      let (l, r, pr) ← argSides a cf
      valsL := valsL.push l; valsR := valsR.push r
      wires := wires.push (l, r, pr, cf)
    | .primDec _ | .decRec _ =>
      let .expr e := a | throwError "HydroGen: strict: decision at loop position"
      let v ← decVal (← argIdxOf kc e)
      valsL := valsL.push v; valsR := valsR.push v
    | .plain =>
      let .expr e := a | throwError "HydroGen: strict: plain at loop position"
      let v ← plainVal (← argIdxOf kc e)
      valsL := valsL.push v; valsR := valsR.push v
  let appL := mkAppN (mkConst comp.bodyMod) (comp.preArgs ++ #[mc.sched] ++ valsL)
  let appR := mkAppN (mkConst comp.bodyMod) (comp.preArgs ++ #[mc.sched] ++ valsR)
  let legL ← applyLeg appL comp.legPath
  let legR ← applyLeg appR comp.legPath
  chainAgree comp.bodyMod comp.legIdx appL appR legL legR wires
where
  /-- Machine values and agreement proof of a wire body-arg. -/
  argSides (a : BArg) (cf : CarrierFam) : TermElabM (Expr × Expr × Expr) := do
    match a with
    | .gadget =>
      -- the loop wire: `hxy : agreeL h 1 x y`
      let ty ← whnfR (← inferType hxy)
      let args := ty.getAppArgs
      pure (args[args.size - 2]!, args[args.size - 1]!, hxy)
    | .expr e =>
      let i ← argIdxOf kc e
      pure (← wireValL i, ← wireValR i, ← wireAgree i)
    | .inner idx =>
      let ia := kc.comp.inners[idx]!
      let (l, r) ← innerApps ia
      let pr ← innerStrict ia
      let _ := cf
      pure (l, r, pr)
  /-- An inner knot's machine application, both sides. -/
  innerApps (ia : InnerApp) : TermElabM (Expr × Expr) := do
    let mut argsL := #[]
    let mut argsR := #[]
    for a in ia.args, k in ia.kinds do
      match a, k with
      | .gadget, _ =>
        let ty ← whnfR (← inferType hxy)
        let args := ty.getAppArgs
        argsL := argsL.push args[args.size - 2]!
        argsR := argsR.push args[args.size - 1]!
      | .expr e, .wire _ =>
        let i ← argIdxOf kc e
        argsL := argsL.push (← wireValL i); argsR := argsR.push (← wireValR i)
      | .expr e, .primDec _ | .expr e, .decRec _ =>
        let v ← decVal (← argIdxOf kc e)
        argsL := argsL.push v; argsR := argsR.push v
      | .expr e, .plain =>
        let v ← plainVal (← argIdxOf kc e)
        argsL := argsL.push v; argsR := argsR.push v
      | .inner j, _ =>
        let (l, r) ← innerApps kc.comp.inners[j]!
        argsL := argsL.push l; argsR := argsR.push r
    pure (mkAppN ia.app.getAppFn (ia.preArgs ++ #[kc.mc.sched] ++ argsL),
          mkAppN ia.app.getAppFn (ia.preArgs ++ #[kc.mc.sched] ++ argsR))
  /-- An inner knot's `K_strict₁` at the body's valuation: its parameters
  (the loop wire among them) at lag `1`, its externals at base. -/
  innerStrict (ia : InnerApp) : TermElabM Expr := do
    let some lem := ia.gi.strictLemma? |
      throwError "HydroGen: inner knot {ia.kName} has no strictness lemma"
    let nargs := ia.args.size
    let mut queue := #[]
    let mut hyps := #[]
    for a in ia.args, k in ia.kinds, pos in [0:nargs] do
      match k with
      | .wire cf =>
        let isParam := isKnotParamPos ia.gi nargs pos
        let pr ← match a with
          | .gadget => pure hxy
          | .expr e => wireAgree (← argIdxOf kc e)
          | .inner j => innerStrict kc.comp.inners[j]!
        hyps := hyps.push (← if isParam then agreeAtLag1 cf pr else agreeAtBase cf pr)
      | .primDec _ | .decRec _ =>
        let .expr e := a | throwError "HydroGen: strict: inner decision at loop position"
        queue := queue.push (← decVal (← argIdxOf kc e))
      | .plain =>
        let .expr e := a | throwError "HydroGen: strict: inner plain at loop position"
        queue := queue.push (← plainVal (← argIdxOf kc e))
    applyNamed lem kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT (queue ++ hyps) (pre := ia.preArgs)
  /-- The chain's graph lag analysis at the body's valuation, projected to
  the leg and read at lag `0`. -/
  chainAgree (C : Name) (legIdx : Nat) (appL appR legL legR : Expr)
      (wires : Array (Expr × Expr × Expr × CarrierFam)) : TermElabM (Nat × Expr) := do
    let lemName := C ++ `dag_agreeL
    unless (← getEnv).contains lemName do
      throwError "HydroGen: {C} has no graph lag analysis (`{lemName}`): the chain \
        module's project phase must run before its knots"
    let info ← getConstInfo lemName
    let us ← info.levelParams.mapM fun _ => mkFreshLevelMVar
    let lemTy := info.type.instantiateLevelParams info.levelParams us
    let (mvs, _, concl) ← forallMetaTelescopeReducing lemTy
    unless mvs.size ≥ 5 do throwError "HydroGen: {lemName}: unexpected binder count"
    let hM := mvs[mvs.size - 5]!
    let lagsM := mvs[mvs.size - 4]!
    let envM := mvs[mvs.size - 3]!
    let envM' := mvs[mvs.size - 2]!
    let heM := mvs[mvs.size - 1]!
    unless ← isDefEq hM hE do throwError "HydroGen: {lemName}: horizon binder"
    -- the context literal and the element functions, from the binders' types
    -- (`HList` is reducible: `whnfR` on a literal context would open it to a product —
    -- the binder is read as written, unfolded only if it is not an `HList` application)
    let envTy ← instantiateMVars (← inferType envM)
    let envTy ← if envTy.isAppOfArity `Hydro.Project.HList 4 then pure envTy else whnfR envTy
    unless envTy.isAppOfArity `Hydro.Project.HList 4 do
      throwError "HydroGen: {lemName}: environment binder is not an `HList`:{indentExpr envTy}"
    let L := envTy.getAppArgs[0]!; let memE := envTy.getAppArgs[1]!
    let fSched := envTy.getAppArgs[2]!; let Γ := envTy.getAppArgs[3]!
    let lagsTy ← instantiateMVars (← inferType lagsM)
    let lagsTy ← if lagsTy.isAppOfArity `Hydro.Project.HList 4 then pure lagsTy else whnfR lagsTy
    unless lagsTy.isAppOfArity `Hydro.Project.HList 4 do
      throwError "HydroGen: {lemName}: lag binder is not an `HList`:{indentExpr lagsTy}"
    let fNat := lagsTy.getAppArgs[2]!
    -- lag vector and environments (the module's wire binders, in order)
    let mut lagVals := #[]
    for (_, _, pr, _) in wires do
      lagVals := lagVals.push (mkNatLit (← agreeLagNat pr))
    let lagsLit ← hlistLit L memE fNat Γ lagVals
    let envLit ← hlistLit L memE fSched Γ (wires.map (·.1))
    let envLit' ← hlistLit L memE fSched Γ (wires.map (·.2.1))
    unless ← isDefEq lagsM lagsLit do throwError "HydroGen: {lemName}: lag vector"
    unless ← isDefEq envM envLit do throwError "HydroGen: {lemName}: environment"
    unless ← isDefEq envM' envLit' do throwError "HydroGen: {lemName}: environment'"
    -- the data binders, by unifying the lemma's module application with the body's
    let concl ← instantiateMVars concl
    let conclArgs := concl.getAppArgs
    unless concl.isAppOf `Hydro.Project.HAgreeL && conclArgs.size ≥ 4 do
      throwError "HydroGen: {lemName}: conclusion is not `HAgreeL`:{indentExpr concl}"
    let outsL := conclArgs[conclArgs.size - 2]!
    let outsR := conclArgs[conclArgs.size - 1]!
    let findApp := fun (e : Expr) => e.find? fun sub =>
      sub.isApp && sub.getAppFn.constName? == some C
    let some subL := findApp outsL |
      throwError "HydroGen: {lemName}: no application of {C} in its conclusion"
    let some subR := findApp outsR |
      throwError "HydroGen: {lemName}: no application of {C} in its conclusion"
    unless ← isDefEq subL appL do
      throwError "HydroGen: {lemName}: the graph lemma's module application does not \
        unify with the body's:{indentExpr subL}\n{indentExpr appL}"
    unless ← isDefEq subR appR do
      throwError "HydroGen: {lemName}: the graph lemma's module application does not \
        unify with the body's (right):{indentExpr subR}\n{indentExpr appR}"
    -- the input agreements, as the `HAgreeL` conjunction
    let heTy ← instantiateMVars (← inferType heM)
    let mut hePrf := Lean.mkConst ``True.intro
    for i in [0:wires.size] do
      let (_, _, pr, cf) := wires[wires.size - 1 - i]!
      -- a base proof is read at lag `0`
      let pr' ← match ← agreeLagOf (← inferType pr) with
        | some none => mkAppM (agreeLZeroOf cf ++ `mpr) #[pr]
        | _ => pure pr
      hePrf ← mkAppM ``And.intro #[pr', hePrf]
    let hePrf' ← mkExpectedTypeHint hePrf heTy
    unless ← isDefEq heM hePrf' do throwError "HydroGen: {lemName}: input agreements"
    let prf ← instantiateMVars (mkAppN (mkConst lemName us) mvs)
    -- the output lags, computed by the generator and proved one node at a time
    -- (`HydroGenLag`; never an evaluation of `Dag.lagOf` — 19 GB on `leader_election`):
    -- `HAgreeL h (Dag.lagOf d lags) X Y` becomes `HAgreeL h ⟨literals⟩ X Y`
    let prfTy ← instantiateMVars (← inferType prf)
    let pArgs := prfTy.getAppArgs
    unless prfTy.isAppOf `Hydro.Project.HAgreeL && pArgs.size ≥ 4 do
      throwError "HydroGen: {lemName}: conclusion is not `HAgreeL`:{indentExpr prfTy}"
    let lagOfE := pArgs[pArgs.size - 3]!
    unless lagOfE.isAppOf `Hydro.Project.Dag.lagOf do
      throwError "HydroGen: {lemName}: the output lags are not a `Dag.lagOf`:{indentExpr lagOfE}"
    let dagE := lagOfE.getAppArgs[lagOfE.getAppNumArgs - 2]!
    let inLags ← wires.mapM fun (_, _, pr, _) => agreeLagNat pr
    let (outLags, hlag) ← withDeclDiag "chainAgree/dagLag" <| proveDagLag dagE inLags
    if (← IO.getEnv "HYDROGEN_LAG_DIAG").isSome then
      IO.eprintln s!"[lag] {kc.mc.mName}: chain {C} at {inLags} → {outLags}"
    let motive ← withLocalDeclD `z (← inferType lagOfE) fun zE => do
      mkLambdaFVars #[zE] (mkAppN prfTy.getAppFn (pArgs.set! (pArgs.size - 3) zE))
    let prf ← mkEqMP (← mkCongrArg motive hlag) prf
    -- project the leg: `HAgreeL` on literals is a right-nested conjunction
    let mut q := prf
    for _ in [0:legIdx] do
      q := mkProj ``And 1 q
    q := mkProj ``And 0 q
    -- read at the computed lag (the literal is what the kernel sees)
    let cf ← match kc.mc.legTys[0]!.getAppFn with
      | .const n _ =>
        match carrierFamOfHead n with
        | some cf => pure cf
        | none => throwError "HydroGen: knot leg is not a carrier"
      | _ => throwError "HydroGen: knot leg head"
    unless legIdx < outLags.size do
      throwError "HydroGen: knot {kc.mc.mName}: leg {legIdx} beyond the chain's {outLags.size} outputs"
    let outLag := outLags[legIdx]!
    let target ← mkAppM (agreeLRelOf cf) #[hE, mkNatLit outLag, legL, legR]
    let qTy ← instantiateMVars (← inferType q)
    let target ← instantiateMVars target
    let ok ← if qTy.hasMVar || target.hasMVar then isDefEq qTy target
      else pure (Kernel.isDefEqGuarded (← getEnv) (← getLCtx) qTy target)
    unless ok do
      throwError "HydroGen: knot {kc.mc.mName}: the chain's lag law does not read as the \
        computed lag {outLag}:{indentExpr qTy}\nexpected{indentExpr target}"
    pure (outLag, ← mkExpectedTypeHint q target)

/-- A graded agreement proof at lag `μ` read at lag `n ≥ μ`
(`mono_lag`), or as is. -/
def agreeAtLag (cf : CarrierFam) (p : Expr) (μ n : Nat) : TermElabM Expr := do
  if μ == n then pure p
  else if μ < n then
    mkAppM (agreeLMonoLagOf cf) #[← mkDecideProof (← mkAppM ``LE.le #[mkNatLit μ, mkNatLit n]), p]
  else throwError "HydroGen: a lag-{μ} agreement cannot be read at lag {n}"

/-- A graded proof at lag `0` read as the base agreement. -/
def agreeBaseOf (cf : CarrierFam) (p : Expr) (μ : Nat) (what : String) : TermElabM Expr := do
  unless μ == 0 do
    throwError "HydroGen: {what}: the body's output lag is {μ}, not `0` — the body is not \
      strict in the knot wire (a cycle without a network hop or `defer_tick`)"
  mkAppM (agreeLZeroOf cf ++ `mp) #[p]

/-- The machine knot's body function, in the generator's own spelling:
`fun x => leg (C … x …)` over the loop's machine carrier (the same term
`composedStrict` states its facts about). The knot application `K sched
args` unfolds to `fix_stream df (fun s => K.body … s)`, whose body is
this function up to the hoisted constant's projections of its caps tuple
— a judgement left to the KERNEL (`addThm`'s check), never to `Meta`:
the knot facts are direct terms, not scripts (D95; a `simp only [K];
rw [sched_hfix_stream']; exact FCK …` script took 19 GB on
`leader_election` once its facts named the chain module). -/
partial def machineBodyFn (kc : KnotCtx) (side : Nat → TermElabM Expr) (decVal plainVal : Nat → TermElabM Expr) :
    TermElabM Expr := do
  let mc := kc.mc
  let comp := kc.comp
  let machLoopTy := reinterp mc.corner mc.sched kc.loopTy
  withLocalDecl `x .default machLoopTy fun xE => do
  let rec valOf (a : BArg) (k : ArgKind) : TermElabM Expr := do
    match a with
    | .gadget => pure xE
    | .expr e =>
      match k with
      | .wire _ => side (← argIdxOf kc e)
      | .primDec _ | .decRec _ => decVal (← argIdxOf kc e)
      | .plain => plainVal (← argIdxOf kc e)
    | .inner idx =>
      let ia := kc.comp.inners[idx]!
      let mut args := #[]
      for a' in ia.args, k' in ia.kinds do
        args := args.push (← valOf a' k')
      pure (mkAppN ia.app.getAppFn (ia.preArgs ++ #[mc.sched] ++ args))
  let mut vals := #[]
  for a in comp.args, k in comp.kinds do
    vals := vals.push (← valOf a k)
  let app := mkAppN (mkConst comp.bodyMod) (comp.preArgs ++ #[mc.sched] ++ vals)
  mkLambdaFVars #[xE] (← applyLeg app comp.legPath)

/-- The composed machine-side tick-monotonicity (D71): the body leg's
`_smono` lemma with `hx` at the loop position, caller-supplied
monotonicity facts at context wires (`TMono`/`TMonoTriv` by family),
inner knots' `K_smono₁` recursively. -/
partial def composedSMono (kc : KnotCtx) (hx : Expr)
    (wireMono : Nat → TermElabM Expr)
    (decVal : Nat → TermElabM Expr)
    (plainVal : Nat → TermElabM Expr) : TermElabM Expr := do
  let bodySMonos := kc.comp.gi.smonoLemmas
  unless kc.comp.legIdx < bodySMonos.size do
    throwError "HydroGen: {kc.comp.bodyMod} has no tick-monotonicity for leg \
      {kc.comp.legIdx}"
  go kc.comp.bodyMod bodySMonos[kc.comp.legIdx]! kc.comp.preArgs
    kc.comp.args kc.comp.kinds
where
  go (owner : Name) (lem : Name) (pre : Array Expr) (args : Array BArg)
      (kinds : Array ArgKind) : TermElabM Expr := do
    let mut queue := #[]
    for a in args, k in kinds do
      match k with
      | .wire _ => pure ()
      | .primDec _ | .decRec _ =>
        let e ← match a with
          | .expr e => decVal (← argIdxOf kc e)
          | _ => throwError "HydroGen: smono: decision at loop position"
        queue := queue.push e
      | .plain =>
        match a with
        | .expr e => queue := queue.push (← plainVal (← argIdxOf kc e))
        | _ => throwError "HydroGen: smono: plain at loop position"
    let mut hyps := #[]
    for a in args, k in kinds do
      if let .wire _ := k then
        match a with
        | .gadget => hyps := hyps.push hx
        | .expr e => hyps := hyps.push (← wireMono (← argIdxOf kc e))
        | .inner idx =>
          let ia := kc.comp.inners[idx]!
          unless ia.gi.smonoLemmas.size ≥ 1 do
            throwError "HydroGen: inner knot {ia.kName} has no tick-monotonicity"
          hyps := hyps.push (← go ia.kName ia.gi.smonoLemmas[0]!
            ia.preArgs ia.args ia.kinds)
    applyNamed lem kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT
      (queue ++ hyps) (pre := pre)

/-- `K_smono₁`: tick-monotonicity of the machine knot (a tick knot's
diagonal, `tmono_fix_tick`, from the body's strictness and
monotonicity; a stream knot's is the `TMonoTriv` placeholder). -/
def genKnotSMono (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let mut decls : Array (Nat × Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    let ty := reinterp mc.corner mc.sched (← inferType mc.args[i]!)
    let nm ← mc.args[i]!.fvarId!.getUserName
    match mc.kinds[i]! with
    | .wire _ => decls := decls.push (i, nm, .implicit, ty)
    | .plain => pure ()
    | _ => decls := decls.push (i, nm, .default, ty)
  withLocalDecls (decls.map fun (_, n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun xs => do
  let mut valOf : Std.HashMap Nat Expr := {}
  let mut j := 0
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .plain => valOf := valOf.insert i mc.args[i]!
    | _ =>
      valOf := valOf.insert i xs[j]!
      j := j + 1
  let argBinders := (Array.range mc.args.size).map fun i => (valOf.get? i).get!
  let mut hypDecls : Array (Nat × Name × Expr) := #[]
  for i in [0:mc.args.size] do
    if let .wire cf := mc.kinds[i]! then
      let rel ← mkAppM (smonoRelOf cf) #[(valOf.get? i).get!]
      hypDecls := hypDecls.push (i, Name.mkSimple s!"hm{i}", rel)
  withLocalDecls (hypDecls.map fun (_, n, ty) =>
      (n, .default, fun _ => pure ty)) fun hyps => do
  let hmOf : Std.HashMap Nat Expr := Id.run do
    let mut m := {}
    for d in hypDecls, hp in hyps do
      m := m.insert d.1 hp
    pure m
  let app := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.sched] ++ argBinders)
  let cf ← match mc.legTys[0]!.getAppFn with
    | .const n _ =>
      match carrierFamOfHead n with
      | some cf => pure cf
      | none => throwError "HydroGen: knot leg is not a carrier"
    | _ => throwError "HydroGen: knot leg head"
  let concl ← mkAppM (smonoRelOf cf) #[app]
  let binders := mc.ctxArgs ++ #[mc.pacing] ++ argBinders ++ hyps
  let name := mc.mName.appendAfter "_smono₁"
  let stmt ← mkForallFVars binders concl
  if !kc.gad.isTick then
    let val ← mkLambdaFVars binders (← mkAppM ``TMonoTriv.intro #[app])
    addThm name stmt val
    return name
  let machLoopTy := reinterp mc.corner mc.sched kc.loopTy
  -- the body's strictness, at every horizon (context wires reflexive; D95)
  let fFCK ← withLocalDecl `h' .default (mkConst ``Nat) fun h'E => do
    withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `y .default machLoopTy fun yE => do
    withLocalDecl `hxy .default
        (← mkAppM kc.gad.agreeL #[h'E, mkNatLit 1, xE, yE]) fun hxyE => do
    let (μ, prf) ← composedStrict kc h'E hxyE
      (fun i => pure (valOf.get? i).get!) (fun i => pure (valOf.get? i).get!)
      (fun i => do
        let cfI ← match mc.kinds[i]! with
          | .wire c => pure c
          | _ => throwError "HydroGen: not a wire"
        mkAppM (agreeRelOf cfI ++ `refl) #[h'E, (valOf.get? i).get!])
      (fun i => pure (valOf.get? i).get!)
      (fun i => pure mc.args[i]!)
    let prf ← agreeBaseOf cf prf μ s!"knot {mc.mName} (tick monotonicity)"
    mkLambdaFVars #[h'E, xE, yE, hxyE] prf
  -- the body's monotonicity, from the context wires' hypotheses
  let fFSM ← withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `hx .default (← mkAppM ``TMono #[xE]) fun hxE => do
    let prf ← composedSMono kc hxE
      (fun i => pure (hmOf.get? i).get!)
      (fun i => pure (valOf.get? i).get!)
      (fun i => pure mc.args[i]!)
    mkLambdaFVars #[xE, hxE] prf
  -- a direct term over the body function (`machineBodyFn`; D95): the
  -- diagonal's monotonicity from the body's strictness and monotonicity
  let bodyL ← machineBodyFn kc (fun i => pure (valOf.get? i).get!)
    (fun i => pure (valOf.get? i).get!) (fun i => pure mc.args[i]!)
  let hstrict ← mkExpectedTypeHint fFCK (← mkAppM kc.gad.strictPred #[bodyL])
  let hmono ← withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `hx .default (← mkAppM ``TMono #[xE]) fun hxE => do
    let core := mkAppN fFSM #[xE, hxE]
    let core ← mkExpectedTypeHint core (← mkAppM ``TMono #[(bodyL.beta #[xE]).headBeta])
    mkLambdaFVars #[xE, hxE] core
  let prf ← applyByName ``tmono_fix_tick
    #[(`d, Lean.mkConst ``Unit.unit), (`body, bodyL), (`hstrict, hstrict), (`hmono, hmono)]
  let prfClosed ← mkExpectedTypeHint prf concl
  let val ← mkLambdaFVars binders prfClosed
  addThm name stmt val
  pure name

/-- The machine-side telescope of a knot's causality/strictness lemma:
`h` implicit, wire args doubled (implicit), decisions explicit, plain
args shared, one agreement hypothesis per wire (graded at lag `1` for
the Bekić parameters when `strict`). Returns the binders, the
hypotheses (by arg index), the two sides, and the conclusion. -/
def knotAgreeTele {α : Type} [Inhabited α] (kc : KnotCtx) (strict : Bool)
    (k : Expr → Array Expr → Std.HashMap Nat Expr → Std.HashMap Nat Expr →
      Std.HashMap Nat Expr → Array Expr → Expr → TermElabM α) : TermElabM α := do
  let mc := kc.mc
  withLocalDecl `h .implicit (mkConst ``Nat) fun hvar => do
  let mut decls : Array (Nat × Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    let ty := reinterp mc.corner mc.sched (← inferType mc.args[i]!)
    let nm ← mc.args[i]!.fvarId!.getUserName
    match mc.kinds[i]! with
    | .wire _ =>
      decls := decls.push (i, nm, .implicit, ty)
      decls := decls.push (i, nm.appendAfter "'", .implicit, ty)
    | .plain => pure ()
    | _ => decls := decls.push (i, nm, .default, ty)
  withLocalDecls (decls.map fun (_, n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun xs => do
  let mut fstOf : Std.HashMap Nat Expr := {}
  let mut sndOf : Std.HashMap Nat Expr := {}
  let mut j := 0
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j+1]!
      j := j + 2
    | .plain =>
      fstOf := fstOf.insert i mc.args[i]!
      sndOf := sndOf.insert i mc.args[i]!
    | _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j]!
      j := j + 1
  let mut argBinders : Array Expr := #[]
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      argBinders := argBinders.push (fstOf.get? i).get!
      argBinders := argBinders.push (sndOf.get? i).get!
    | .plain => argBinders := argBinders.push mc.args[i]!
    | _ => argBinders := argBinders.push (fstOf.get? i).get!
  let gi := (getGenInfo (← getEnv) mc.mName).getD {}
  let mut hypDecls : Array (Nat × Name × Expr) := #[]
  for i in [0:mc.args.size] do
    if let .wire cf := mc.kinds[i]! then
      let rel ← if strict && isKnotParamPos gi mc.args.size i then
          mkAppM (agreeLRelOf cf) #[hvar, mkNatLit 1, (fstOf.get? i).get!, (sndOf.get? i).get!]
        else
          mkAppM (agreeRelOf cf) #[hvar, (fstOf.get? i).get!, (sndOf.get? i).get!]
      hypDecls := hypDecls.push (i, Name.mkSimple s!"ha{i}", rel)
  withLocalDecls (hypDecls.map fun (_, n, ty) =>
      (n, .default, fun _ => pure ty)) fun hyps => do
  let haOf : Std.HashMap Nat Expr := Id.run do
    let mut m := {}
    for d in hypDecls, hp in hyps do
      m := m.insert d.1 hp
    pure m
  let sideArgs := fun (side : Std.HashMap Nat Expr) => do
    let mut out := #[]
    for i in [0:mc.args.size] do
      out := out.push ((side.get? i).get!)
    pure out
  let lhsApp := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.sched] ++ (← sideArgs fstOf))
  let rhsApp := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.sched] ++ (← sideArgs sndOf))
  let cf ← match mc.legTys[0]!.getAppFn with
    | .const n _ =>
      match carrierFamOfHead n with
      | some cf => pure cf
      | none => throwError "HydroGen: knot leg is not a carrier"
    | _ => throwError "HydroGen: knot leg head"
  let concl ← mkAppM (agreeRelOf cf) #[hvar, lhsApp, rhsApp]
  let binders := mc.ctxArgs ++ #[mc.pacing, hvar] ++ argBinders ++ hyps
  k hvar binders fstOf sndOf haOf hyps concl

/-- `K_strict₁` (D95): the machine knot is strict in its Bekić
parameters (agreement at lag `1`) and causal in its externals. By
`causalL_fix_stream`/`_tick` at lag `0`: the body's strictness on each
side (`SStrict`, from the composed strictness with the context wires
reflexive — the stream knot's freeze transparency) and the graded body
relation across the sides (the composed strictness under the
hypotheses, lowered to each horizon `h' ≤ h`). A direct term over the
body functions (`machineBodyFn`); the knot application's unfolding is
the kernel's. -/
def genKnotStrict (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let machLoopTy := reinterp mc.corner mc.sched kc.loopTy
  let cf ← match mc.legTys[0]!.getAppFn with
    | .const n _ =>
      match carrierFamOfHead n with
      | some cf => pure cf
      | none => throwError "HydroGen: knot leg is not a carrier"
    | _ => throwError "HydroGen: knot leg head"
  let cfOf := fun (i : Nat) => do
    match mc.kinds[i]! with
    | .wire c => pure c
    | _ => throwError "HydroGen: not a wire"
  -- the knot's output lag λ (D95): the chain's at loop `1`, the Bekić
  -- parameters at `1`, the externals at `0` (a probe run of the composed
  -- strictness, its proof discarded)
  let lamK ← knotAgreeTele kc true fun hvar _binders fstOf sndOf haOf _hyps _concl => do
    withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `y .default machLoopTy fun yE => do
    withLocalDecl `hxy .default (← mkAppM kc.gad.agreeL #[hvar, mkNatLit 1, xE, yE]) fun hxyE => do
    let (μ, _) ← composedStrict kc hvar hxyE
      (fun i => pure (fstOf.get? i).get!) (fun i => pure (sndOf.get? i).get!)
      (fun i => pure (haOf.get? i).get!)
      (fun i => pure (fstOf.get? i).get!)
      (fun i => pure mc.args[i]!)
    pure μ
  knotAgreeTele kc true fun hvar binders fstOf sndOf haOf _hyps _concl => do
  -- the statement: the parameters at lag `1`, the externals at base, the
  -- knot at lag λ
  let sideArgs := fun (side : Std.HashMap Nat Expr) => do
    let mut out := #[]
    for i in [0:mc.args.size] do
      out := out.push ((side.get? i).get!)
    pure out
  let lhsApp := mkAppN (mkConst mc.mName) (mc.ctxArgs ++ #[mc.sched] ++ (← sideArgs fstOf))
  let rhsApp := mkAppN (mkConst mc.mName) (mc.ctxArgs ++ #[mc.sched] ++ (← sideArgs sndOf))
  let concl ← mkAppM (agreeLRelOf cf) #[hvar, mkNatLit lamK, lhsApp, rhsApp]
  -- one side's body strictness (context wires reflexive): lag `0` out
  let sideStrict := fun (side : Std.HashMap Nat Expr) => do
    withLocalDecl `h' .default (mkConst ``Nat) fun h'E => do
    withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `y .default machLoopTy fun yE => do
    withLocalDecl `hxy .default
        (← mkAppM kc.gad.agreeL #[h'E, mkNatLit 1, xE, yE]) fun hxyE => do
    let (μ, prf) ← composedStrict kc h'E hxyE
      (fun i => pure (side.get? i).get!) (fun i => pure (side.get? i).get!)
      (fun i => do mkAppM (agreeRelOf (← cfOf i) ++ `refl) #[h'E, (side.get? i).get!])
      (fun i => pure (side.get? i).get!)
      (fun i => pure mc.args[i]!)
    let prf ← agreeBaseOf cf prf μ s!"knot {mc.mName}"
    mkLambdaFVars #[h'E, xE, yE, hxyE] prf
  -- the graded body relation across the sides, at every `h' ≤ h`: loop at
  -- `λ + 1`, out at `λ`
  let fFCKB ← withLocalDecl `h' .default (mkConst ``Nat) fun h'E => do
    withLocalDecl `hh' .default (← mkAppM ``LE.le #[h'E, hvar]) fun hh'E => do
    withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `y .default machLoopTy fun yE => do
    withLocalDecl `hxy .default
        (← mkAppM kc.gad.agreeL #[h'E, mkNatLit (lamK + 1), xE, yE]) fun hxyE => do
    let (μ, prf) ← composedStrict kc h'E hxyE
      (fun i => pure (fstOf.get? i).get!) (fun i => pure (sndOf.get? i).get!)
      (fun i => do
        let cfI ← cfOf i
        let ha := (haOf.get? i).get!
        match ← agreeLagOf (← inferType ha) with
        | some none => mkAppM (agreeRelOf cfI ++ `mono) #[hh'E, ha]
        | _ => mkAppM (agreeLRelOf cfI ++ `mono) #[hh'E, ha])
      (fun i => pure (fstOf.get? i).get!)
      (fun i => pure mc.args[i]!)
    let prf ← agreeAtLag cf prf μ lamK
    mkLambdaFVars #[h'E, hh'E, xE, yE, hxyE] prf
  let bodyL ← machineBodyFn kc (fun i => pure (fstOf.get? i).get!)
    (fun i => pure (fstOf.get? i).get!) (fun i => pure mc.args[i]!)
  let bodyR ← machineBodyFn kc (fun i => pure (sndOf.get? i).get!)
    (fun i => pure (sndOf.get? i).get!) (fun i => pure mc.args[i]!)
  let hb ← withLocalDecl `h' .default (mkConst ``Nat) fun h'E => do
    withLocalDecl `hh' .default (← mkAppM ``LE.le #[h'E, hvar]) fun hh'E => do
    withLocalDecl `x .default machLoopTy fun xE => do
    withLocalDecl `y .default machLoopTy fun yE => do
    withLocalDecl `hxy .default
        (← mkAppM kc.gad.agreeL #[h'E, mkNatLit (lamK + 1), xE, yE]) fun hxyE => do
    let core := mkAppN fFCKB #[h'E, hh'E, xE, yE, hxyE]
    let core ← mkExpectedTypeHint core
      (← mkAppM kc.gad.agreeL #[h'E, mkNatLit lamK, (bodyL.beta #[xE]).headBeta, (bodyR.beta #[yE]).headBeta])
    mkLambdaFVars #[h'E, hh'E, xE, yE, hxyE] core
  let prf ←
    if kc.gad.isTick then
      applyByName kc.gad.fixCausalL
        #[(`h, hvar), (`Lg, mkNatLit lamK), (`d, Lean.mkConst ``Unit.unit),
          (`body, bodyL), (`body', bodyR), (`hb, hb)]
    else
      let fFCKL ← sideStrict fstOf
      let fFCKR ← sideStrict sndOf
      let hsL ← mkExpectedTypeHint fFCKL (← mkAppM kc.gad.strictPred #[bodyL])
      let hsR ← mkExpectedTypeHint fFCKR (← mkAppM kc.gad.strictPred #[bodyR])
      applyByName kc.gad.fixCausalL
        #[(`h, hvar), (`Lg, mkNatLit lamK), (`d, Lean.mkConst ``Unit.unit),
          (`body, bodyL), (`body', bodyR), (`hs, hsL), (`hs', hsR), (`hb, hb)]
  -- the knot application IS `fix_stream df (fun s => K.body … s)` with this
  -- body (the kernel's judgement; `Unit`-like decisions are all equal)
  let prfClosed ← mkExpectedTypeHint prf concl
  let name := mc.mName.appendAfter "_strict₁"
  let stmt ← mkForallFVars binders concl
  let val ← mkLambdaFVars binders prfClosed
  addThm name stmt val
  registerInfoT mc.mName fun gi => { gi with knotOutLag := lamK }
  pure name

/-! ## Knot `Values` monotonicity (`iterate_mono_param` composition) -/

/-! `Values` member-indexed carriers are `MemberMap n C` (D73): the
helpers below read the index/cell types off the carrier, build a read
`m i`, a constructor `MemberMap.mk' (fun i => …)`, and the pointwise
consequence of a carrier equality — the generator's former
`bindingDomain!`/`bindingBody!`/`mkApp`/`congrFun` on function carriers. -/

/-- `(n, C)` of a `Values` carrier type (whnf'd to `MemberMap n C`). -/
def memberMapParts (ty : Expr) : MetaM (Expr × Expr) := do
  let some mm ← whnfUntil ty ``MemberMap |
    throwError "HydroGen: not a MemberMap carrier:{indentExpr ty}"
  pure (mm.getArg! 0, mm.getArg! 1)

/-- The index type `Fin n` of a `Values` carrier. -/
def memberIdxTy (ty : Expr) : MetaM Expr := do
  let (n, _) ← memberMapParts ty
  pure (mkApp (mkConst ``Fin) n)

/-- The cell type `C` of a `Values` carrier. -/
def memberCellTy (ty : Expr) : MetaM Expr := do
  let (_, C) ← memberMapParts ty
  pure C

/-- A member read `m i` (`MemberMap.get m i`). -/
def mmRead (m i : Expr) : MetaM Expr := mkAppM ``MemberMap.get #[m, i]

/-- `MemberMap.mk' (fun i => body)` over the carrier's index type. -/
def mmMk (ty : Expr) (body : Expr → MetaM Expr) : MetaM Expr := do
  let iTy ← memberIdxTy ty
  withLocalDecl `i .default iTy fun iE => do
    let f ← mkLambdaFVars #[iE] (← body iE)
    mkAppM ``MemberMap.mk' #[f]

/-- Reflexivity of the `Values`-side order at a wire value. -/
def valuesRelRefl (cf : CarrierFam) (ty : Expr) (w : Expr) :
    TermElabM Expr := do
  withLocalDecl `i .default (← memberIdxTy (← inferType w))
      fun iE => do
    let wi ← mmRead w iE
    let prf ← match cf with
      | .stream => do
        let some tyW ← whnfUntil (← inferType wi) ``PoolCarrier |
          throwError "HydroGen: wire carrier is not a pool"
        let n := tyW.getAppNumArgs
        mkAppM ``PoolLe.refl
          #[tyW.getArg! (n - 2), tyW.getArg! (n - 1), wi]
      | .atomic => do
        mkAppM ``List.prefix_refl #[wi]
      | .sing => do
        -- read-prefix refl under the cut binder (`SingRel`'s shape)
        let bound ← whnfR (ty.getArg! (ty.getAppNumArgs - 1))
        let read ← if bound.isAppOf ``SingBound.monotonic then
            mkProjection wi `val
          else pure wi
        let dTy := (← whnf (← inferType read)).bindingDomain!
        withLocalDecl `d .default dTy fun dE => do
          mkLambdaFVars #[dE]
            (← mkAppM ``List.prefix_refl #[mkApp read dE])
      | .keyed =>
        -- per-key growth (`valuesRelOf`'s `KeyedPool.Le`; D81: a keyed
        -- stream argument of a knot module — `paxos_protocol`'s `input`)
        mkAppM ``KeyedPool.Le.refl #[wi]
      | .ksing => do
        -- read-prefix at every increment cut
        let dTy := (← whnf (← inferType wi)).bindingDomain!
        withLocalDecl `d .default dTy fun dE => do
          mkLambdaFVars #[dE] (← mkAppM ``List.prefix_refl #[mkApp wi dE])
      | _ => mkAppM ``List.prefix_refl #[wi]
    mkLambdaFVars #[iE] prf

/-- The composed `Values` monotonicity step: the body leg's mono lemma
with `hab` at the loop, caller-supplied order hypotheses at context
wires, decisions by `decVal`, inner knots' `K_mono₁` recursively. -/
partial def composedMono (kc : KnotCtx) (hab : Expr)
    (wireHyp : Nat → TermElabM Expr)
    (decVal : Nat → TermElabM Expr)
    (plainVal : Nat → TermElabM Expr) : TermElabM Expr := do
  let bodyMonos := kc.comp.gi.monoLemmas
  unless kc.comp.legIdx < bodyMonos.size do
    throwError "HydroGen: {kc.comp.bodyMod} has no monotonicity for \
      leg {kc.comp.legIdx}"
  go kc.comp.bodyMod bodyMonos[kc.comp.legIdx]! kc.comp.preArgs
    kc.comp.args kc.comp.kinds
where
  go (owner : Name) (lem : Name) (pre : Array Expr) (args : Array BArg)
      (kinds : Array ArgKind) : TermElabM Expr := do
    let mut queue := #[]
    for a in args, k in kinds do
      match k with
      | .wire _ => pure ()
      | .primDec _ | .decRec _ =>
        let e ← match a with
          | .expr e => decVal (← argIdxOf kc e)
          | _ => throwError "HydroGen: mono: decision at loop position"
        queue := queue.push e
      | .plain =>
        match a with
        | .expr e => queue := queue.push (← plainVal (← argIdxOf kc e))
        | _ => throwError "HydroGen: mono: plain at loop position"
    let mut hyps := #[]
    for a in args, k in kinds do
      if let .wire _ := k then
        match a with
        | .gadget => hyps := hyps.push hab
        | .expr e => hyps := hyps.push (← wireHyp (← argIdxOf kc e))
        | .inner idx =>
          let ia := kc.comp.inners[idx]!
          unless ia.gi.monoLemmas.size ≥ 1 do
            throwError "HydroGen: inner knot {ia.kName} has no \
              monotonicity"
          hyps := hyps.push (← go ia.kName ia.gi.monoLemmas[0]!
            ia.preArgs ia.args ia.kinds)
    applyNamed lem kc.mc.pacing kc.mc.Tc kc.mc.Td kc.mc.hjT
      (queue ++ hyps) (pre := pre)

/-- The fuel of the knot's `Values` fix, under a decision-argument
valuation (the `df` expr's projection path applied at the values-side
decision). -/
def knotFuelAt (kc : KnotCtx) (decVal : Nat → TermElabM Expr) :
    TermElabM Expr := do
  let (op, path) ← peelOuterProj kc.df []
  let i ← argIdxOf kc op
  applyLeg (← decVal i) path

/-- `K_mono₁`: `Values` monotonicity of the denotational knot at a
generic decision. -/
def genKnotMono (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let mut decls : Array (Nat × Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
    let nm ← mc.args[i]!.fvarId!.getUserName
    match mc.kinds[i]! with
    | .wire _ =>
      decls := decls.push (i, nm, .implicit, ty)
      decls := decls.push (i, nm.appendAfter "'", .implicit, ty)
    | .plain => pure ()
    | _ => decls := decls.push (i, nm, .default, ty)
  withLocalDecls (decls.map fun (_, n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun xs => do
  let mut fstOf : Std.HashMap Nat Expr := {}
  let mut sndOf : Std.HashMap Nat Expr := {}
  let mut j := 0
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j+1]!
      j := j + 2
    | .plain =>
      fstOf := fstOf.insert i mc.args[i]!
      sndOf := sndOf.insert i mc.args[i]!
    | _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j]!
      j := j + 1
  let mut argBinders : Array Expr := #[]
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      argBinders := argBinders.push (fstOf.get? i).get!
      argBinders := argBinders.push (sndOf.get? i).get!
    | .plain => argBinders := argBinders.push mc.args[i]!
    | _ => argBinders := argBinders.push (fstOf.get? i).get!
  let mut hypDecls : Array (Nat × Name × Expr) := #[]
  for i in [0:mc.args.size] do
    if let .wire cf := mc.kinds[i]! then
      let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
      let rel ← valuesRelOf cf ty (fstOf.get? i).get! (sndOf.get? i).get!
      hypDecls := hypDecls.push (i, Name.mkSimple s!"hm{i}", rel)
  withLocalDecls (hypDecls.map fun (_, n, ty) =>
      (n, .default, fun _ => pure ty)) fun hyps => do
  let hmOf : Std.HashMap Nat Expr := Id.run do
    let mut m := {}
    for d in hypDecls, hp in hyps do
      m := m.insert d.1 hp
    pure m
  let sideArgs := fun (side : Std.HashMap Nat Expr) => do
    let mut out := #[]
    for i in [0:mc.args.size] do
      out := out.push ((side.get? i).get!)
    pure out
  let lhsApp := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.values] ++ (← sideArgs fstOf))
  let rhsApp := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.values] ++ (← sideArgs sndOf))
  let cf ← match mc.legTys[0]!.getAppFn with
    | .const n _ => pure (carrierFamOfHead n).get!
    | _ => throwError "HydroGen: knot leg head"
  let legTyV := reinterp mc.corner mc.values mc.legTys[0]!
  let concl ← valuesRelOf cf legTyV lhsApp rhsApp
  -- the loop's Values carrier and pointwise relation
  let domV := reinterp mc.corner mc.values kc.loopTy
  let iTy ← memberIdxTy domV
  let mkRel ← withLocalDecl `a .default domV fun aE => do
    withLocalDecl `b .default domV fun bE => do
    let rel ← valuesRelOf cf domV aE bE
    mkLambdaFVars #[aE, bE] rel
  -- F / F' : the Values body at the two sides
  let valuesBodyAt := fun (side : Std.HashMap Nat Expr) (w : Expr) => do
    let bv : BVal :=
      { interp := mc.values, gadget := w,
        wire := fun e => do pure (side.get? (← argIdxOf kc e)).get!,
        prim := fun _ e => do pure (side.get? (← argIdxOf kc e)).get!,
        recd := fun e => do pure (side.get? (← argIdxOf kc e)).get! }
    let args ← bodyArgsVal kc bv
    let app := mkAppN (mkConst kc.comp.bodyMod)
      (kc.comp.preArgs ++ #[mc.values] ++ args)
    applyLeg app kc.comp.legPath
  let fF ← withLocalDecl `w .default domV fun wE => do
    mkLambdaFVars #[wE] (← valuesBodyAt fstOf wE)
  let fF' ← withLocalDecl `w .default domV fun wE => do
    mkLambdaFVars #[wE] (← valuesBodyAt sndOf wE)
  -- the step
  let hFF' ← withLocalDecl `a .implicit domV fun aE => do
    withLocalDecl `b .implicit domV fun bE => do
    withLocalDecl `hab .default ((mkRel.beta #[aE, bE]).headBeta)
        fun habE => do
    let prf ← composedMono kc habE
      (fun i => pure (hmOf.get? i).get!)
      (fun i => pure (fstOf.get? i).get!)
      (fun i => pure mc.args[i]!)
    mkLambdaFVars #[aE, bE, habE] prf
  let seed ← match cf with
    | .stream => do
      let some tyP ← whnfUntil (← memberCellTy domV) ``PoolCarrier |
        throwError "HydroGen: loop carrier is not a pool"
      let n := tyP.getAppNumArgs
      mmMk domV fun _ => mkAppOptM ``PoolBot
        #[some (tyP.getArg! 0), none, some (tyP.getArg! (n - 2)),
          some (tyP.getArg! (n - 1))]
    | _ => do
      let tr ← whnf (← memberCellTy domV)
      mmMk domV fun _ => mkAppOptM ``List.nil #[some (tr.getArg! 0)]
  let hx ← valuesRelRefl cf domV seed
  let fuel ← knotFuelAt kc (fun i => pure (fstOf.get? i).get!)
  let its ← mkAppOptM ``iterate_mono_param
    #[none, some mkRel, some fF, some fF', some hFF', some seed,
      some seed, some hx, some fuel]
  let prf ← mkExpectedTypeHint its concl
  let binders := mc.ctxArgs ++ argBinders ++ hyps
  let name := mc.mName.appendAfter "_mono₁"
  let stmt ← mkForallFVars binders concl
  let val ← mkLambdaFVars binders prf
  addThm name stmt val
  pure name

/-! ## Knot stages (the Kleene-chain vocabulary at the knot)

Any-body truths about a `fix` wire, generated once per knot so that
consumer proofs (K4-style knot inductions) never hand-spell the
iterate scaffolding:
- `K.stages`      — the `Values` Kleene iterates of the knot body,
  parameterized exactly like the knot constant (context wires fixed);
- `K.stages_zero` — stage 0 is the seed (`rfl`);
- `K.stages_succ` — one knot step, at the registered body-module
  boundary (`rfl`);
- `K.stages_fix`  — the knot at `Values` IS its stage at the fuel
  (`rfl`; the `hydro def` consumer's bridge);
- `K.stages_mono` — the Kleene chain: deeper stages extend shallower
  ones (`iterate_chain` at the composed body mono). -/
def genKnotStages (kc : KnotCtx) : TermElabM (Array Name) := do
  let mc := kc.mc
  -- single-sided Values binders (genKnotMono's scaffolding, undoubled)
  let mut decls : Array (Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
    let nm ← mc.args[i]!.fvarId!.getUserName
    match mc.kinds[i]! with
    | .plain => pure ()
    | _ => decls := decls.push (nm, .default, ty)
  withLocalDecls (decls.map fun (n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun xs => do
  let mut valOf : Std.HashMap Nat Expr := {}
  let mut argBinders : Array Expr := #[]
  let mut j := 0
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .plain =>
      valOf := valOf.insert i mc.args[i]!
      argBinders := argBinders.push mc.args[i]!
    | _ =>
      valOf := valOf.insert i xs[j]!
      argBinders := argBinders.push xs[j]!
      j := j + 1
  let vOf : Nat → TermElabM Expr := fun i => pure (valOf.get? i).get!
  -- the loop carrier at Values, its family, order, and seed
  let cf ← match mc.legTys[0]!.getAppFn with
    | .const n _ => pure (carrierFamOfHead n).get!
    | _ => throwError "HydroGen: knot leg head"
  let domV := reinterp mc.corner mc.values kc.loopTy
  let iTy ← memberIdxTy domV
  let mkRel ← withLocalDecl `a .default domV fun aE => do
    withLocalDecl `b .default domV fun bE => do
    let rel ← valuesRelOf cf domV aE bE
    mkLambdaFVars #[aE, bE] rel
  let seed ← match cf with
    | .stream => do
      let some tyP ← whnfUntil (← memberCellTy domV) ``PoolCarrier |
        throwError "HydroGen: loop carrier is not a pool"
      let n := tyP.getAppNumArgs
      mmMk domV fun _ => mkAppOptM ``PoolBot
        #[some (tyP.getArg! 0), none, some (tyP.getArg! (n - 2)),
          some (tyP.getArg! (n - 1))]
    | .atomic => do
      let tr ← whnf (← memberCellTy domV)
      mmMk domV fun _ => mkAppOptM ``List.nil #[some (tr.getArg! 0)]
    | _ => throwError "HydroGen: stages: unsupported loop carrier"
  -- the Values body at the module boundary (single-sided valuation)
  let valuesBodyAt := fun (w : Expr) => do
    let bv : BVal :=
      { interp := mc.values, gadget := w,
        wire := fun e => do vOf (← argIdxOf kc e),
        prim := fun _ e => do vOf (← argIdxOf kc e),
        recd := fun e => do vOf (← argIdxOf kc e) }
    let args ← bodyArgsVal kc bv
    let app := mkAppN (mkConst kc.comp.bodyMod)
      (kc.comp.preArgs ++ #[mc.values] ++ args)
    applyLeg app kc.comp.legPath
  let fF ← withLocalDecl `w .default domV fun wE => do
    mkLambdaFVars #[wE] (← valuesBodyAt wE)
  -- ==== `K.stages` ====
  let binders := mc.ctxArgs ++ argBinders
  let stagesVal ← instantiateMVars (← mkLambdaFVars binders
    (← withLocalDecl `m .default (mkConst ``Nat) fun mE => do
      mkLambdaFVars #[mE]
        (← mkAppOptM ``iterate #[some domV, some fF, some seed,
          some mE])))
  let stagesName := mc.mName ++ `stages
  unless (← getEnv).contains stagesName do
    let decl := Declaration.defnDecl {
      name := stagesName, levelParams := [],
      type := (← inferType stagesVal), value := stagesVal,
      hints := .regular (Lean.getMaxHeight (← getEnv) stagesVal + 1),
      safety := .safe }
    try Lean.addAndCompile decl
    catch _ => addDecl decl
    Lean.enableRealizationsForConst stagesName
  let stagesApp := fun (m : Expr) =>
    mkApp (mkAppN (mkConst stagesName) binders) m
  let mut names := #[stagesName]
  -- ==== `K.stages_zero` (rfl) ====
  let zeroE := mkNatLit 0
  let zeroStmt ← mkForallFVars binders
    (← mkEq (stagesApp zeroE) seed)
  let zeroVal ← mkLambdaFVars binders
    (← mkExpectedTypeHint (← mkEqRefl seed)
      (← mkEq (stagesApp zeroE) seed))
  let zeroName := stagesName.appendAfter "_zero"
  addThm zeroName zeroStmt zeroVal
  names := names.push zeroName
  -- ==== `K.stages_succ` (rfl, at the body-module boundary) ====
  let succName := stagesName.appendAfter "_succ"
  let (succStmt, succVal) ← withLocalDecl `m .default (mkConst ``Nat)
      fun mE => do
    let lhs := stagesApp (← mkAppM ``HAdd.hAdd #[mE, mkNatLit 1])
    let rhs := (fF.beta #[stagesApp mE]).headBeta
    let eq ← mkEq lhs rhs
    pure ((← mkForallFVars (binders ++ #[mE]) eq),
      (← mkLambdaFVars (binders ++ #[mE])
        (← mkExpectedTypeHint (← mkEqRefl lhs) eq)))
  addThm succName succStmt succVal
  names := names.push succName
  -- ==== `K.stages_fix` (rfl: the knot at `Values` is its fueled stage) ====
  let fuel ← knotFuelAt kc vOf
  let knotApp := mkAppN (mkConst mc.mName)
    (mc.ctxArgs ++ #[mc.values] ++
      (← (Array.range mc.args.size).mapM vOf))
  let fixEq ← mkEq knotApp (stagesApp fuel)
  let fixStmt ← mkForallFVars binders fixEq
  let fixVal ← mkLambdaFVars binders
    (← mkExpectedTypeHint (← mkEqRefl knotApp) fixEq)
  let fixName := stagesName.appendAfter "_fix"
  addThm fixName fixStmt fixVal
  names := names.push fixName
  -- ==== `K.stages_mono` (the Kleene chain) ====
  let hrefl ← withLocalDecl `a .default domV fun aE => do
    mkLambdaFVars #[aE] (← valuesRelRefl cf domV aE)
  let ptTrans : Expr → Expr → Expr → TermElabM Expr :=
    fun h₁ h₂ iE => do
      match cf with
      | .stream => mkAppM ``PoolLe.trans #[mkApp h₁ iE, mkApp h₂ iE]
      | _ => mkAppM ``List.IsPrefix.trans #[mkApp h₁ iE, mkApp h₂ iE]
  let htrans ← withLocalDecl `a .implicit domV fun aE => do
    withLocalDecl `b .implicit domV fun bE => do
    withLocalDecl `c .implicit domV fun cE => do
    withLocalDecl `h₁ .default ((mkRel.beta #[aE, bE]).headBeta)
        fun h₁E => do
    withLocalDecl `h₂ .default ((mkRel.beta #[bE, cE]).headBeta)
        fun h₂E => do
    let prf ← withLocalDecl `i .default iTy fun iE => do
      mkLambdaFVars #[iE] (← ptTrans h₁E h₂E iE)
    let prf ← mkExpectedTypeHint prf ((mkRel.beta #[aE, cE]).headBeta)
    mkLambdaFVars #[aE, bE, cE, h₁E, h₂E] prf
  let hx ← do
    let fseed := (fF.beta #[seed]).headBeta
    let prf ← withLocalDecl `i .default iTy fun iE => do
      let tgt ← mmRead fseed iE
      let p ← match cf with
        | .stream => do
          let some tyP ← whnfUntil (← inferType tgt) ``PoolCarrier |
            throwError "HydroGen: stages: seed pool"
          let n := tyP.getAppNumArgs
          mkAppOptM ``PoolLe.bot_le
            #[some (tyP.getArg! 0), none,
              some (tyP.getArg! (n - 2)), some (tyP.getArg! (n - 1)),
              some tgt]
        | _ => do
          let tr ← whnf (← inferType tgt)
          mkAppOptM ``List.nil_prefix
            #[some (tr.getArg! 0), some tgt]
      mkLambdaFVars #[iE] p
    mkExpectedTypeHint prf ((mkRel.beta #[seed, fseed]).headBeta)
  let hF ← withLocalDecl `a .implicit domV fun aE => do
    withLocalDecl `b .implicit domV fun bE => do
    withLocalDecl `hab .default ((mkRel.beta #[aE, bE]).headBeta)
        fun habE => do
    let wireHyp : Nat → TermElabM Expr := fun i => do
      let .wire cfI := mc.kinds[i]! |
        throwError "HydroGen: stages: wire hyp at non-wire"
      let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
      valuesRelRefl cfI ty (← vOf i)
    let prf ← composedMono kc habE wireHyp vOf
      (fun i => pure mc.args[i]!)
    mkLambdaFVars #[aE, bE, habE] prf
  let monoName := stagesName.appendAfter "_mono"
  let (monoStmt, monoVal) ←
    withLocalDecl `m .implicit (mkConst ``Nat) fun mE => do
    withLocalDecl `m' .implicit (mkConst ``Nat) fun m'E => do
    withLocalDecl `hmm .default (← mkAppM ``LE.le #[mE, m'E])
        fun hmmE => do
    let concl ← valuesRelOf cf domV (stagesApp mE) (stagesApp m'E)
    let chain ← mkAppOptM ``iterate_chain
      #[some domV, some mkRel, some hrefl, some htrans, some fF,
        some seed, some hx, some hF, some mE, some m'E, some hmmE]
    let prf ← mkExpectedTypeHint chain concl
    pure ((← mkForallFVars (binders ++ #[mE, m'E, hmmE]) concl),
      (← mkLambdaFVars (binders ++ #[mE, m'E, hmmE]) prf))
  let monoVal ← instantiateMVars monoVal
  addThm monoName monoStmt monoVal
  names := names.push monoName
  pure names

/-! ## The knot `wf` triple -/

/-- Recursive inner-knot `wf` at a (possibly lowered) valuation. -/
partial def innerWfAt (kc : KnotCtx) (idx : Nat) (bv : BVal)
    (TcE hjTE : Expr) (hwOf : Std.HashMap Nat Expr) (hreq? : Option Expr) :
    TermElabM Expr := do
  let ia := kc.comp.inners[idx]!
  unless ia.gi.wfLemmas.size ≥ 1 do
    throwError "HydroGen: inner knot {ia.kName} has no wf lemma"
  let mut args := #[]
  for a in ia.args, k in ia.kinds do
    args := args.push (← bargVal kc bv a k)
  let mut wfhyps : Array Expr := #[]
  for a in ia.args, k in ia.kinds do
    if let .wire _ := k then
      match a with
      | .gadget => wfhyps := wfhyps.push (Lean.mkConst ``True.intro)
      | .expr e =>
        wfhyps := wfhyps.push (hwOf.get? (← argIdxOf kc e)).get!
      | .inner j =>
        wfhyps := wfhyps.push (← innerWfAt kc j bv TcE hjTE hwOf hreq?)
  -- the inner knot's `requires` (the enclosing clause, over shared
  -- non-loop binders — D71): the knot lemma's own `hreq`
  let reqArg ← if ia.gi.hasRequires then
      match hreq? with
      | some h => pure #[h]
      | none => throwError "HydroGen: inner knot {ia.kName} has a `requires` \
          but the enclosing knot {kc.mc.mName} has none to supply"
    else pure #[]
  applyModLemma ia.kName ia.gi.wfLemmas[0]! kc.mc.pacing TcE kc.mc.Td
    hjTE ia.preArgs (args ++ wfhyps ++ reqArg)

/-- The assumed knot `invariant` at the Kleene stage `j` (D71/D95):
`I (iterate vbody seed j)`, from the clause's stage theorem
(`<def>.<w>.inv_stages : ∀ binders m, I (stages binders m)`) at the
knot's `Values` projections, transported along `iterate_congr` with the HVA
fact (`vbody v = F v` pointwise, `F` the stages' body). `none` when the
body module assumes no invariant. -/
def loopInvAtStage (kc : KnotCtx) (vbodyB seedV jE : Expr) :
    TermElabM (Option Expr) := do
  let mc := kc.mc
  unless (← loopInvariants.get).contains kc.comp.bodyMod do return none
  let some invThm := (← knotLoopInv.get).find? mc.mName
    | throwError "HydroGen: body module {kc.comp.bodyMod} assumes an \
        `invariant` but the knot {mc.mName} has no stage theorem for it"
  -- the knot's binders at `Values` (the stages' argument list: context,
  -- then every non-plain arg projected — wires `.rr`, decisions as the
  -- mono leg spells them)
  let fixSrB ← mkAppM kc.gad.fixSr #[kc.B]
  let mut vargs : Array Expr := #[]
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .plain => vargs := vargs.push mc.args[i]!
    | .wire _ => vargs := vargs.push (← mkProjection mc.args[i]! `rr)
    | .primDec .fixd => vargs := vargs.push (← mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1])
    | .primDec f =>
      if f.isContent then vargs := vargs.push (← vdecCompOf kc fixSrB)
      else if f.valuesPass then vargs := vargs.push mc.args[i]!
      else vargs := vargs.push (mkConst ``Unit.unit)
    | .decRec _ =>
      if treeHasContent (mc.trees[i]!).get! then
        vargs := vargs.push (← vdecCompOf kc fixSrB)
      else
        vargs := vargs.push (← repackRec mc.corner mc.values
          (fun f p => do
            match f with
            | .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
            | _ => if f.valuesPass then pure p else pure (mkConst ``Unit.unit))
          mc.args[i]!)
  let binders := mc.ctxArgs ++ vargs
  let stagesName := mc.mName ++ `stages
  let sInfo ← getConstInfo stagesName
  let sVal := (sInfo.value!.beta binders).headBeta
  let iterApp := sVal.bindingBody!
  unless iterApp.isAppOf ``iterate && iterApp.getAppNumArgs == 4 do
    throwError "HydroGen: {stagesName} is not an iterate"
  let F := iterApp.getAppArgs[1]!
  let seed := iterApp.getAppArgs[2]!
  unless ← isDefEq seed seedV do
    throwError "HydroGen: loop-wire requires: the stages' seed and the \
      corner's seed differ:{indentExpr seed}\n{indentExpr seedV}"
  let j1 := jE
  -- the clause at the stage (an assumed invariant's stage theorem is
  -- unbounded), and the predicate as a lambda (the theorem's conclusion
  -- abstracted over its stage occurrence)
  let hw0 := mkApp (mkAppN (mkConst invThm) binders) j1
  let hw0Ty ← instantiateMVars (← inferType hw0)

  let stageE := mkApp (mkAppN (mkConst stagesName) binders) j1
  let domV := reinterp mc.corner mc.values kc.loopTy
  let P ← withLocalDecl `w .default domV fun wE => do
    mkLambdaFVars #[wE] (hw0Ty.replace fun e => if e == stageE then some wE else none)
  -- `iterate F seed j = iterate vbody seed j` — pointwise from the HVA
  -- fact; `F v` must be the HVA's right side up to defeq
  let fHVA ← withLocalDecl `v .default domV fun vE => do
    let g ← coerceTo (← applyNamed kc.gad.probeC mc.pacing mc.Tc mc.Td mc.hjT
      #[fixSrB, vE]) kc.loopTy
    let base ← applyModLemma kc.comp.bodyMod kc.comp.gi.rrLemmas[kc.comp.legIdx]!
      mc.pacing mc.Tc mc.Td mc.hjT kc.comp.preArgs (cornerArgsAt kc g)
    let mut inner := #[]
    for idx in [0:kc.comp.inners.size] do
      let ia := kc.comp.inners[idx]!
      inner := inner.push (← applyModLemma ia.kName ia.gi.rrLemmas[0]! mc.pacing mc.Tc
        mc.Td mc.hjT ia.preArgs (cornerInnerArgsAt kc idx g))
      inner := inner.push (← applyModLemma ia.kName ia.gi.srLemmas[0]! mc.pacing mc.Tc
        mc.Td mc.hjT ia.preArgs (cornerInnerArgsAt kc idx g))
    let fact ← collapseFact (← rwRhsAll base inner)
    let rhs := (← inferType fact).appArg!
    let fv := (F.beta #[vE]).headBeta
    unless ← isDefEq rhs fv do
      throwError "HydroGen: loop-wire requires: the stages' body and the \
        corner's vbody differ at a stage:{indentExpr fv}\n{indentExpr rhs}"
    let ty ← mkEq fv (mkApp vbodyB vE)
    mkLambdaFVars #[vE] (← mkExpectedTypeHint (← mkEqSymm fact) ty)
  let eqIt ← mkAppOptM ``iterate_congr #[some domV, some F, some vbodyB, some fHVA, some seed, some j1]
  let eqIt ← mkExpectedTypeHint eqIt
    (← mkEq stageE (← mkAppOptM ``iterate #[some domV, some vbodyB, some seedV, some j1]))
  let hw ← mkEqMP (← mkCongrArg P eqIt) hw0
  pure (some hw)

/-- `K_co_wf₁`: the corner `wf` triple, by the validated blueprint
with composition-aware facts. -/
def genKnotWf (kc : KnotCtx) : TermElabM Name := do
  let mc := kc.mc
  let gad := kc.gad
  let comp := kc.comp
  -- input-wf hypotheses for the knot's wire args
  let mut hypDecls : Array (Nat × Name × Expr) := #[]
  for i in [0:mc.args.size] do
    if let .wire _ := mc.kinds[i]! then
      hypDecls := hypDecls.push
        (i, Name.mkSimple s!"hw{i}", ← mkProjection mc.args[i]! `wf)
  -- the knot's `requires` clause (the enclosing module's, over the
  -- knot's non-loop binders — D71): one more hypothesis, passed down to
  -- the body module's and the inner knots' wf lemmas
  let reqHyp : Array (Name × Expr) ← do
    match ← requiresFnAt mc.mName with
    | none => pure #[]
    | some fn =>
      pure #[(`hreq, ← mc.requiresAt fn)]
  withLocalDecls ((hypDecls.map fun (_, n, ty) =>
      (n, BinderInfo.default, fun _ => pure ty))
      ++ reqHyp.map fun (n, ty) => (n, BinderInfo.default, fun _ => pure ty)) fun hyps => do
  let hreq? : Option Expr := if reqHyp.isEmpty then none else some hyps.back!
  let hwOf : Std.HashMap Nat Expr := Id.run do
    let mut m := {}
    for d in hypDecls, hyp in hyps do
      m := m.insert d.1 hyp
    pure m
  let B := kc.B
  let vbodyB ← mkAppM gad.vbody #[B]
  let fixSrB ← mkAppM gad.fixSr #[B]
  let loopTy := kc.loopTy
  let domX := reinterp mc.corner mc.sched loopTy
  let domV := reinterp mc.corner mc.values loopTy
  let iTy := (← whnf domX).bindingDomain!
  -- lemma applications over the body composition
  let bodyLemAt := fun (lem : Name) (args : Array Expr) =>
    applyModLemma comp.bodyMod lem mc.pacing mc.Tc mc.Td mc.hjT
      comp.preArgs args
  let innerLemAt := fun (idx : Nat) (lem : Name) (args : Array Expr) =>
    applyModLemma (kc.comp.inners[idx]!).kName lem mc.pacing mc.Tc
      mc.Td mc.hjT (kc.comp.inners[idx]!).preArgs args
  let innerSrEqsAt := fun (g : Expr) => do
    let mut out := #[]
    for idx in [0:comp.inners.size] do
      let ia := comp.inners[idx]!
      out := out.push (← innerLemAt idx ia.gi.srLemmas[0]!
        (cornerInnerArgsAt kc idx g))
    pure out
  let innerRrEqsAt := fun (g : Expr) => do
    let mut out := #[]
    for idx in [0:comp.inners.size] do
      let ia := comp.inners[idx]!
      unless ia.gi.rrLemmas.size ≥ 1 do
        throwError "HydroGen: inner knot {ia.kName} has no rr naming"
      out := out.push (← innerLemAt idx ia.gi.rrLemmas[0]!
        (cornerInnerArgsAt kc idx g))
    pure out
  let schedCAt := fun (x : Expr) => do
    coerceTo (← applyNamed gad.schedC mc.pacing mc.Tc mc.Td mc.hjT #[x])
      loopTy
  let probeCAt := fun (x v : Expr) => do
    coerceTo (← applyNamed gad.probeC mc.pacing mc.Tc mc.Td mc.hjT
      #[x, v]) loopTy
  -- ===== FX =====
  let fFX ← withDeclDiag s!"knot {kc.mc.mName} wf/fFX" do
    withLocalDecl `x .default domX fun xE => do
    let g ← schedCAt xE
    let base ← bodyLemAt comp.gi.srLemmas[comp.legIdx]!
      (cornerArgsAt kc g)
    let fact ← collapseFact (← rwRhsAll base (← innerSrEqsAt g))
    mkLambdaFVars #[xE] fact
  -- ===== FC =====
  let fcDecVal : Nat → TermElabM Expr := fun i => do
    match mc.kinds[i]! with
    | .primDec f =>
      pure (if f.schedPass then mc.args[i]! else mkConst ``Unit.unit)
    | .decRec _ =>
      repackRec mc.corner mc.sched
        (fun f p =>
          pure (if f.schedPass then p else mkConst ``Unit.unit))
        mc.args[i]!
    | _ => pure mc.args[i]!
  -- ===== FC: the body's strictness in the loop wire (D95) =====
  let fFC ← withDeclDiag s!"knot {kc.mc.mName} wf/fFC" do
    withLocalDecl `h .default (mkConst ``Nat) fun hE => do
    withLocalDecl `x .default domX fun xE => do
    withLocalDecl `y .default domX fun yE => do
    withLocalDecl `hxy .default (← mkAppM gad.agreeL #[hE, mkNatLit 1, xE, yE])
        fun hxyE => do
    let srOf : Nat → TermElabM Expr := fun i => mkProjection mc.args[i]! `sr
    let (μ, prf) ← composedStrict kc hE hxyE srOf srOf
      (fun i => do
        let cfI ← match mc.kinds[i]! with
          | .wire c => pure c
          | _ => throwError "HydroGen: not a wire"
        mkAppM (agreeRelOf cfI ++ `refl)
          #[hE, ← mkProjection mc.args[i]! `sr])
      fcDecVal
      (fun i => pure mc.args[i]!)
    let cfK ← match mc.legTys[0]!.getAppFn with
      | .const n _ =>
        match carrierFamOfHead n with
        | some cf => pure cf
        | none => throwError "HydroGen: knot leg is not a carrier"
      | _ => throwError "HydroGen: knot leg head"
    let prf ← agreeBaseOf cfK prf μ s!"knot {mc.mName} (wf strictness)"
    mkLambdaFVars #[hE, xE, yE, hxyE] prf
  -- ===== FSM (tick knots: the body preserves tick-monotonicity, W4) =====
  let fFSM ← withDeclDiag s!"knot {kc.mc.mName} wf/fFSM" do
    if gad.isTick then
      withLocalDecl `x .default domX fun xE => do
      withLocalDecl `hx .default (← mkAppM ``TMono #[xE]) fun hxE => do
      let prf ← composedSMono kc hxE
        (fun i => do
          let cfI ← match mc.kinds[i]! with
            | .wire c => pure c
            | _ => throwError "HydroGen: not a wire"
          if cfI.isTick then
            -- the context wire's corner `mono`, under its wf hypothesis
            pure (mkApp (← mkProjection mc.args[i]! `mono) (hwOf.get? i).get!)
          else
            mkAppM ``TMonoTriv.intro #[← mkProjection mc.args[i]! `sr])
        fcDecVal
        (fun i => pure mc.args[i]!)
      mkLambdaFVars #[xE, hxE] prf
    else pure (mkConst ``True.intro)
  -- ===== HVA =====
  let fHVA ← withDeclDiag s!"knot {kc.mc.mName} wf/fHVA" do
    withLocalDecl `v .default domV fun vE => do
    let g ← probeCAt fixSrB vE
    let base ← bodyLemAt comp.gi.rrLemmas[comp.legIdx]!
      (cornerArgsAt kc g)
    let fact ← collapseFact (← rwRhsAll base
      ((← innerRrEqsAt g) ++ (← innerSrEqsAt g)))
    let rhs := (← inferType fact).appArg!
    let ty ← mkEq (mkApp vbodyB vE) rhs
    mkLambdaFVars #[vE] (← mkExpectedTypeHint fact ty)
  -- ===== FM =====
  let vdecFix ← vdecCompOf kc fixSrB
  let fmDecVal : Nat → TermElabM Expr := fun i => do
    match mc.kinds[i]! with
    | .primDec .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
    | .primDec f =>
      if f.isContent then pure vdecFix
      else if f.valuesPass then pure mc.args[i]!
      else pure (mkConst ``Unit.unit)
    | .decRec _ =>
      if treeHasContent (mc.trees[i]!).get! then pure vdecFix
      else
        repackRec mc.corner mc.values
          (fun f p => do
            match f with
            | .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
            | _ =>
              if f.valuesPass then pure p
              else pure (mkConst ``Unit.unit)) mc.args[i]!
    | _ => pure mc.args[i]!
  let mkRel2 := fun (p q : Expr) => do
    if gad.isTick then
      mkAppM ``List.IsPrefix #[p, q]
    else
      let some tyP ← whnfUntil (← inferType p) ``PoolCarrier |
        throwError "HydroGen: loop carrier is not a pool"
      let n := tyP.getAppNumArgs
      mkAppM ``PoolLe #[tyP.getArg! (n - 2), tyP.getArg! (n - 1), p, q]
  let relV ← withLocalDecl `a .default domV fun aE => do
    withLocalDecl `b .default domV fun bE => do
    withLocalDecl `j .default iTy fun jE => do
    mkLambdaFVars #[aE, bE]
      (← mkForallFVars #[jE] (← mkRel2 (← mmRead aE jE) (← mmRead bE jE)))
  let fFM ← withDeclDiag s!"knot {kc.mc.mName} wf/fFM" do
    withLocalDecl `a .default domV fun aE => do
    withLocalDecl `b .default domV fun bE => do
    withLocalDecl `hab .default ((relV.beta #[aE, bE]).headBeta)
        fun habE => do
    let prf ← composedMono kc habE
      (fun i => do
        let cfI ← match mc.kinds[i]! with
          | .wire c => pure c
          | _ => throwError "HydroGen: not a wire"
        let ty := reinterp mc.corner mc.values
          (← inferType mc.args[i]!)
        valuesRelRefl cfI ty (← mkProjection mc.args[i]! `rr))
      fmDecVal
      (fun i => pure mc.args[i]!)
    mkLambdaFVars #[aE, bE, habE] prf
  -- ===== FH =====
  let seedV ← if gad.isTick then do
      let tr ← whnf (← memberCellTy domV)
      mmMk domV fun _ => mkAppOptM ``List.nil #[some (tr.getArg! 0)]
    else do
      let some tyP ← whnfUntil (← memberCellTy domV) ``PoolCarrier |
        throwError "HydroGen: loop carrier is not a pool"
      let n := tyP.getAppNumArgs
      mmMk domV fun _ => mkAppOptM ``PoolBot
        #[some (tyP.getArg! 0), none, some (tyP.getArg! (n - 2)),
          some (tyP.getArg! (n - 1))]
  let fFH ← withDeclDiag s!"knot {kc.mc.mName} wf/fFH" do
    do
    let hx ← withLocalDecl `j .default iTy fun jE => do
      let prf ← if gad.isTick then
          mkAppOptM ``List.nil_prefix
            #[none, some (← mmRead (mkApp vbodyB seedV) jE)]
        else do
          let some tyP ← whnfUntil (← memberCellTy domV) ``PoolCarrier |
            throwError "HydroGen: pool"
          let n := tyP.getAppNumArgs
          mkAppM ``poolBot_le #[tyP.getArg! (n - 2),
            tyP.getArg! (n - 1), ← mmRead (mkApp vbodyB seedV) jE]
      mkLambdaFVars #[jE] prf
    let hF ← withLocalDecl `a .implicit domV fun aE => do
      withLocalDecl `b .implicit domV fun bE => do
      let relab := (relV.beta #[aE, bE]).headBeta
      withLocalDecl `hab .default relab fun habE => do
      withLocalDecl `j .default iTy fun jE => do
      let hvaA := mkApp fHVA aE
      let hvaB := mkApp fHVA bE
      let cfA ← mkAppM ``MemberMap.get_congr #[hvaA, jE]
      let cfB ← mkAppM ``MemberMap.get_congr #[hvaB, jE]
      let elemTy ← memberCellTy domV
      let pl2 ← withLocalDecl `p .default elemTy fun pE => do
        withLocalDecl `q .default elemTy fun qE => do
        mkLambdaFVars #[pE, qE] (← mkRel2 pE qE)
      let eq2 ← mkAppM ``congrArg₂ #[pl2, cfA, cfB]
      let mono := mkApp (mkApp (mkApp fFM aE) bE) habE
      let inner ← mkAppM ``Eq.mpr #[eq2, mkApp mono jE]
      mkLambdaFVars #[aE, bE, habE, jE] inner
    withLocalDecl `m .default (mkConst ``Nat) fun mE => do
    withLocalDecl `i .default iTy fun iE => do
    let its ← mkAppOptM ``iterate_le_succ
      #[none, some relV, none, some seedV, some hx, some hF]
    mkLambdaFVars #[mE, iE] (mkApp (mkApp its mE) iE)
  -- ===== the lowered instance (hcplj) =====
  let cornerAt := fun (TcE hjTE : Expr) =>
    mkAppN (mkConst ``CoupleSem)
      #[mc.L, mc.memE, mc.pacing, TcE, mc.Td, hjTE]
  -- the knot's lag `L` (D95): the body's output lag at the lag probe
  -- carrying the loop input's lag — the graded coupling is assumed at
  -- the horizons `j + L ≤ Tc` and discharged at the corner `j + L`,
  -- where the body's externals (lag `≤ L` on any immediate path to the
  -- output) are coupled at `j`
  -- named (`K_lag binders := fixLag p B`): the lag sits in every lowered
  -- horizon `j + L`, so an open spelling would carry the whole body into
  -- every corner argument's type (the terms grow multiplicatively through
  -- nested knots; `rw` over them never finishes)
  let lagE ← do
    let lagName := mc.mName.appendAfter "_lag"
    unless (← getEnv).contains lagName do
      addDefn lagName (← mkForallFVars mc.allBinders (mkConst ``Nat))
        (← mkLambdaFVars mc.allBinders (← mkAppM gad.fixLag #[B]))
    pure (mkAppN (mkConst lagName) mc.allBinders)
  -- `FL : L = E₀` — the knot's lag, opened: the body's lag naming at the
  -- lag probe (`L` unfolds to that application's `.lag` by delta/beta)
  let fFL ← withDeclDiag s!"knot {kc.mc.mName} wf/fFL" do
    unless comp.legIdx < comp.gi.lagLemmas.size do
      throwError "HydroGen: {comp.bodyMod} has no lag naming for leg {comp.legIdx}"
    let (g0, _, hFixLag) ← knotLagOpen kc
    let fact ← lagFactAt comp.gi.lagLemmas[comp.legIdx]! comp.bodyMod
      mc.pacing mc.Tc mc.Td mc.hjT comp.preArgs (cornerArgsAt kc g0)
    let e0 := (← inferType fact).appArg!
    -- `K_lag = fixLag B = (B g0).lag = (leg (C … g0)).lag = e0` (`knotLagOpen`)
    let some (_, fixLagE, rhsOpen) := (← inferType hFixLag).eq? | throwError "HydroGen: knotLagOpen"
    let h1 ← mkExpectedTypeHint hFixLag (← mkEq lagE rhsOpen)
    let _ := fixLagE
    let fact' ← mkExpectedTypeHint fact (← mkEq rhsOpen e0)
    mkEqTrans h1 fact'
  -- the graded coupling is probed at the Kleene STAGE `j` (D71/D95): `v`
  -- is not a binder but `iterate vbody seed j`, and the loop input is
  -- coupled with it strictly below `j` (`t < j`: the body is strict)
  -- (a tick knot's graded coupling may assume its loop input
  -- step-monotone — `hxm`, D71 — the machine leg is the diagonal)
  let cpljTele := fun (k : Expr → Expr → Expr → Expr → Expr → Option Expr →
      TermElabM Expr) => do
    withLocalDecl `j .default (mkConst ``Nat) fun jE => do
    let jL ← mkAppM ``HAdd.hAdd #[jE, lagE]
    withLocalDecl `hj .default (← mkAppM ``LE.le #[jL, mc.Tc]) fun hjE => do
    withLocalDecl `x .default domX fun xE => do
    let vE ← mkAppOptM ``iterate
      #[some domV, some vbodyB, some seedV, some jE]
    let hxvTy ← withLocalDecl `t .default (mkConst ``Nat) fun tE => do
      withLocalDecl `ht .default (← mkAppM ``LT.lt #[tE, jE]) fun htE => do
      withLocalDecl `i .default iTy fun iE => do
      let vEi ← mmRead vE iE
      let body ← if gad.isTick then
          mkAppM ``List.IsPrefix
            #[mkApp (mkApp xE iE) tE, vEi]
        else do
          let view ← mkAppM ``StepHist.view #[mkApp xE iE, tE]
          let some tyV ← whnfUntil (← inferType vEi)
              ``PoolCarrier |
            throwError "HydroGen: loop reader carrier is not a pool"
          let n := tyV.getAppNumArgs
          mkAppM ``ListLe
            #[tyV.getArg! (n - 2), tyV.getArg! (n - 1), view, vEi]
      mkForallFVars #[tE, htE, iE] body
    withLocalDecl `hxv .default hxvTy fun hxvE => do
    if gad.isTick then
      withLocalDecl `hxm .default (← mkAppM ``TMono #[xE]) fun hxmE => do
      let body ← withDeclDiag "cpljTele/k" <| k jE hjE xE vE hxvE (some hxmE)
      withDeclDiag "cpljTele/abstract" <| mkLambdaFVars #[jE, hjE, xE, hxvE, hxmE] body
    else
      let body ← withDeclDiag "cpljTele/k" <| k jE hjE xE vE hxvE none
      withDeclDiag "cpljTele/abstract" <| mkLambdaFVars #[jE, hjE, xE, hxvE] body
  -- the lowered instance sits at the corner `j + L`; the loop input is
  -- `mkC` at lag `L + 1` (coupled at `k + (L + 1) ≤ j + L`, i.e. `k < j`:
  -- `hxv` — D95, the body is strict in it)
  let lagE1 ← mkAppM ``HAdd.hAdd #[lagE, mkNatLit 1]
  let mkLowVal := fun (jE hjE xE vE hxvE : Expr) (hxm? : Option Expr) => do
    let jL ← mkAppM ``HAdd.hAdd #[jE, lagE]
    let hjT' ← mkAppM ``Nat.le_trans #[hjE, mc.hjT]
    let corner' := cornerAt jL hjT'
    -- `hc : ∀ k, k + (L + 1) ≤ j + L → ∀ i, …` from `hxv : ∀ t < j, ∀ i, …`
    let hc ← withLocalDecl `k .default (mkConst ``Nat) fun kE => do
      let kL ← mkAppM ``HAdd.hAdd #[kE, lagE1]
      withLocalDecl `hk .default (← mkAppM ``LE.le #[kL, jL]) fun hkE => do
      -- `k + (L + 1) ≤ j + L → k < j`: `k + L + 1 ≤ j + L`, cancel `L`
      let hkj ← mkAppM ``Nat.lt_of_add_lt_add_right
        #[← mkAppM ``Nat.lt_of_succ_le
          #[← mkExpectedTypeHint hkE
            (← mkAppM ``LE.le #[← mkAppM ``Nat.succ #[← mkAppM ``HAdd.hAdd #[kE, lagE]], jL])]]
      mkLambdaFVars #[kE, hkE] (mkApp (mkApp hxvE kE) hkj)
    let mkCArg ← do
      if gad.isTick then
        coerceTo (← applyNamed gad.mkC mc.pacing jL mc.Td hjT'
          #[xE, vE, lagE1, hc, hxm?.get!]) (reinterp mc.corner corner' loopTy)
      else
        coerceTo (← applyNamed gad.mkC mc.pacing jL mc.Td hjT'
          #[xE, vE, lagE1, hc]) (reinterp mc.corner corner' loopTy)
    let bv : BVal :=
      { interp := corner', gadget := mkCArg,
        wire := fun e => withDeclDiag "mkLowVal/wire" do
          let hd ← withDeclDiag "mkLowVal/wire whnf" <| whnf (← inferType e)
          let lc := if hd.isAppOf ``CoTickSing then ``CoTickSing.lowerC
            else if hd.isAppOf ``CoSing then ``CoSing.lowerC
            else if hd.isAppOf ``CoKStream then ``CoKStream.lowerC
            else ``CoStream.lowerC
          let ap ← withDeclDiag "mkLowVal/wire applyNamed" <| applyNamed lc mc.pacing mc.Tc mc.Td mc.hjT
            #[hjE, hjT', e]
          withDeclDiag "mkLowVal/wire coerce" <| coerceTo ap
            (reinterp mc.corner corner' (← inferType e)),
        prim := fun _ e => pure e,
        recd := fun e => withDeclDiag "mkLowVal/recd" <|
          repackRec mc.corner corner' (fun _ p => pure p) e }
    pure (bv, jL, hjT')
  let innerEqsLow := fun (bv : BVal) (jE hjT' : Expr) (rr : Bool) => do
    let mut out := #[]
    for idx in [0:comp.inners.size] do
      let ia := comp.inners[idx]!
      let mut args := #[]
      for a in ia.args, k in ia.kinds do
        args := args.push (← bargVal kc bv a k)
      let lem := if rr then ia.gi.rrLemmas[0]! else ia.gi.srLemmas[0]!
      out := out.push (← applyModLemma ia.kName lem mc.pacing jE mc.Td
        hjT' ia.preArgs args)
    pure out
  -- the machine-leg naming at the lowered instance: `(lowered body).sr =
  -- (body at corner, loop at schedC x).sr`
  let mkFSR := fun (bv : BVal) (jL hjT' xE : Expr) => do
    let e1 ← applyModLemma comp.bodyMod
      comp.gi.srLemmas[comp.legIdx]! mc.pacing jL mc.Td hjT'
      comp.preArgs (← bodyArgsVal kc bv)
    let e1' ← collapseFact (← rwRhsAll e1
      (← innerEqsLow bv jL hjT' false))
    let g ← schedCAt xE
    let e2 ← bodyLemAt comp.gi.srLemmas[comp.legIdx]!
      (cornerArgsAt kc g)
    let e2' ← collapseFact (← rwRhsAll e2 (← innerSrEqsAt g))
    mkAppM ``Eq.trans #[e1', ← mkAppM ``Eq.symm #[e2']]
  let mkFRR := fun (bv : BVal) (jL hjT' xE vE : Expr) => do
    let bargs ← withDeclDiag "fFRR/bodyArgsVal" <| bodyArgsVal kc bv
    let e1 ← withDeclDiag "fFRR/e1" <| applyModLemma comp.bodyMod
      comp.gi.rrLemmas[comp.legIdx]! mc.pacing jL mc.Td hjT'
      comp.preArgs bargs
    let innerLow ← withDeclDiag "fFRR/innerEqsLow" do
      pure ((← innerEqsLow bv jL hjT' true) ++ (← innerEqsLow bv jL hjT' false))
    let e1rw ← withDeclDiag "fFRR/e1 rw" <| rwRhsAll e1 innerLow
    let e1' ← withDeclDiag "fFRR/e1'" <| collapseFact e1rw
    let g ← withDeclDiag "fFRR/probeCAt" <| probeCAt xE vE
    let e2 ← withDeclDiag "fFRR/e2" <| bodyLemAt comp.gi.rrLemmas[comp.legIdx]!
      (cornerArgsAt kc g)
    let innerAt ← withDeclDiag "fFRR/innerAt" do
      pure ((← innerRrEqsAt g) ++ (← innerSrEqsAt g))
    let e2rw ← withDeclDiag "fFRR/e2 rw" <| rwRhsAll e2 innerAt
    let e2' ← withDeclDiag "fFRR/e2'" <| collapseFact e2rw
    withDeclDiag "fFRR/trans" <| mkAppM ``Eq.trans #[e1', ← mkAppM ``Eq.symm #[e2']]
  let fFOUT ← withDeclDiag s!"knot {kc.mc.mName} wf/fFOUT" do
    cpljTele fun jE hjE xE vE hxvE hxm? => do
    let (bv, jL, hjT') ← withDeclDiag "fFOUT/mkLowVal" <| mkLowVal jE hjE xE vE hxvE hxm?
    let args ← withDeclDiag "fFOUT/bodyArgsVal" <| bodyArgsVal kc bv
    let mut wfExtras : Array Expr := #[]
    for a in comp.args, k in comp.kinds do
      if let .wire _ := k then
        match a with
        | .gadget => wfExtras := wfExtras.push (Lean.mkConst ``True.intro)
        | .expr e =>
          wfExtras := wfExtras.push (hwOf.get? (← argIdxOf kc e)).get!
        | .inner idx =>
          wfExtras := wfExtras.push (← withDeclDiag "fFOUT/innerWfAt" <| innerWfAt kc idx bv jL hjT' hwOf hreq?)
    unless comp.gi.wfLemmas.size > comp.legIdx do
      throwError "HydroGen: {comp.bodyMod} has no wf lemma for the leg"
    let reqArg ← if comp.gi.hasRequires then
        -- the body module's clause: the knot's own `hreq` and/or the
        -- assumed invariant at the Kleene stage (D71) — `R ∧ I(stage)`
        let hw? ← loopInvAtStage kc vbodyB seedV jE
        match hreq?, hw? with
        | some h, none => pure #[h]
        | none, some hw => pure #[hw]
        | some h, some hw => pure #[← mkAppM ``And.intro #[h, hw]]
        | none, none => throwError "HydroGen: body module {comp.bodyMod} has a `requires` \
            but the knot {mc.mName} has none to supply"
      else pure #[]
    let wfApp ← withDeclDiag "fFOUT/wfApp" <| applyModLemma comp.bodyMod
      comp.gi.wfLemmas[comp.legIdx]! mc.pacing jL mc.Td hjT'
      comp.preArgs (args ++ wfExtras ++ reqArg)
    let modApp := (← inferType wfApp).appArg!
    let cplPrj ← withDeclDiag "fFOUT/cplPrj" <| mkProjection modApp `cpl
    -- the output's coupling at the horizon `j`: `j + Λ ≤ j + L` for the
    -- lowered body's output lag `Λ` — by `omega` from the two lag
    -- namings (`Λ = E(L, ℓ)` here, `L = E(0, ℓ)` in `FL`: every immediate
    -- path's contribution is bounded by the probe's)
    let lamPrj ← withDeclDiag "fFOUT/lamPrj" <| mkProjection modApp `lag
    let hLam ← withDeclDiag "fFOUT/hLam" <| lagFactAt comp.gi.lagLemmas[comp.legIdx]!
      comp.bodyMod mc.pacing jL mc.Td hjT' comp.preArgs args
    let hlagTy ← mkAppM ``LE.le #[← mkAppM ``HAdd.hAdd #[jE, lamPrj], jL]
    if (← IO.getEnv "HYDROGEN_LAG_DIAG").isSome then
      IO.eprintln s!"[lag] {mc.mName}: HLAM : {← ppExpr (← inferType hLam)}\n[lag]   HL : {← ppExpr (← inferType fFL)}\n[lag]   goal : {← ppExpr hlagTy}"
    let hlag ← withLocalDecl `HLAM .default (← inferType hLam) fun hLamF => do
      withLocalDecl `HL .default (← inferType fFL) fun hLF => do
      let prf ← proveByTacOpen hlagTy "co_lag_le HLAM HL"
      pure ((← mkLambdaFVars #[hLamF, hLF] prf).beta #[hLam, fFL])
    let h1 := mkApp (mkApp (mkApp cplPrj wfApp) jE) hlag
    -- transport along the two leg namings by `Eq.mp` over a motive
    -- abstracted at REDUCIBLE transparency (the occurrences are syntactic;
    -- `rw`'s default-transparency `kabstract` whnfs the module through its
    -- knots on any same-headed subterm — D81, and the nested knots of
    -- `leader_election` never finish)
    let transport := fun (h eq : Expr) (what : String) => do
      let hTy ← instantiateMVars (← inferType h)
      let eqTy ← whnfR (← inferType eq)
      let some (_, lhs, _) := eqTy.eq? |
        throwError "HydroGen: transport: not an equation"
      let abst ← withReducible <| kabstract hTy lhs
      unless abst.hasLooseBVars do
        throwError "HydroGen: knot {mc.mName}: the {what} naming's left side does not \
          occur in the coupling fact:{indentExpr lhs}\nin{indentExpr hTy}"
      let motive := Expr.lam `z (← inferType lhs) abst .default
      mkAppM ``Eq.mp #[← mkCongrArg motive eq, h]
    let e1 ← withDeclDiag "fFOUT/FSR" <| mkFSR bv jL hjT' xE
    let e2 ← withDeclDiag "fFOUT/FRR" <| mkFRR bv jL hjT' xE vE
    let h2 ← withDeclDiag "fFOUT/transport sr" <| transport h1 e1 "sr"
    withDeclDiag "fFOUT/transport rr" <| transport h2 e2 "rr"
  -- ===== install the facts and run the fixed script =====
  let facts := #[fFX, fFC, fHVA, fFM, fFH, fFOUT, fFSM]
  let factNames : Array Name :=
    #[`FX, `FC, `HVA, `FM, `FH, `FOUT, `FSM]
  let mut factTys := #[]
  for f in facts do
    factTys := factTys.push (← inferType f)
  let factTysA := factTys
  withLocalDecls
      ((factNames.zip factTysA).map fun (n, ty) =>
        (n, BinderInfo.default, fun _ => pure ty)) fun factFVars => do
  let concl ← mkProjection mc.appCorner `wf
  let script :=
    if gad.isTick then
      s!"(hb_block \"wf-simp\" (co_wf_simp [{mc.mName}]; refine ⟨?_, ?_, ?_, ?_⟩); " ++
      "(hb_block \"wf-strict\" (intro h x y hxy; have h1 := FC h x y hxy; " ++
      "rw [← FX x, ← FX y] at h1; exact h1)); " ++
      "(hb_block \"wf-chain\" (exact FH)); " ++
      "(hb_block \"wf-cpl\" (intro j hj x hxv hxm i; exact FOUT j hj x hxv hxm i)); " ++
      "(hb_block \"wf-smono\" (intro x hx; have h1 := FSM x hx; rw [← FX x] at h1; exact h1)))"
    else
      s!"(hb_block \"wf-simp\" (co_wf_simp [{mc.mName}]; refine ⟨?_, ?_, ?_⟩); " ++
      "(hb_block \"wf-strict\" (intro h x y hxy; have h1 := FC h x y hxy; " ++
      "rw [← FX x, ← FX y] at h1; exact h1)); " ++
      "(hb_block \"wf-chain\" (exact FH)); " ++
      "(hb_block \"wf-cpl\" (intro j hj x hxv i; exact FOUT j hj x hxv i)))"
  let prf ← proveByTacOpen concl script
  let prfClosed := (← mkLambdaFVars factFVars prf).beta facts
  let name := mc.mName.appendAfter "_co_wf₁"
  let stmt ← mkForallFVars (mc.allBinders ++ hyps) concl
  let val ← mkLambdaFVars (mc.allBinders ++ hyps) prfClosed
  addThm name stmt val
  pure name

/-! ## The command -/

/-- The knot phase, term-elaboration side, **idempotent** (the
eager knot-stack drain inside `fix` elaboration runs it innermost-
first so ghost clauses and prove legs of the enclosing `hydro def`
can cite the generated knot vocabulary; the post-def pipeline pass
then skips it). -/
def runKnotStackT (mName : Name) (extras : Array Name) :
    TermElabM Unit := do
  if let some gi := getGenInfo (← getEnv) mName then
    if gi.isKnot then
      return
  -- idempotence across a nested fix's re-elaboration (the enclosing
  -- single-source pass 2): the stack's constants may already exist
  -- even when the gen-info extension state was branch-local
  if (← getEnv).contains (mName.appendAfter s!"_co_sr{subscript 1}") then
    return
  let extras := extrasWithSpec (← getEnv) mName extras
  let (sr, lg, rr, stl, sm, mo, wf) ←
    withModCtx mName (extras := extras) fun mc =>
    withKnotCtx mc fun kc => do
      let hbDiag := (← IO.getEnv "HYDROGEN_HB_DIAG").isSome
      let tP ← IO.monoMsNow
      let hbAt := fun (what : String) (hb0 : Nat) => do
        -- (the generator's own cost between proofs: the proofs are
        -- accounted inside `withDeclDiag` and credited back)
        if hbDiag then IO.eprintln s!"[hb] knot {mName} {what} (generator): {((← IO.getNumHeartbeats) - hb0) / 1000}k {(← IO.monoMsNow) - tP}ms-since-knot-start cmd-used={((← IO.getNumHeartbeats) - (← readThe Core.Context).initHeartbeats) / 1000}k"
      let hb0 ← IO.getNumHeartbeats
      let sr ← genKnotSr kc
      hbAt "sr" hb0
      logInfo m!"hydro_knot {mName}: sr ok"
      let lg ← genKnotLag kc
      logInfo m!"hydro_knot {mName}: lag ok"
      let hb0 ← IO.getNumHeartbeats
      let rr ← genKnotRr kc sr
      hbAt "rr" hb0
      logInfo m!"hydro_knot {mName}: rr ok"
      let hb0 ← IO.getNumHeartbeats
      let stl ← genKnotStrict kc
      hbAt "strict" hb0
      logInfo m!"hydro_knot {mName}: strict ok"
      let hb0 ← IO.getNumHeartbeats
      let sm ← genKnotSMono kc
      hbAt "smono" hb0
      logInfo m!"hydro_knot {mName}: smono ok"
      let hb0 ← IO.getNumHeartbeats
      let mo ← genKnotMono kc
      hbAt "mono" hb0
      logInfo m!"hydro_knot {mName}: mono ok"
      -- stages BEFORE wf (D71): the `invariant` clause is an induction
      -- over the stages whose conclusion the wf's graded leg consumes
      -- when the body assumes it — the `fix` elaborator's hook runs in
      -- between
      let st ← genKnotStages kc
      logInfo m!"hydro_knot {mName}: stages ok ({st})"
      if let some hook ← loopInvHook.get then
        hook mName
      let hb0 ← IO.getNumHeartbeats
      let wf ← genKnotWf kc
      hbAt "wf" hb0
      pure (sr, lg, rr, stl, sm, mo, wf)
  let hasReq := (← requiresStxFor mName).isSome
  registerInfoT mName fun gi =>
    { gi with srLemmas := #[sr], rrLemmas := #[rr], lagLemmas := #[lg],
              strictLemma? := some stl,
              smonoLemmas := #[sm], monoLemmas := #[mo],
              wfLemmas := #[wf], isKnot := true, hasRequires := hasReq }
  logInfo m!"hydro_knot {mName}: {sr}, {rr}, {mo}, {wf}"

/-! ## Glue modules (the glue phase)

Modules whose content decisions are consumed entirely by registered
callees (`leader_election` passes its whole record to the knots;
`paxos_core`'s chain body slices `dec.le`/`dec.sp` into
`leader_election` and `sequence_payload`). Their namings are generated by **simp
discovery**: the corner body is rewritten ONCE by the callee namings
(+ the gadget collapses), the emergent `Values`-side decision record
is extracted and named (`M_vdec`, in the `genRrEx` binder
convention), and the theorem closes with a single module-scale defeq
hint — no `∃`-witness goals and no re-simping loops (the 7 GB
lesson). -/

/-- Structurally zeta-reduce all `let`/`letFun` (`have`) bindings —
glue bodies chain `have le := (callee …) …; …` and a projection on
the chain blocks `simp`'s own reduction. Definitionally transparent
(the kernel pays one beta per binding). -/
partial def zetaAll (e : Expr) : CoreM Expr :=
  Core.transform e (post := fun e => do
    match e with
    | .letE _ _ v b _ => return .visit (b.instantiate1 v)
    | _ =>
      if e.isAppOf ``letFun && e.getAppNumArgs ≥ 4 then
        let args := e.getAppArgs
        return .visit (mkAppN (args[3]!.beta #[args[2]!]) args[4:args.size])
      else
        return .continue)

/-- The `co_simp` projection set as data — THE list `CoupleProj`'s
`co_simp` macro splices (`coSimpRules`), shared, so the glue's meet
check and the tactic cannot drift. -/
def coSimpBase : Array Name := coSimpRules

/-- The projection set as a name set (membership test for `simpTerm`). -/
def coSimpBaseSet : NameSet := coSimpBase.foldl (fun acc n => acc.insert n) {}

/-- The lag projection set as data (`CoupleProj`'s `coLagRules`; D95). -/
def coLagBase : Array Name := coLagRules

def coLagBaseSet : NameSet := coLagBase.foldl (fun acc n => acc.insert n) {}

/-- Simp an expression as a TERM, returning `(e', proof e = e')`
(`proof = none` when unchanged). -/
def simpTerm (e : Expr) (lemmas : Array Name) :
    TermElabM (Expr × Option Expr) := do
  -- the projection set comes prebuilt from its simp attribute (D81: a
  -- call no longer re-adds three hundred rules); only the extras are
  -- added here
  let useBase := lemmas.contains coSimpBase[0]!
  let useLag := lemmas.contains coLagBase[0]!
  let mut st : SimpTheorems := {}
  let mut prebuilt : Array SimpTheorems := #[]
  -- (the lag chain takes the default simprocs too, for its numerals)
  let mut procs : Simp.Simprocs ← if useLag then Simp.getSimprocs else pure {}
  if useBase then
    let some ext ← getSimpExtension? `co_simp_rules
      | throwError "simpTerm: the `co_simp_rules` simp attribute is missing"
    prebuilt := prebuilt.push (← ext.getTheorems)
    procs ← procs.add ``coTickScanProj (post := true)
  if useLag then
    -- the lag projection set (D95), prebuilt the same way
    let some ext ← getSimpExtension? `co_lag_rules
      | throwError "simpTerm: the `co_lag_rules` simp attribute is missing"
    prebuilt := prebuilt.push (← ext.getTheorems)
    procs ← procs.add ``coTickScanProj (post := true)
    procs ← procs.add ``coLagLeaf (post := false)
  for n in lemmas do
    if useBase && coSimpBaseSet.contains n then continue
    if useLag && coLagBaseSet.contains n then continue
    if let some ci := (← getEnv).find? n then
      -- Theorems are simp rules; simprocs (the structural tick-former
      -- projection, `coTickScanProj`) are procedures; defs (wrapper
      -- constants) must go in as unfold targets instead.
      if ci.isTheorem then
        st ← st.addConst n
      else if ← Simp.isSimproc n then
        procs ← procs.add n (post := true)
      else
        st ← st.addDeclToUnfold n
  let ctx ← Simp.mkContext (simpTheorems := prebuilt.push st)
  let (res, _) ← simp e ctx (simprocs := #[procs])
  pure (res.expr, res.proof?)

/-- The module's corner body at the leg (delta+beta, lets zeta'd by
the simp pass), as an open term over the module binders. -/
def glueBodyAt (mc : ModCtx) (interp : Expr) (mapped : Array Expr)
    (leg : List LegStep) : TermElabM Expr := do
  let info ← getConstInfo mc.mName
  let some v := info.value? |
    throwError "HydroGen: {mc.mName} has no value"
  let app := (v.beta (mc.ctxArgs ++ #[interp] ++
    mapped[0:mc.realCount])).headBeta
  let app ← applyLeg app mc.legPre
  let app := mkAppN app mapped[mc.realCount:mapped.size]
  applyLeg app leg

/-- Collect `(decRecordType, term)` for registered callee applications
at the `Values` interpretation inside `t`. -/
partial def collectValuesDecArgs (mc : ModCtx) (t : Expr) :
    TermElabM (Array (Expr × Expr)) := do
  go t #[]
where
  go (e : Expr) (acc0 : Array (Expr × Expr)) :
      TermElabM (Array (Expr × Expr)) := do
    let env ← getEnv
    match e with
    | .app .. =>
      let f := e.getAppFn
      let mut acc := acc0
      if let .const c _ := f then
        if (getGenInfo env c).isSome then
          for a in e.getAppArgs do
            let ty ← inferType a
            if let .const tn _ := ty.getAppFn then
              -- a decision record, or a bare content decision (D81: a
              -- callee taking one `OrderSelDec` — `tag_with_sender`)
              let isDec := isStructure env tn ||
                ((decFamOfHead tn).map (·.isContent)).getD false
              if isDec && ty.getAppArgs.any (· == mc.values) then
                acc := acc.push (ty, a)
      for a in e.getAppArgs do
        acc ← go a acc
      go f acc
    | .lam _ _ b _ | .forallE _ _ b _ => go b acc0
    | .letE _ _ v b _ => go b (← go v acc0)
    | .mdata _ b | .proj _ _ b => go b acc0
    | _ => pure acc0

/-- The glue module's `Values`-side decision record, extracted from
the discovered term: whole-record passthrough when a callee consumes
the module's record type directly; otherwise field-wise (sub-records
by type match against callee decision args, `fixd` at `Td + 1`,
machine/values-pass prims from the corner record). -/
def extractGlueVdec (mc : ModCtx) (ts : Array Expr) : TermElabM Expr := do
  let recIdx ← do
    let mut r := none
    for i in [0:mc.args.size] do
      if let .decRec _ := mc.kinds[i]! then
        -- with a nondet record and a sched record in scope, the vdec
        -- is extracted for the content-carrying one
        if treeHasContent (mc.trees[i]!).get! then r := some i
    match r with
    | some i => pure i
    | none => throwError "HydroGen: {mc.mName}: glue module has no \
        content-carrying decision record"
  let recTyV := reinterp mc.corner mc.values
    (← inferType mc.args[recIdx]!)
  let mut found := #[]
  for t in ts do
    found := found ++ (← collectValuesDecArgs mc t)
  if found.isEmpty then
    throwError "HydroGen: {mc.mName}: discovery found no Values-side \
      callee decision args; discovered terms:\n{ts}"
  -- whole-record passthrough
  for (ty, a) in found do
    if ← isDefEq ty recTyV then
      return a
  -- field-wise
  let .const s _ := recTyV.getAppFn |
    throwError "HydroGen: glue record head"
  let ctor := getStructureCtor (← getEnv) s
  let mut fields := #[]
  for f in getStructureFields (← getEnv) s do
    let pC ← mkProjection mc.args[recIdx]! f
    let ptyC ← whnfR (← inferType pC)
    let ptyV := reinterp mc.corner mc.values ptyC
    let v ← do
      if let .const n _ := ptyC.getAppFn then
        if let some df := decFamOfHead n then
          match df with
          | .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
          | _ =>
            if df.valuesPass then pure pC
            else if df.isContent then
              -- a bare content decision a callee consumes: its
              -- discovered `Values`-side naming, matched by type (two
              -- fields of one decision type would be ambiguous here —
              -- the meet check would then refuse the module)
              let mut r := none
              for (ty, a) in found do
                if r.isNone then
                  if ← isDefEq ty ptyV then r := some a
              match r with
              | some a => pure a
              | none => throwError "HydroGen: {mc.mName}: no callee \
                  consumes content decision field {f} ({ptyV})"
            else pure (mkConst ``Unit.unit)
        else
          -- a sub-record: find it among the callee decision args
          let mut r := none
          for (ty, a) in found do
            if r.isNone then
              if ← isDefEq ty ptyV then r := some a
          match r with
          | some a => pure a
          | none => throwError "HydroGen: {mc.mName}: no callee \
              consumes record field {f} ({ptyV})"
      else throwError "HydroGen: glue field {f}"
    fields := fields.push v
  mkAppOptM ctor.name
    ((recTyV.getAppArgs ++ fields).map some)

/-- The corner-side chain for a glue leg: `lhs ≡ bodyC` (one module
delta), simp (callee namings fold most redexes), then the residual
pass (dependent-position redexes simp cannot reach). Returns the
proof `lhs = tC` together with `tC`. -/
def glueCornerChain (lhs bodyC : Expr) (simpC : Array Name)
    (resLems : Array (Name × LemKey)) (cache : MatchCache) :
    TermElabM (Expr × Expr) := do
  let dbg := (← IO.getEnv "HYDROGEN_SR_DIAG").isSome || (← IO.getEnv "HYDROGEN_GLUE_TICK").isSome
  -- (the label is a thunk: a pretty-printed size costs more than the step)
  let tick (what : Unit → TermElabM String) : TermElabM Unit := do
    if dbg then IO.eprintln s!"[glue] {← what ()}: heartbeats {(← IO.getNumHeartbeats) / 1000} ms {← IO.monoMsNow}"
  let bodyC ← zetaAll bodyC
  tick fun _ => pure "zeta"
  let (tC0, prfC?) ← simpTerm bodyC simpC
  tick fun _ => do pure s!"simp₀ (depth {bodyC.approxDepth}/{tC0.approxDepth}; {(← ppExpr tC0).pretty.length} chars)"
  let step ← mkExpectedTypeHint (← mkEqRefl bodyC) (← mkEq lhs bodyC)
  let step ← match prfC? with
    | some p => mkEqTrans step p
    | none => pure step
  let mut st ← RwSt.ofProof step lhs tC0
  -- alternate residual rewriting with simp re-normalization: terms a
  -- residual rewrite introduces (callee-lemma RHS instantiations)
  -- must reach the same simp-normal form as the module side (e.g.
  -- contract matches inside subtype type args)
  for _ in [0:8] do
    let rhs0 := st.rhs
    st ← st.rwResiduals resLems cache
    tick fun _ => do pure s!"residuals (attempts so far {(← cache.get).size}; {(← ppExpr st.rhs).pretty.length} chars)"
    let (t', prf?) ← simpTerm st.rhs simpC
    tick fun _ => pure "simp"
    match prf? with
    | some p => st := { st with rhs := t', prf := ← mkEqTrans st.prf p }
    | none =>
      -- a purely definitional pass (`rfl`-lemmas only — the op
      -- projections are all `rfl`) comes back without a proof: the
      -- normal form still advances (the chain's proof is checked
      -- against the tracked `rhs` at the end, by defeq)
      st := { st with rhs := t' }
    if st.rhs == rhs0 then break
  pure (st.prf, st.rhs)

/-- `co_residuals [callee rules…]`: the glue engine as a tactic, on the
LEFT side of an equation goal only. Normalizes `lhs` by the keyed
residual pass (callee namings in positions simp's congruence cannot
reach) alternated with simp (the projection set + the rules), and
replaces the goal `lhs = rhs` by `lhs' = rhs`. Made for the ∃-witness
namings (`genRrEx`): there the right side carries the witness holes,
and a `rewrite`/`rw` loop over the whole goal unifies every candidate
against those holes — the engine never touches the right side. -/
elab "co_residuals" "[" ids:ident,* "]" : tactic => do
  let g ← Tactic.getMainGoal
  g.withContext do
  let ty ← instantiateMVars (← g.getType)
  let some (_, lhs, rhs) := ty.eq?
    | throwError "co_residuals: equation goal expected"
  let rules ← ids.getElems.mapM fun i => realizeGlobalConstNoOverload i
  let resLems ← rules.mapM fun l => do pure (l, ← lemKeyOf l)
  let simpSet := coSimpBase ++ rules
  let cache : MatchCache ← IO.mkRef {}
  let dbg := (← IO.getEnv "HYDROGEN_SR_DIAG").isSome
  let tick (what : String) : Tactic.TacticM Unit := do
    if dbg then IO.eprintln s!"[co_residuals] {what}: heartbeats {(← IO.getNumHeartbeats) / 1000}"
  let mut st ← RwSt.ofProof (← mkEqRefl lhs) lhs lhs
  tick "start"
  for _ in [0:8] do
    let rhs0 := st.rhs
    st ← st.rwResiduals resLems cache
    tick s!"residuals (match attempts so far: {(← cache.get).size})"
    let (t', prf?) ← simpTerm st.rhs simpSet
    tick "simp"
    match prf? with
    | some p => st := { st with rhs := t', prf := ← mkEqTrans st.prf p }
    | none => st := { st with rhs := t' }
    if st.rhs == rhs0 then break
  if st.rhs == lhs then return
  let newGoal ← mkFreshExprSyntheticOpaqueMVar (← mkEq st.rhs rhs)
  g.assign (← mkEqTrans st.prf newGoal)
  Tactic.replaceMainGoal [newGoal.mvarId!]

/-- The two-sided glue leg proof for `lhs = rhs`: corner chain (delta
+ simp + residuals) meets the module side (delta + wrapper/vdec
unfolds — no corner apps exist on that side) SYNTACTICALLY. Any gap
is a generator bug (the two spellings must coincide by construction)
and is reported with both spellings. The kernel then only ever checks
one-delta `rfl`s and congruence steps — never a module-scale defeq
through the knots' opaque choice fuels (which is not definitional and
previously surfaced as kernel timeouts/mismatches). -/
def glueLegProof (mc : ModCtx) (lhs bodyC : Expr) (simpC : Array Name)
    (resLems : Array (Name × LemKey)) (rhs bodyR : Expr)
    (simpR : Array Name) (cache : MatchCache) :
    TermElabM Expr := do
  let (stepC, tC) ← glueCornerChain lhs bodyC simpC resLems cache
  -- the module side runs the SAME chain (corner-shaped lemmas cannot
  -- match it; the shared normalizers keep the two sides confluent)
  let (stepR, tR) ← glueCornerChain rhs bodyR simpR resLems cache
  unless tC == tR do
    -- structural miss: tolerate residual TYPE-argument differences
    -- (matcher apps inside subtype predicates that simp cannot
    -- reach) via reducible defeq — cheap when the trees otherwise
    -- share structure; anything else is a generator bug
    unless ← withReducible <| isDefEq tC tR do
      let _ ← meetError mc.mName "glue leg" tC tR
  mkExpectedTypeHint (← mkEqTrans stepC (← mkEqSymm stepR))
    (← mkEq lhs rhs)

/-- Generate the glue module's naming stack: per-leg `M_co_srᵢ` and
`M_co_rrᵢ` (at the named `M_vdec`), by simp discovery. -/
def genGlue (mc : ModCtx) : TermElabM (Array Name × Array Name × Name) := do
  let rules ← calleeNamingRules mc.mName
  let collapse : Array Name :=
    #[``co_probeC_sr, ``co_probeC_rr, ``co_schedC_sr,
      ``co_probe2_sr, ``co_probe2_rr, ``co_schedEmbed_sr,
      ``co_tick_probeC_sr, ``co_tick_probeC_rr, ``co_tick_schedC_sr,
      ``co_tick_probe2_sr, ``co_tick_probe2_rr,
      ``co_tick_schedEmbed_sr, ``co_input_sr, ``co_input_rr,
      ``co_tick_input_sr, ``co_tick_input_rr]
  -- a glue module may consume a callee knot through a tick body (D71):
  -- the tick former's structural projection is a procedure and its
  -- body's in-tick rewrites sit under binders — neither reachable by
  -- the keyed residual pass — so such a module takes the full per-op
  -- set into simp (the knot-free `co_simp` discipline); a tick-free
  -- glue module keeps the lean callee-naming set
  let hasTick ← do
    let info ← getConstInfo mc.mName
    pure ((info.value?.map fun v => (v.find? (·.isConstOf ``HydroSem.tick_scan)).isSome).getD false)
  let simpSet := rules ++ collapse ++ mc.extras
    ++ (if hasTick then coSimpBase else #[])
  -- residual pass: redexes in dependent argument positions (blocked
  -- for simp's congruence) and combinator trees wrapping callee legs
  -- — the full per-op set, applied one targeted rewrite at a time
  let resLems ← (coSimpBase ++ collapse ++ rules).filterMapM fun l => do
    -- unfold targets in the projection set (`BoundedOf`/`AtomicOf`)
    -- are simp-only: no rewrite key
    if (← getConstInfo l).isTheorem then pure (some (l, ← lemKeyOf l))
    else pure none
  let cache : MatchCache ← IO.mkRef {}
  -- ===== machine legs =====
  let srArgs ← mc.srArgs
  let srNames := (Array.range mc.legs.size).map fun i =>
    mc.mName.appendAfter s!"_co_sr{subscript (i + 1)}"
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let name := srNames[i]!
    withDeclDiag (toString name) do
    let lhs ← mkProjection (← mc.legAppAt mc.corner mc.args leg) `sr
    let bodyC ← mkProjection
      (← glueBodyAt mc mc.corner mc.args leg) `sr
    let rhs ← mc.legAppAt mc.sched srArgs leg
    let bodyR ← glueBodyAt mc mc.sched srArgs leg
    let prf ← glueLegProof mc lhs bodyC simpSet resLems rhs bodyR
      simpSet cache
    let stmt ← mkForallFVars mc.allBinders (← mkEq lhs rhs)
    addThm name stmt (← mkLambdaFVars mc.allBinders prf)
  -- ===== denotational legs =====
  -- discover on EVERY leg (record slices may be consumed leg-wise:
  -- `paxos_core`'s `sp` slice only appears in the payload legs), extract
  -- the record, then name it in the genRrEx binder convention
  -- (outers abstracted)
  let mut cornerChains : Array (Expr × Expr × Expr) := #[]
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let chain ← withDeclDiag s!"{mc.mName}_co_rr{subscript (i + 1)} (discovery)" do
      let lhs ← mkProjection (← mc.legAppAt mc.corner mc.args leg) `rr
      let bodyC ← mkProjection
        (← glueBodyAt mc mc.corner mc.args leg) `rr
      let (stepC, tC) ← glueCornerChain lhs bodyC simpSet resLems cache
      pure (lhs, stepC, tC)
    cornerChains := cornerChains.push chain
  let vdecRec ← extractGlueVdec mc (cornerChains.map (·.2.2))
  -- abstract over the machine outers (genRrEx order)
  let mut outerVals : Array Expr := #[]
  let mut outerTys : Array (Name × Expr) := #[]
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire cf =>
      outerVals := outerVals.push (← mkProjection mc.args[i]! `sr)
      outerTys := outerTys.push (Name.mkSimple s!"x{i}",
        reinterp mc.corner mc.sched (← inferType mc.args[i]!))
      -- a fold singleton's remembered machine source (genRrEx's
      -- `x{i}_src` binder)
      if cf == .sing then
        let sty ← inferType mc.args[i]!
        let a := sty.getAppArgs
        outerVals := outerVals.push (← mkProjection mc.args[i]! `src)
        outerTys := outerTys.push (Name.mkSimple s!"x{i}_src",
          mkAppN (mkConst ``HydroSem.Stream)
            #[a[0]!, a[1]!, mc.sched, a[3]!, a[4]!, a[6]!, a[7]!, a[8]!])
    | .primDec f =>
      if f.schedPass then
        outerVals := outerVals.push mc.args[i]!
        outerTys := outerTys.push (Name.mkSimple s!"d{i}",
          reinterp mc.corner mc.sched (← inferType mc.args[i]!))
    | .decRec _ =>
      for (path, f) in flattenTree (mc.trees[i]!).get! do
        if f.schedPass then
          let pv ← applyFieldPath mc.args[i]! path
          outerVals := outerVals.push pv
          outerTys := outerTys.push
            (Name.mkSimple (s!"d{i}_" ++
              String.intercalate "_" (path.map toString)),
             reinterp mc.corner mc.sched (← inferType pv))
    | .plain => pure ()
  let plainArgs := (mc.args.zip mc.kinds).filterMap fun (a, k) =>
    if k == .plain then some a else none
  let vdecName := mc.mName.appendAfter "_vdec"
  let vdecVal ← withLocalDecls
      (outerTys.map fun (n, ty) =>
        (n, BinderInfo.default, fun _ => pure ty)) fun outs => do
      let mut absd := vdecRec
      for v in outerVals, o in outs do
        absd := (← kabstract absd v).instantiate1 o
      let exBinders := mc.ctxArgs ++ #[mc.pacing, mc.Td] ++ plainArgs
        ++ outs
      if absd.hasFVar then
        for a in mc.args, k in mc.kinds do
          if k != .plain && absd.containsFVar a.fvarId! then
            throwError "HydroGen: {mc.mName}: vdec extraction left a \
              corner binder ({a}) unabstracted"
      mkLambdaFVars exBinders absd
  addDefn vdecName (← inferType vdecVal) vdecVal
  -- the vdec applied back at the module's own outers
  let exBindersVals := mc.ctxArgs ++ #[mc.pacing, mc.Td] ++ plainArgs
    ++ outerVals
  let vdecApp := mkAppN (mkConst vdecName) exBindersVals
  -- rr args: wires .rr, the record at the named vdec
  let mut rrArgs := #[]
  for a in mc.args, k in mc.kinds, t in mc.trees do
    match k with
    | .wire _ => rrArgs := rrArgs.push (← mkProjection a `rr)
    | .decRec _ =>
      -- sched-only records are all-`Unit` at `Values` (repacked
      -- field-wise); only content-carrying records take the vdec
      if treeHasContent t.get! then rrArgs := rrArgs.push vdecApp
      else
        rrArgs := rrArgs.push (← repackRec mc.corner mc.values
          (fun f p => do
            match f with
            | .fixd => mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1]
            | _ =>
              if f.valuesPass then pure p
              else pure (mkConst ``Unit.unit)) a)
    | .primDec .fixd =>
      rrArgs := rrArgs.push (← mkAppM ``HAdd.hAdd #[mc.Td, mkNatLit 1])
    | .primDec f =>
      if f.valuesPass then rrArgs := rrArgs.push a
      else rrArgs := rrArgs.push (mkConst ``Unit.unit)
    | .plain => rrArgs := rrArgs.push a
  let rrNames := (Array.range mc.legs.size).map fun i =>
    mc.mName.appendAfter s!"_co_rr{subscript (i + 1)}"
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let name := rrNames[i]!
    withDeclDiag (toString name) do
    let (lhs, stepC, tC) := cornerChains[i]!
    let rhs ← mc.legAppAt mc.values rrArgs leg
    let bodyR ← glueBodyAt mc mc.values rrArgs leg
    -- the module side spells the vdec folded; unfold it so both sides
    -- meet at the discovered record spelling
    let (stepR, tR) ← glueCornerChain rhs (← zetaAll bodyR)
      (simpSet.push vdecName) resLems cache
    unless tC == tR do
      unless ← withReducible <| isDefEq tC tR do
        let _ ← meetError mc.mName s!"glue rr leg {i}" tC tR
    let prf ← mkExpectedTypeHint
      (← mkEqTrans stepC (← mkEqSymm stepR)) (← mkEq lhs rhs)
    let stmt ← mkForallFVars mc.allBinders (← mkEq lhs rhs)
    addThm name stmt (← mkLambdaFVars mc.allBinders prf)
  pure (srNames, rrNames, vdecName)

/-! ## Glue monotonicity (compositional: callee mono lemmas resolved
recursively — module-scale `MonoRel` projection is not definitional
through a callee's knots, and unfolding callees was the cost center) -/

/-- An arbitrary inhabitant of `ty` (Π-types get constant functions):
statement binders the conclusion+hypotheses do not pin can take any
value. -/
partial def arbValue (ty : Expr) : TermElabM (Option Expr) := do
  let ty ← instantiateMVars ty
  if ty.isForall then
    forallTelescope ty fun bs cod => do
      match ← arbValue cod with
      | some v => pure (some (← mkLambdaFVars bs v))
      | none => pure none
  else if ty.isConstOf ``Nat then
    pure (some (mkNatLit 0))
  else if ty.isAppOf ``Nat.le then
    observing? (mkAppOptM ``Nat.le.refl
      #[some (← instantiateMVars (ty.getArg! 0))])
  else
    match ← observing? (synthInstance ty) with
    | some v => pure (some v)
    | none =>
      match ← observing?
          (mkAppOptM ``Inhabited.default #[ty, none]) with
      | some v => pure (some v)
      | none =>
        if let .const tc _ := ty.getAppFn then
          match (← getEnv).find? tc with
          | some (.inductInfo ii) =>
            match ii.ctors.head? with
            | some c0 =>
              observing? do
                -- FULLY applied (fields defaulted recursively): a
                -- partial constructor application type-checks as a
                -- function and slips past `assign`
                let mut r ← mkAppOptM c0 (ty.getAppArgs.map some)
                for _ in [0:32] do
                  let rTy ← whnfR (← inferType r)
                  unless rTy.isForall do break
                  let some v ← arbValue rTy.bindingDomain!
                    | throwError "no field default"
                  r := mkApp r v
                unless ← isDefEq (← inferType r) ty do
                  throwError "ctor default type mismatch"
                pure r
            | none => pure none
          | _ => pure none
        else pure none

/-- The mono candidate pre-filter: `true` iff unifying the lemma
conclusion against the goal provably requires delta-unfolding a
FOLDED callee body — the relation heads agree positionally, but some
argument pair has callee-headed terminal keys that disagree (the same
callee at a *different* output leg, or two different callees). A
near-miss of this shape makes `isDefEq` assign every argument mvar
and then refute `.2.1 =?= .2.2.1` by whnf'ing the whole-program knot
chain (tens of seconds per candidate, the D44 failure class arriving
through the unifier). Anything uncertain — combinator-wrapped
subjects, mvar heads, differing relation heads or arities — falls
through to `isDefEq` unchanged, so a genuine match is never lost
(under the folded-callee invariant a real match agrees on head and
path). -/
def conclKeyMismatch (callees : Array Name) (lemConcl goal : Expr) :
    Bool := Id.run do
  let (fl, fg) := (lemConcl.getAppFn, goal.getAppFn)
  let (.const rl _, .const rg _) := (fl, fg) | return false
  unless rl == rg do return false
  let (asl, asg) := (lemConcl.getAppArgs, goal.getAppArgs)
  unless asl.size == asg.size do return false
  for al in asl, ag in asg do
    if let (some (hl, pl), some (hg, pg)) :=
        (subjKeyOf al, subjKeyOf ag) then
      if callees.contains hl && callees.contains hg
          && (hl != hg || pl != pg) then
        return true
      -- a callee-leg lemma against an OPERATOR-headed subject (a derived
      -- wire `H.mapTick …`/`H.zipTick …` of the normalized goal): a match
      -- would need the callee unfolded through its knots — D73 measured
      -- one such near-miss at 403M heartbeats (`leader_election_mono₂`
      -- against `paxos_core.body`'s leg 7, `mapTick (zipTick (le.1) …)`)
      -- once member reads became `MemberMap.get` applications
      if (callees.contains hl && (`Hydro.HydroSem).isPrefixOf hg)
          || (callees.contains hg && (`Hydro.HydroSem).isPrefixOf hl) then
        return true
  return false

/-- The signature operator heading a relation subject (through the
member read `MemberMap.get m i`): the `HydroSem` field, whether spelled
as a projection function application or a native `.proj` node. `none`
for a callee-headed, projected, or uncertain subject. -/
def opHeadOf (env : Environment) (e : Expr) : Option Name := Id.run do
  -- through the member read and a monotone cell's `.val` application
  -- (`↑(get (latest_monotone w) i) d`)
  let mut e := e
  for _ in [0:8] do
    match e.getAppFn with
    | .const n _ =>
      if (n == ``MemberMap.get || n == ``MemberMap.cells || n == ``Subtype.val)
          && e.getAppNumArgs ≥ 3 then
        e := e.getAppArgs[2]!
      else break
    | .proj S 0 st =>
      if S == ``Subtype || S == ``MemberMap then e := st else break
    | _ => break
  match e.getAppFn with
  | .const n _ => if (`Hydro.HydroSem).isPrefixOf n then some n else none
  | .proj S i _ =>
    if S == ``Hydro.HydroSem then (getStructureFields env S)[i]?.map (S ++ ·)
    else none
  | _ => none

/-- Resolve a graded-relation goal `T` from the statement hypotheses
or by instantiating a callee's mono lemma (conclusion unified with
`T` at default transparency — the module delta this crosses is
zeta/beta/proj only, every callee stays FOLDED — hypothesis
metavariables resolved recursively; candidates whose conclusion
*cannot* match without unfolding a folded callee are skipped by
`conclKeyMismatch` before any unification). -/
partial def resolveRel (hyps : Array Expr)
    (monoOf : Name → Array Name) (calleeNames : Array Name)
    (T : Expr) (depth : Nat) : TermElabM (Option Expr) := do
  for h in hyps do
    if ← withReducible <| isDefEq (← inferType h) T then
      return some h
  if depth == 0 then return none
  -- callee mono lemmas whose module occurs in T (or in what T deltas
  -- to — the folded M-app conclusion mentions only M, so fall back to
  -- trying every callee)
  let mentioned := calleeNames.filter fun c =>
    (T.find? (·.isConstOf c)).isSome
  let order := if mentioned.isEmpty then calleeNames else mentioned
  -- unify under T's binder telescope: the lemma's own trailing
  -- binders (`∀ i`) are part of its meta-telescope and get assigned
  -- to the locals during unification
  forallTelescope T fun is T' => do
  -- an OPERATOR-headed subject (a derived wire `H.allTicks (H.mapTick
  -- …)` of the normalized leg — D81: `paxos_core`'s new-leader output
  -- `p_ballot.filter_if(just_became_leader).all_ticks()`, consumed by
  -- `with_client`'s knot): the operator's own `Values` monotonicity law
  -- (`vmono_<op>`, `ValuesMono.lean`) is the candidate, its wire hypotheses
  -- resolved recursively down to the callee legs; a callee lemma is
  -- never a match here (`conclKeyMismatch`'s operator rule)
  let env ← getEnv
  let mut opLems : Array Name := #[]
  for a in T'.getAppArgs do
    if let some op := opHeadOf env a then
      let lem := `Hydro ++ Name.mkSimple ("vmono_" ++ op.getString!)
      if env.contains lem && !opLems.contains lem then
        opLems := opLems.push lem
  let candidates : Array (Name × Array Name) :=
    (if opLems.isEmpty then #[] else #[(`op, opLems)])
      ++ order.map fun K => (K, monoOf K)
  if (← IO.getEnv "HYDROGEN_MONO_DIAG").isSome then
    IO.eprintln s!"[mono-diag d{depth}] goal {← ppExpr T'}\n  op lemmas {opLems}"
  for (_K, lems) in candidates do
    for lem in lems do
      let diag := (← IO.getEnv "HYDROGEN_MONO_DIAG").isSome
      let res ← observing? do
        let lemC ← mkConstWithFreshMVarLevels lem
        let (ms, _, ty) ← forallMetaTelescope (← inferType lemC)
        if conclKeyMismatch calleeNames (← instantiateMVars ty) T' then
          if diag then
            IO.eprintln s!"[mono-diag d{depth}] {lem} key-skipped"
          throwError "no match"
        let hb0 ← IO.getNumHeartbeats
        let ok ← isDefEq ty T'
        if diag then
          IO.eprintln s!"[mono-diag d{depth}] {lem} isDefEq {ok} {((← IO.getNumHeartbeats) - hb0) / 1000}k"
        unless ok do
          if diag then
            let (tyS, tS) ← withOptions
                (fun o => o.setBool `pp.explicit true) do
              pure (← ppExpr (← instantiateMVars ty), ← ppExpr T')
            IO.eprintln s!"[mono-diag d{depth}] {lem} concl:\n\
              {tyS}\n≠\n{tS}"
          throwError "no match"
        if diag then
          IO.eprintln s!"[mono-diag d{depth}] {lem} concl matched"
        -- pass 1: Prop (hypothesis) mvars — resolving them against
        -- the available hypotheses also PINS wire mvars the
        -- conclusion left loose
        for m in ms do
          unless ← m.mvarId!.isAssigned do
            let mty ← instantiateMVars (← m.mvarId!.getType)
            if (← inferType mty).isProp then
              let some prf ← resolveRel hyps monoOf calleeNames mty
                  (depth - 1)
                | do
                  if diag then
                    IO.eprintln s!"[mono-diag d{depth}] {lem} hyp \
                      unresolved:\n{← ppExpr mty}"
                  throwError "unresolved hypothesis"
              m.mvarId!.assign prf
        -- pass 2: leftovers the statement does not pin (fuel
        -- horizons, enum parameters the leg's value ignores,
        -- instances): any value proves the instantiation
        for m in ms do
          unless ← m.mvarId!.isAssigned do
            let mty ← instantiateMVars (← m.mvarId!.getType)
            match ← arbValue mty with
            | some v => m.mvarId!.assign v
            | none =>
              if diag then
                IO.eprintln s!"[mono-diag d{depth}] {lem} \
                  unpinned mvar: {← ppExpr mty}"
              throwError "unpinned metavariable"
        -- strays: unification can mint mvars outside `ms` (instances,
        -- delayed-abstracted enum parameters)
        let ans ← instantiateMVars (mkAppN lemC ms)
        for m in (← getMVars ans) do
          let mty ← instantiateMVars (← m.getType)
          match ← arbValue mty with
          | some v => m.assign v
          | none =>
            if diag then
              IO.eprintln s!"[mono-diag d{depth}] {lem} stray \
                mvar: {← ppExpr mty}"
            throwError "stray metavariable"
        mkLambdaFVars is (← instantiateMVars ans)
      if let some prf := res then return some prf
  return none

/-- Per-leg `Values` monotonicity for a glue module, by composition of
the callees' mono lemmas (statement scaffolding as in `genMono`).
Legs that are not resolvable compositions (combinator-wrapped
outputs no consumer needs) are skipped: the registered array stays
leg-ALIGNED with `Name.anonymous` placeholders. -/
def genGlueMono (mc : ModCtx) : TermElabM (Array Name) := do
  let env ← getEnv
  let callees ← calleeInfos mc.mName
  let calleeNames := callees.map (·.1)
  let monoOf : Name → Array Name := fun n =>
    match getGenInfo env n with
    | some gi => gi.monoLemmas.filter (· != Name.anonymous)
    | none => #[]
  -- ==== binder scaffolding (mirrors genMono) ====
  let mut decls : Array (Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
    let nm ← mc.args[i]!.fvarId!.getUserName
    match mc.kinds[i]! with
    | .wire _ =>
      decls := decls.push (nm, .implicit, ty)
      decls := decls.push (nm.appendAfter "'", .implicit, ty)
    | .plain => pure ()
    | _ => decls := decls.push (nm, .default, ty)
  withLocalDecls (decls.map fun (n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun xs => do
  let mut fstOf : Std.HashMap Nat Expr := {}
  let mut sndOf : Std.HashMap Nat Expr := {}
  let mut j := 0
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j+1]!
      j := j + 2
    | .plain =>
      fstOf := fstOf.insert i mc.args[i]!
      sndOf := sndOf.insert i mc.args[i]!
    | _ =>
      fstOf := fstOf.insert i xs[j]!
      sndOf := sndOf.insert i xs[j]!
      j := j + 1
  let mut argBinders : Array Expr := #[]
  for i in [0:mc.args.size] do
    match mc.kinds[i]! with
    | .wire _ =>
      argBinders := argBinders.push (fstOf.get? i).get!
      argBinders := argBinders.push (sndOf.get? i).get!
    | .plain => argBinders := argBinders.push mc.args[i]!
    | _ => argBinders := argBinders.push (fstOf.get? i).get!
  let mut hypDecls : Array (Name × BinderInfo × Expr) := #[]
  for i in [0:mc.args.size] do
    if let .wire cf := mc.kinds[i]! then
      let ty := reinterp mc.corner mc.values (← inferType mc.args[i]!)
      let rel ← valuesRelOf cf ty (fstOf.get? i).get! (sndOf.get? i).get!
      hypDecls := hypDecls.push
        (Name.mkSimple s!"hm{i}", .default, rel)
  withLocalDecls (hypDecls.map fun (n, bi, ty) =>
      (n, bi, fun _ => pure ty)) fun hyps => do
  let fstAll := (Array.range mc.args.size).map fun i => (fstOf.get? i).get!
  let sndAll := (Array.range mc.args.size).map fun i => (sndOf.get? i).get!
  -- ==== per-leg lemmas ====
  let mut names := #[]
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let legHead := mc.legTys[i]!.getAppFn
    let cf ← match legHead with
      | .const n _ =>
        match carrierFamOfHead n with
        | some cf => pure cf
        | none => throwError "HydroGen: {mc.mName}: mono leg {i}"
      | _ => throwError "HydroGen: {mc.mName}: mono leg {i} head"
    let legTyV := reinterp mc.corner mc.values mc.legTys[i]!
    let name := mc.mName.appendAfter s!"_mono{subscript (i + 1)}"
    let res? ← withDeclDiag (toString name ++ " (glue)") do
      let concl ← valuesRelOf cf legTyV
        (← mc.legAppAt mc.values fstAll leg)
        (← mc.legAppAt mc.values sndAll leg)
      -- resolve against NORMALIZED subjects (module delta + zeta +
      -- tuple projections): the callee applications appear with
      -- concrete arguments, so conclusion unification pins every
      -- lemma binder structurally (a folded subject lets the unifier
      -- match through reduction while leaving binders loose). The
      -- folded statement is recovered by a fix-free defeq hint.
      let normLeg := fun (args : Array Expr) => do
        let b ← zetaAll (← glueBodyAt mc mc.values args leg)
        pure (← simpTerm b (mc.extras ++
          (← calleeInfos mc.mName).foldl (init := #[])
            fun acc (c, gi) => acc ++ gi.inlines)).1
      let conclN ← withDeclDiag (toString name ++ " (glue: normalize)") do
        valuesRelOf cf legTyV (← normLeg fstAll) (← normLeg sndAll)
      let r? ← withDeclDiag (toString name ++ " (glue: resolve)") do
        resolveRel hyps monoOf calleeNames conclN 16
      match r? with
      | some prfN =>
        let prf ← mkExpectedTypeHint prfN concl
        let stmt ← mkForallFVars
          (mc.ctxArgs ++ argBinders ++ hyps) concl
        let val ← instantiateMVars
          (← mkLambdaFVars (mc.ctxArgs ++ argBinders ++ hyps) prf)
        if val.hasExprMVar || val.hasLevelMVar then
          let mvars ← getMVars val
          let tys ← mvars.mapM fun m => do
            pure (toString (← ppExpr (← instantiateMVars (← m.getType))))
          IO.eprintln s!"[mono-diag] {name} residual mvars: \
            {tys} (lvl: {val.hasLevelMVar})"
          pure none
        else
          withDeclDiag (toString name ++ " (glue: addThm)") do
            addThm name stmt val
          pure (some name)
      | none => pure none
    match res? with
    | some n => names := names.push n
    | none =>
      -- placeholder keeps the array leg-aligned
      names := names.push Name.anonymous
  pure names

/-! ## Plain-module namings through the glue engine -/

/-- `M_co_srᵢ` (`rr := false`) / `M_co_rrᵢ` (`rr := true`, no content
decisions) for an ordinary module: both sides run the glue chain —
one module delta, simp with the projection set + callee namings, then
the keyed residual pass for the redexes simp's congruence cannot reach
(a callee naming's left side sits in the *argument* of the enclosing
callee application, whose `{out // … args …}` result type makes that
position fixed: only `rfl`-lemmas apply there, never the propositional
callee rules) — and must meet syntactically (or by reducible defeq).
A residual mismatch falls through to a default-transparency `rfl` on
the two normal forms (the pre-engine closer; `HYDROGEN_SR_DIAG` makes
it a loud error with the first divergent node instead). Before the
engine, the stuck callee legs ALL went to that closer, i.e. a
whole-program whnf at both interpretations per leg (FINDINGS 0c-iii). -/
def genNaming (mc : ModCtx) (rr : Bool) : TermElabM (Array Name) := do
  let rules ← calleeNamingRules mc.mName
  let simpSet := coSimpBase ++ rules ++ mc.extras
  -- the residual pass carries the callee namings only: the projection
  -- set is in simp (it reaches fixed positions too — its rules are
  -- `rfl`), and every candidate under a lemma's key is one unification
  -- attempt, so the pass must not re-try the whole op set
  let resLems ← rules.mapM fun l => do pure (l, ← lemKeyOf l)
  let cache : MatchCache ← IO.mkRef {}
  let diag := (← IO.getEnv "HYDROGEN_SR_DIAG").isSome
  let proj := if rr then `rr else `sr
  let otherI := if rr then mc.values else mc.sched
  let otherArgs ← if rr then mc.rrArgsDirect else mc.srArgs
  let suffix := if rr then "_co_rr" else "_co_sr"
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let name := mc.mName.appendAfter s!"{suffix}{subscript (i + 1)}"
    -- one naming theorem per leg (cost diagnostics, D72)
    withDeclDiag (toString name) do
    let lhs ← mkProjection (← mc.legAppAt mc.corner mc.args leg) proj
    let bodyC ← mkProjection (← glueBodyAt mc mc.corner mc.args leg) proj
    let rhs ← mc.legAppAt otherI otherArgs leg
    let bodyR ← glueBodyAt mc otherI otherArgs leg
    let (stepC, tC) ← glueCornerChain lhs bodyC simpSet resLems cache
    let (stepR, tR) ← glueCornerChain rhs bodyR simpSet resLems cache
    let prf ←
      if tC == tR then mkEqTrans stepC (← mkEqSymm stepR)
      else if diag then
        -- diagnostic mode: no defeq exploration of a mismatched pair
        -- (that exploration is itself the heartbeat sink) — the first
        -- divergent node, verbatim
        meetError mc.mName s!"{suffix} leg {i}" tC tR
      else if ← withReducible <| isDefEq tC tR then
        mkEqTrans stepC (← mkEqSymm stepR)
      else do
        let mid ← mkExpectedTypeHint (← mkEqRefl tC) (← mkEq tC tR)
        mkEqTrans stepC (← mkEqTrans mid (← mkEqSymm stepR))
    let prf ← mkExpectedTypeHint prf (← mkEq lhs rhs)
    let stmt ← mkForallFVars mc.allBinders (← mkEq lhs rhs)
    addThm name stmt (← mkLambdaFVars mc.allBinders prf)
  pure ((Array.range mc.legs.size).map fun i =>
    mc.mName.appendAfter s!"{suffix}{subscript (i + 1)}")

/-- `M_co_srcᵢ` for every singleton-output leg: the corner value's `src` in the
glue chain's simp-normal form — the machine source expression over the module's
corner arguments (through the callee `src` namings and the op `co_*_src`
projections). A consumer's `snapshot` of the callee's singleton rewrites
`(M corner …).src` with it, so its derived denotational cut is spelled over
the consumer's own outer machine data (D89). -/
def genSrcNamingImpl (mc : ModCtx) : TermElabM (Array Name) := do
  let rules ← calleeNamingRules mc.mName
  let simpSet := coSimpBase ++ rules ++ mc.extras
  let resLems ← rules.mapM fun l => do pure (l, ← lemKeyOf l)
  let cache : MatchCache ← IO.mkRef {}
  let mut out : Array Name := #[]
  for i in [0:mc.legs.size] do
    unless mc.legTys[i]!.getAppFn.isConstOf ``HydroSem.Singleton do continue
    let leg := mc.legs[i]!
    let name := mc.mName.appendAfter s!"_co_src{subscript (i + 1)}"
    withDeclDiag (toString name) do
      let lhs ← mkProjection (← mc.legAppAt mc.corner mc.args leg) `src
      let bodyC ← mkProjection (← glueBodyAt mc mc.corner mc.args leg) `src
      let (stepC, tC) ← glueCornerChain lhs bodyC simpSet resLems cache
      let prf ← mkExpectedTypeHint stepC (← mkEq lhs tC)
      let stmt ← mkForallFVars mc.allBinders (← mkEq lhs tC)
      addThm name stmt (← mkLambdaFVars mc.allBinders prf)
    out := out.push name
  pure out

/-- `M_co_lagᵢ` for every leg (D95): the corner output's `lag` in the lag
chain's simp-normal form — a `Nat` expression over the module's corner
arguments' lags (through the callee lag namings, the op `co_*_lag`
projections and `co_hfix_*_lag`, which opens a knot's lag to its body's
at the lag probe). A knot's graded coupling consumes its body's. -/
def genLagNamingImpl (mc : ModCtx) : TermElabM (Array Name) := do
  let rules ← calleeLagRules mc.mName
  let simpSet := coLagBase ++ rules ++ mc.extras
  let resLems ← rules.mapM fun l => do pure (l, ← lemKeyOf l)
  let cache : MatchCache ← IO.mkRef {}
  let mut out : Array Name := #[]
  for i in [0:mc.legs.size] do
    let leg := mc.legs[i]!
    let name := mc.mName.appendAfter s!"_co_lag{subscript (i + 1)}"
    withDeclDiag (toString name) do
      let lhs ← mkProjection (← mc.legAppAt mc.corner mc.args leg) `lag
      let bodyC ← mkProjection (← glueBodyAt mc mc.corner mc.args leg) `lag
      let (stepC, tC) ← glueCornerChain lhs bodyC simpSet resLems cache
      let prf ← mkExpectedTypeHint stepC (← mkEq lhs tC)
      -- the normal form (the chain's simp pushes subtractions to the leaves)
      let (tC, prf) ← do
        let (c, h?) ← lagCanon tC
        match h? with
        | some h => pure (c, ← mkEqTrans prf h)
        | none => pure (tC, prf)
      let stmt ← mkForallFVars mc.allBinders (← mkEq lhs tC)
      addThm name stmt (← mkLambdaFVars mc.allBinders prf)
    out := out.push name
  pure out

initialize
  glueMonoHook.set (some genGlueMono)
  namingEngineHook.set (some genNaming)
  srcNamingEngineHook.set (some genSrcNamingImpl)
  lagNamingEngineHook.set (some genLagNamingImpl)

/-- The glue phase, term-elaboration side, **idempotent** (the
eager knot-stack drain inside `fix` elaboration runs it for chain
bodies before their knots' stacks). -/
def runGlueT (mName : Name) (extras : Array Name) :
    TermElabM Unit := do
  if let some gi := getGenInfo (← getEnv) mName then
    unless gi.srLemmas.isEmpty do
      return
  let extras := extrasWithSpec (← getEnv) mName extras
  let (srs, rrs, vdec, lags) ←
    withModCtx mName (extras := extras) fun mc => do
      let (srs, rrs, vdec) ← genGlue mc
      let lags ← genLagNamingImpl mc
      pure (srs, rrs, vdec, lags)
  registerInfoT mName fun gi =>
    { gi with srLemmas := srs, rrLemmas := rrs, vdec? := some vdec,
              lagLemmas := lags, pinLemmas := #[] }
  logInfo m!"hydro_glue {mName}: {srs.size} sr, {rrs.size} rr, {lags.size} lag (+vdec)"

end HydroGen

end Hydro

