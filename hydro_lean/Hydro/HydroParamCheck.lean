import Hydro.HydroParam
import Hydro.MonoHRel
import Hydro.CausalHRel
import Hydro.Paxos.PaxosCore

/-!
# Hydro · free-theorem consumption checks

The `_param` theorems are generated by each module's `hydro def`
(the param phase); this file
checks consumption: instantiating them at the monotonicity and
causality instances gives program-scale guarantees as corollaries
(the eager-agreement instance they also served retired in D73 — the
`Values` run is the executable).
-/

namespace Hydro


#check @p_ballot_calc_param₁


/-! ## Program-scale guarantees for free: one `_param` theorem, many
instances -/

section ProgramScale

variable {L : Type} {mem : L → Nat} {P : Type} [DecidableEq P]
  (variant : PaxosVariant) (prop acc : L) (f : Nat)

/-- **Whole-program Flo monotonicity for free**: both output legs of
`paxos_core` are ⊑-monotone in the client inputs — `paxos_core_param`
at the mono instance. No walker, no per-module generation. -/
example {ckα : Type} [DecidableEq ckα] {ckord : StrOrd}
    {ckret : Retries}
    (cp cp' : (Values L mem).Stream prop P .totalOrder .exactlyOnce)
    (ck ck' : (Values L mem).Singleton acc ckα (Option Nat) ckord
      ckret (.monotonic ValueOrder.optNat))
    (d : PaxosCoreDec (Values L mem) (mem prop) (mem acc) P ckα ckord)
    (hc : ∀ i, PoolLe _ _ (cp i) (cp' i))
    (hk : ∀ (i : Fin (mem acc)) (dd : CutDec ckα ckord),
      (ck i).val dd <+: (ck' i).val dd) :
    ∀ i, PoolLe _ _
      ((paxos_core (Values L mem) variant prop acc f cp ck d
        .triv).2 i)
      ((paxos_core (Values L mem) variant prop acc f cp' ck' d
        .triv).2 i) :=
  paxos_core_param₂ (monoC L mem) monoLaws () variant prop acc f
    cp cp' (fun _ _ => hc) ck ck' (fun _ _ => hk) d d
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    .triv .triv
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl)
    () le_rfl

variable {pacing : Pacing L mem}

/-- **Whole-program step causality for free**: `paxos_core`'s machine
run below any horizon depends only on the inputs below it —
`paxos_core_param` at the causal instance. -/
example (h : Nat)
    (cp cp' : (SchedSem L mem pacing).Stream prop P .totalOrder
      .exactlyOnce)
    {ckα : Type} [DecidableEq ckα] {ckord : StrOrd} {ckret : Retries}
    (ck ck' : (SchedSem L mem pacing).Singleton acc ckα (Option Nat)
      ckord ckret (.monotonic ValueOrder.optNat))
    (d : PaxosCoreDec (SchedSem L mem pacing) (mem prop) (mem acc) P
      ckα ckord)
    (sd : PaxosCoreSched (SchedSem L mem pacing) (mem prop)
      (mem acc) P)
    (hc : SAgree h cp cp') (hk : FAgree h ck ck') :
    SAgree h
      ((paxos_core (SchedSem L mem pacing) variant prop acc f cp ck
        d sd).2)
      ((paxos_core (SchedSem L mem pacing) variant prop acc f cp' ck'
        d sd).2) :=
  paxos_core_param₂ (causalC L mem pacing) causalLaws h
    variant prop acc f
    cp cp' (fun _ hj => SAgree.mono hj hc)
    ck ck' (fun _ hj => FAgree.mono hj hk) d d
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    sd sd
    (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl) (fun _ _ => rfl)
    (fun _ _ => rfl)
    h le_rfl

end ProgramScale

end Hydro
