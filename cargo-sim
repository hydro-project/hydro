#!/usr/bin/env bash
set -e

# Build for the host as an explicit compilation target, so that cargo applies the rustflags below
# to target artifacts only. Build scripts and proc-macros link no sanitizer-coverage runtime, so
# instrumenting them fails at link time.
export CARGO_BUILD_TARGET=$(rustc -vV | grep 'host:' | awk '{print $2}')

# The test binary hosts the libfuzzer runtime (linked in via bolero). The simulator dlopens
# sancov-instrumented shared objects (the generated program and the prebuilt trybuild dylib it
# links against), whose coverage hooks (e.g. `__sanitizer_cov_pcs_init`) resolve against that
# runtime at load time, so the binary must export its symbols dynamically.
if [[ "$(uname)" == "Darwin" ]]; then
  # macOS rejects undefined symbols when linking shared objects (Linux allows them), so the hooks
  # must be declared as resolved at load time.
  LINK_FLAGS=(-Clink-arg=-export_dynamic -Clink-arg=-undefined -Clink-arg=dynamic_lookup)
else
  LINK_FLAGS=(-Clink-arg=-Wl,-export-dynamic)
fi

# Rustflags are passed as cargo config, not `RUSTFLAGS`, so they reach the generated programs the
# same way `--config`-driven test runs do: via `hydro_lang`'s `forward_rustflags`.
# `target.<triple>.rustflags` is the highest-precedence config key.
FLAGS=($RUSTFLAGS -C prefer-dynamic -Copt-level=3 -Ccodegen-units=1 -Cpasses=sancov-module -Cllvm-args=-sanitizer-coverage-inline-8bit-counters -Cllvm-args=-sanitizer-coverage-level=4 -Cllvm-args=-sanitizer-coverage-pc-table -Cllvm-args=-sanitizer-coverage-trace-compares "${LINK_FLAGS[@]}")
unset RUSTFLAGS CARGO_ENCODED_RUSTFLAGS
RUSTFLAGS_CONFIG="target.$CARGO_BUILD_TARGET.rustflags=[$(printf '"%s",' "${FLAGS[@]}")]"

export BOLERO_FUZZER="libfuzzer"

cargo test --config "$RUSTFLAGS_CONFIG" --lib "${@:2}" --nocapture --test-threads=1
